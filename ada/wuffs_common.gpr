abstract project Wuffs_Common is
   type Profile_Type is ("checked", "release");
   Profile : Profile_Type := external ("WUFFS_PROFILE", "checked");

   --  Stack frames above this many bytes, and all GNAT warnings, are build
   --  errors. See docs/DESIGN.md, "Stack and heap".
   Stack_Limit := "8192";

   Common := ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatyyM100", "-gnatec=" & Wuffs_Common'Project_Dir & "gnat.adc",
              "-fstack-usage", "-Wstack-usage=" & Stack_Limit, "-Werror=stack-usage=" & Stack_Limit, "-g");
   Switches := ();
   case Profile is
      when "checked" => Switches := Common & ("-O2", "-gnata", "-gnato", "-gnatVa", "-fstack-check");
      when "release" => Switches := Common & ("-O2", "-gnatp");
   end case;

   --  The YCbCr conversion (wuffs-base-pixel_swizzler_ycck.adb) alone is
   --  compiled at -O3: GCC then vectorises its row loops (with SSE2, the
   --  x86-64 baseline), which makes JPEG decoding about 15% faster.  -O3
   --  everywhere gains nothing else and costs 13% in code size.
   YCCK_Switches := Switches & ("-O3");

   --  GNATprove switches shared by every proved project.  Prover effort is
   --  bounded by steps, not wall-clock time, so a proof passes or fails the
   --  same way on a loaded or slow machine (docs/DESIGN.md).  The largest
   --  step count any check has needed is about 41000.
   Proof_Switches := ("--level=2", "--timeout=0", "--steps=100000", "--mode=all",
                      "--checks-as-errors=on", "-j0");
end Wuffs_Common;
