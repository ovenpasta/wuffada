--  Test drivers for the SPARK base library (ada/tests_base).
--  Owner: base-library work.
--
--    alr exec -- gprbuild -P wuffs_base_tests.gpr [-XWUFFS_PROFILE=release]
--    bin/base_tests        (exit status 0 only if every check passed)
with "wuffs_common.gpr";
project Wuffs_Base_Tests is
   for Source_Dirs use ("src/root", "src/base", "tests_base");
   for Object_Dir use "obj/base_tests/" & Wuffs_Common.Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("base_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use Wuffs_Common.Switches;
   end Compiler;
end Wuffs_Base_Tests;
