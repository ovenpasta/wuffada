--  The calls of the wrappers of Wuffs.Runtime.X86.SSE42 and AVX2 that
--  test_x86 makes, on byte arrays (the body, x86_test_cases.adb, is
--  generated by oracle/gen.py).  The body is compiled with the AVX2 options
--  (see ada/wuffs_gen.gpr): it is the only test unit that may hold
--  instructions beyond the x86-64 baseline.

with Ada.Unchecked_Conversion;
with Interfaces;
with Wuffs.Runtime.X86;
with X86_Methods;

package X86_Test_Cases is

   use Interfaces;
   use Wuffs.Runtime.X86;
   use X86_Methods;
   use type Wuffs.Index;

   --  A vector's bytes, lane 0 first.  A 128-bit vector is the first 16;
   --  a result that is a 128-bit vector or a number has zeroes after it.
   type Bytes32 is array (0 .. 31) of Unsigned_8;
   type Bytes16 is array (0 .. 15) of Unsigned_8;
   pragma Universal_Aliasing (Bytes32);
   pragma Universal_Aliasing (Bytes16);

   --  The buffers of the loads and the store, as in oracle/x86_oracle.c.
   --  Input N loads from (or stores to) offset W (N) or H (N).
   Byte_Buf  : Wuffs.Bytes (0 .. 159) with Alignment => 64;
   U16_Buf   : Wuffs.U16_Array (0 .. 95) with Alignment => 64;
   Store_Buf : Wuffs.Bytes (0 .. 159) with Alignment => 64;
   function W (N : Natural) return Wuffs.Index is (Wuffs.Index (N mod 64));
   function H (N : Natural) return Wuffs.Index is (Wuffs.Index (N mod 32));

   --  The method M, with the immediate argument Imm (one of Imms (M)), for
   --  input N: A is the receiver, B and C the other operands (the make_*
   --  methods take their scalar arguments from A's lanes), the loads read
   --  Byte_Buf or U16_Buf and the store writes Store_Buf (and returns
   --  zeroes).
   function Apply (M : Method; Imm : Integer; N : Natural; A, B, C : Bytes32) return Bytes32;

   function U8_Lane (X : Bytes32; I : Natural) return Unsigned_8 is (X (I));
   function U16_Lane (X : Bytes32; I : Natural) return Unsigned_16
   is (Unsigned_16 (X (2 * I)) or Shift_Left (Unsigned_16 (X (2 * I + 1)), 8));
   function U32_Lane (X : Bytes32; I : Natural) return Unsigned_32
   is (Unsigned_32 (U16_Lane (X, 2 * I)) or Shift_Left (Unsigned_32 (U16_Lane (X, 2 * I + 1)), 16));
   function U64_Lane (X : Bytes32; I : Natural) return Unsigned_64
   is (Unsigned_64 (U32_Lane (X, 2 * I)) or Shift_Left (Unsigned_64 (U32_Lane (X, 2 * I + 1)), 32));

private

   function B16_To_M128I is new Ada.Unchecked_Conversion (Bytes16, M128I);
   function M128I_To_B16 is new Ada.Unchecked_Conversion (M128I, Bytes16);
   function To_M256I is new Ada.Unchecked_Conversion (Bytes32, M256I);
   function From_M256I is new Ada.Unchecked_Conversion (M256I, Bytes32);

   function To_M128I (X : Bytes32) return M128I;
   function From_M128I (X : M128I) return Bytes32;
   function From_U32 (X : Unsigned_32) return Bytes32;
   function From_U64 (X : Unsigned_64) return Bytes32;

end X86_Test_Cases;
