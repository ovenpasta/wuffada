      V_R :=
        (Base => Self.F_Buf'Unrestricted_Access,
         First => Self.F_Buf'First,
         Length => Self.F_Buf'Length);
      V_S :=
        Wuffs.Runtime.Subslice_I ((Base => Self.F_Buf'Unrestricted_Access,
                                   First => Self.F_Buf'First,
                                   Length => Self.F_Buf'Length),
                                  20);
      Wuffs.Runtime.Copy_From_Slice (Dst => V_S.Base (V_S.First .. Wuffs.Runtime.Last (V_S)),
                                     Src => V_R.Base (V_R.First .. Wuffs.Runtime.Last (V_R)),
                                     N => G_T4);
      V_N := G_T4;
      V_T := V_T * 3 + V_N;
      V_S :=
        Wuffs.Runtime.Subslice_J ((Base => Self.F_Buf'Unrestricted_Access,
                                   First => Self.F_Buf'First,
                                   Length => Self.F_Buf'Length),
                                  12);
      Wuffs.Runtime.Copy_From_Slice (Dst => V_S.Base (V_S.First .. Wuffs.Runtime.Last (V_S)),
                                     Src => Self.F_Aux,
                                     N => G_T5);
      V_N := G_T5;
      V_T := V_T * 3 + V_N;
      V_S :=
        (Base => Self.F_Aux'Unrestricted_Access,
         First => Self.F_Aux'First,
         Length => Self.F_Aux'Length);
      V_S := Wuffs.Runtime.Suffix (S => V_S, Up_To => 6);
      if Wuffs.U64 (V_S.Length) > 1 then
         Wuffs.Runtime.Set (S => V_S, I => 0, V => 16#AB#);
         Wuffs.Runtime.Set (S => V_S, I => 1, V => Wuffs.Runtime.Get (V_S, 1) + 3);
      end if;
      V_R :=
        Wuffs.Runtime.To_RO (Wuffs.Runtime.Suffix
                               (S => (Base => Self.F_Aux'Unrestricted_Access,
                                      First => Self.F_Aux'First,
                                      Length => Self.F_Aux'Length),
                                Up_To => Wuffs.U64 (A_K and 3)));
      V_T := V_T * 3 + Wuffs.U64 (V_R.Length);
      V_S := (Base => A_X'Unrestricted_Access, First => A_X'First, Length => A_X'Length);
      if Wuffs.U64 (V_S.Length) >= 4 then
         Wuffs.Base.Endian.Poke_U32LE (Data => V_S.Base (V_S.First .. Wuffs.Runtime.Last (V_S)),
                                       Pos => V_S.Base
                                                (V_S.First
                                                 .. Wuffs.Runtime.Last (V_S))'First,
                                       V => 16#1234_5678#);
      end if;
      if Wuffs.U64 (V_S.Length) >= 4 then
         V_T :=
           V_T * 3
             + Wuffs.U64 (Wuffs.Base.Endian.Peek_U32BE
                            (Data => V_S.Base (V_S.First .. Wuffs.Runtime.Last (V_S)),
                             Pos => V_S.Base (V_S.First .. Wuffs.Runtime.Last (V_S))'First));
      end if;
      if Wuffs.U64 (A_X'Length) >= 2 then
         V_T := V_T * 3 + Wuffs.U64 (Wuffs.Base.Endian.Peek_U16LE (Data => A_X, Pos => A_X'First));
      end if;
      Wuffs.Runtime.Copy_From_Slice (Dst => A_X, Src => Self.F_Buf (0 .. 2), N => G_T6);
      V_N := G_T6;
      V_T := V_T * 3 + V_N;
      Wuffs.Runtime.Copy_From_Slice (Dst => Self.F_Buf (28 .. Self.F_Buf'Last),
                                     Src => A_X,
                                     N => G_T7);
      V_N := G_T7;
      V_T := V_T * 3 + V_N;
      V_Loc (Wuffs.Index (A_K and 7)) := 513;
      V_Loc (Wuffs.Index (Interfaces.Shift_Right (A_K, 3) and 7)) :=
        V_Loc (Wuffs.Index (Interfaces.Shift_Right (A_K, 3) and 7)) + 7;
      V_I := 0;
      while V_I < 8 loop
         V_T := V_T * 3 + Wuffs.U64 (V_Loc (Wuffs.Index (V_I)));
         V_I := V_I + 1;
      end loop;
      Self.F_Marks (Wuffs.Index (A_K and 3)) := True;
      if Self.F_Marks (1) or else Self.F_Marks (2) then
         V_T := V_T + 1000;
      end if;
      Self.F_Grid (0) := Self.F_Grid (1);
      V_T := V_T + Wuffs.U64 (Self.F_Grid (0) (2));
      V_C :=
        Wuffs.Base.Ints.Min_U32 (X => A_K, Y => 9) + Wuffs.Base.Ints.Max_U32 (X => A_K, Y => 1000);
      V_C :=
        V_C
          + Wuffs.Base.Ints.Low_Bits_U32 (X => A_K, N => A_K and 15)
          + Wuffs.Base.Ints.High_Bits_U32 (X => A_K, N => (A_K and 7) or 1);
      V_T := V_T * 3 + Wuffs.U64 (V_C);
      if Wuffs.Runtime.Target.CPU_Arch_Is_32_Bit then
         V_T := V_T + 1;
      end if;
      return V_T * 31 + Sum_Buf (Self);
   end Slices;

   function G_Choosy_Default_Mix (Self : in out Widget; A_V : Wuffs.U32) return Wuffs.U32 is
   begin
      Self.F_Total := Self.F_Total + 1;
      return A_V + 1;
   end G_Choosy_Default_Mix;

   function Mix (Self : in out Widget; A_V : Wuffs.U32) return Wuffs.U32 is
   begin
      if Self.G_Choosy_Mix = 1 then
         return Mix_Square (Self => Self, A_V => A_V);
      elsif Self.G_Choosy_Mix = 2 then
         return Mix_Double (Self => Self, A_V => A_V);
      else
         return G_Choosy_Default_Mix (Self => Self, A_V => A_V);
      end if;
   end Mix;

   function Mix_Double (Self : in out Widget; A_V : Wuffs.U32) return Wuffs.U32 is
   begin
      Self.F_Total := Self.F_Total + 2;
      return A_V * 2;
   end Mix_Double;

   function Mix_Square (Self : in out Widget; A_V : Wuffs.U32) return Wuffs.U32 is
   begin
      Self.F_Total := Self.F_Total + 3;
      return A_V * A_V;
   end Mix_Square;

   procedure Choose_Mix (Self : in out Widget; A_Which : Wuffs.U32) is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return;
      end if;
      if A_Which = 1 then
         Self.G_Choosy_Mix := 2;
      elsif A_Which = 2 then
         Self.G_Choosy_Mix := 1;
      elsif A_Which = 3 then
         Self.G_Choosy_Mix := 0;
      end if;
   end Choose_Mix;

   function Call_Mix (Self : in out Widget; A_V : Wuffs.U32) return Wuffs.U32 is
      V_R : Wuffs.U32 := 0;
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return 0;
      end if;
      V_R := Mix (Self, A_V);
      return V_R;
   end Call_Mix;

   function Fill (Self : in out Widget; A_V : Wuffs.U8; A_N : Wuffs.U32) return Wuffs.U64 is
      V_R : Wuffs.U64 := 0;
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return 0;
      end if;
      Wuffs.Base.Slices.Bulk_Memset_U8 (Dst => Self.F_Buf (3 .. 20), Byte_Value => A_V);
      V_R := Sum_Buf (Self);
      if FLAGS (Wuffs.Index (A_N and 3)) then
         V_R := V_R + 1000000;
      end if;
      return V_R;
   end Fill;

end Wuffs.Std.M1test;
