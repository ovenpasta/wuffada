         C0 := Composite_Nonpremul_Nonpremul_U32_Axxx (D0, S0);
         Poke_U16LE (Dst, D, U16 (Shift_Right (C0, 16) and 16#FFFF#));
         pragma Loop_Invariant
           (for all J in Dst'Range =>
              (if J - Dst'First >= (I + 1) * 2
               then Dst (J) = Dst'Loop_Entry (J)));
