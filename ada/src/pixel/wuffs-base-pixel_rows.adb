         Dst (D) := Dst_Palette (Dst_Palette'First + Index (U64 (Src (S)) * 4));
         pragma Loop_Invariant
           (for all J in Dst'Range =>
              (if J - Dst'First >= (I + 1) * 1
               then Dst (J) = Dst'Loop_Entry (J)));
