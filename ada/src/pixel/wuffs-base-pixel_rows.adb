     (Dst : in out Bytes; Dst_Palette : Bytes; Src : Bytes; N : out Pixel_Count)
   is
      pragma Unreferenced (Dst_Palette);
      Len : constant Offset := Offset'Min (Dst'Length / 2, Src'Length / 2);
      D   : Index;
      S   : Index;
      C0 : U32;
      D0 : U32;
      S0 : U32;
   begin
      for I in 0 .. Len - 1 loop
         pragma Assert
           (I + 1 <= Dst'Length / 2 and then I + 1 <= Src'Length / 2);
         pragma Assert
           ((I + 1) * 2 <= Dst'Length and then (I + 1) * 2 <= Src'Length);
         D := Dst'First + I * 2;
