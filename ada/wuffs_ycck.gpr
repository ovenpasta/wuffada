--  The SPARK-proved YCbCr / YCCK part of the base library (ada/src/ycck):
--  the swizzle_ycck operation that JPEG needs.  It builds on, and re-proves
--  together with, the frozen core (src/base) and pixel library (src/pixel).
--  Owner: base-library work.
with "wuffs_common.gpr";
project Wuffs_YCCK is
   for Source_Dirs use ("src/root", "src/base", "src/pixel", "src/ycck");
   for Object_Dir use "obj/ycck/" & Wuffs_Common.Profile;
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use Wuffs_Common.Switches;
   end Compiler;
   package Prove is
      --  Level 2 (provers cvc5, z3, altergo), but with a step limit in place
      --  of the level's 5 second prover timeout, so that a check is proved or
      --  not regardless of how busy the machine is.  The same limit is in
      --  wuffs_base.gpr, wuffs_pixel.gpr and wuffs_ycck.gpr.
      for Proof_Switches ("Ada") use Wuffs_Common.Proof_Switches;
   end Prove;
end Wuffs_YCCK;
