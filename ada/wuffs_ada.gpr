--  Part of wuffada (wuffs-ada: Wuffs to Ada).
--  SPDX-License-Identifier: Apache-2.0 OR MIT

--  The library: the proved base (Wuffs.Base.*), the runtime shell
--  (Wuffs.Runtime.*) and the generated decoders (Wuffs.Std.*).  This is the
--  project that an Alire dependency on wuffs_ada brings in.
--
--    WUFFS_PROFILE=release (the default here) | checked
--        "checked" keeps every Ada run-time check and assertion.
--    WUFFS_SIMD=on (the default; x86-64 only) | off
--        "off" builds the scalar-only library, for any other target.
--
--  The tests use ada/wuffs_gen.gpr instead, which defaults to "checked".

with "wuffs_common.gpr";
with "wuffs_simd.gpr";
library project Wuffs_Ada is

   type Profile_Type is ("checked", "release");
   Profile : Profile_Type := external ("WUFFS_PROFILE", "release");

   for Library_Name use "wuffs_ada";
   for Library_Kind use external ("WUFFS_ADA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));

   for Source_Dirs use
     ("src/root", "src/base", "src/pixel", "src/ycck", "src/token", "src/runtime", "src/runtime/target", "gen")
     & Wuffs_Simd.Gen_Dirs & Wuffs_Simd.CPU_Dirs;
   for Object_Dir use "obj/lib/" & Profile & Wuffs_Simd.Obj_Suffix;
   for Library_Dir use "lib/" & Profile & Wuffs_Simd.Obj_Suffix;
   for Create_Missing_Dirs use "True";

   package Compiler renames Wuffs_Simd.Compiler;

end Wuffs_Ada;
