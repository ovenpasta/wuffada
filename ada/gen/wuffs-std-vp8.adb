   function Read_Bit
     (Self : in out Decoder;
      A_Workbuf : Wuffs.Bytes;
      A_Part : G_U32_Range_0_8;
      A_Prob : G_U32_Range_0_255)
      return G_U32_Range_0_1
   is
      V_P : G_U32_Range_0_8 := 0;
      V_C8 : Wuffs.U8 := 0;
      V_Shift : G_U32_Range_0_31 := 0;
      V_Split_M1 : G_U32_Range_0_254 := 0;
      V_Ret : G_U32_Range_0_1 := 0;
   begin
      V_P := A_Part;
      if Self.F_Part_N_Bits (Wuffs.Index (V_P)) < 8 then
         V_C8 := 0;
         if Self.F_Part_Workbuf_Ris (Wuffs.Index (V_P)) < Wuffs.U64 (A_Workbuf'Length) then
            pragma Warnings ("C");
            pragma Assert (Self.F_Part_Workbuf_Ris (Wuffs.Index (V_P)) < 16#FFFF_FFFF_FFFF_FFFF#);
            pragma Warnings ("c");
            V_C8 :=
              A_Workbuf (A_Workbuf'First
                           + Wuffs.Index (Self.F_Part_Workbuf_Ris (Wuffs.Index (V_P))));
            Self.F_Part_Workbuf_Ris (Wuffs.Index (V_P)) :=
              Self.F_Part_Workbuf_Ris (Wuffs.Index (V_P)) + 1;
         end if;
         Self.F_Part_Bits (Wuffs.Index (V_P)) :=
           Interfaces.Shift_Left (Self.F_Part_Bits (Wuffs.Index (V_P)), 8) or Wuffs.U32 (V_C8);
         Self.F_Part_N_Bits (Wuffs.Index (V_P)) := Self.F_Part_N_Bits (Wuffs.Index (V_P)) + 8;
      end if;
      V_Shift := Self.F_Part_N_Bits (Wuffs.Index (V_P)) - 8 and 31;
      V_Split_M1 := Interfaces.Shift_Right (Self.F_Part_Range_M1s (Wuffs.Index (V_P)) * A_Prob, 8);
      if Interfaces.Shift_Right (Self.F_Part_Bits (Wuffs.Index (V_P)), Natural (V_Shift))
           > V_Split_M1
      then
         V_Ret := 1;
         Self.F_Part_Range_M1s (Wuffs.Index (V_P)) :=
           Self.F_Part_Range_M1s (Wuffs.Index (V_P)) - (V_Split_M1 + 1) and 16#FF#;
         Self.F_Part_Bits (Wuffs.Index (V_P)) :=
           Self.F_Part_Bits (Wuffs.Index (V_P))
             - Interfaces.Shift_Left (V_Split_M1 + 1, Natural (V_Shift));
      else
         V_Ret := 0;
         Self.F_Part_Range_M1s (Wuffs.Index (V_P)) := V_Split_M1;
      end if;
      Self.F_Part_N_Bits (Wuffs.Index (V_P)) :=
        Self.F_Part_N_Bits (Wuffs.Index (V_P))
          - Wuffs.U32 (RENORM_SHIFT (Wuffs.Index (Self.F_Part_Range_M1s (Wuffs.Index (V_P)))));
      Self.F_Part_Range_M1s (Wuffs.Index (V_P)) :=
        Wuffs.U32 (RENORM_RANGE_M1 (Wuffs.Index (Self.F_Part_Range_M1s (Wuffs.Index (V_P)))));
      return V_Ret;
   end Read_Bit;

   function Read_Unsigned
     (Self : in out Decoder;
      A_Workbuf : Wuffs.Bytes;
      A_Part : G_U32_Range_0_8;
      A_N : G_U32_Range_0_31)
      return Wuffs.U32
   is
      V_N : G_U32_Range_0_31 := 0;
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
   begin
      V_N := A_N;
      while V_N > 0 loop
         V_N := V_N - 1;
         V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => A_Part, A_Prob => 128);
         V_V32 := V_V32 or Interfaces.Shift_Left (V_V1, Natural (V_N));
      end loop;
      return V_V32;
   end Read_Unsigned;

   function Read_Signed
     (Self : in out Decoder;
      A_Workbuf : Wuffs.Bytes;
      A_Part : G_U32_Range_0_8;
      A_N : G_U32_Range_0_31)
      return Wuffs.U32
   is
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
   begin
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => A_Part, A_Prob => 128);
      if V_V1 = 0 then
         return 0;
      end if;
      V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => A_Part, A_N => A_N);
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => A_Part, A_Prob => 128);
      if V_V1 = 0 then
         return V_V32;
      end if;
      return 0 - V_V32;
   end Read_Signed;

   function Decode_Coefficients
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Mbx : G_U32_Range_0_1023;
      A_Mby : G_U32_Range_0_1023;
      A_Seg : G_U32_Range_0_3;
      A_Luma_Mode : G_U32_Range_0_4)
      return G_U32_Range_0_1
   is
      V_Bc : Wuffs.U32 := 0;
      V_By : Wuffs.U32 := 0;
      V_Bx : Wuffs.U32 := 0;
      V_B : G_U32_Range_0_23 := 0;
      V_Plane : G_U32_Range_0_3 := 0;
      V_Lnz : G_U32_Range_0_1 := 0;
      V_Tnz : G_U32_Range_0_1 := 0;
      V_Bit : G_U32_Range_0_1 := 0;
   begin
      Self.F_Mb_Dc_Nz := 0;
      Self.F_Mb_Ac_Nz := 0;
      Initialize_Mb_Coeffs (Self);
      V_Plane := 3;
      if A_Luma_Mode < 4 then
         V_Lnz := 1 and Interfaces.Shift_Right (Self.F_Mb_States_Left, 23);
         Self.F_Mb_States_Left := Self.F_Mb_States_Left and 16#FF7F_FFFF#;
         V_Tnz := 1 and Interfaces.Shift_Right (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)), 23);
         Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
           Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) and 16#FF7F_FFFF#;
         V_Lnz :=
           Decode_Subblock_Coefficients (Self,
                                         A_Workbuf => A_Workbuf,
                                         A_Mby => A_Mby,
                                         A_Seg => A_Seg,
                                         A_B => 24,
                                         A_Plane => 1,
                                         A_Context => V_Lnz + V_Tnz);
         Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
           Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) or Interfaces.Shift_Left (V_Lnz, 23);
         Self.F_Mb_States_Left := Self.F_Mb_States_Left or Interfaces.Shift_Left (V_Lnz, 23);
         Inverse_Wht (Self);
         V_Plane := 0;
      end if;
      V_By := 0;
      while V_By < 4 loop
         V_Lnz := 1 and Interfaces.Shift_Right (Self.F_Mb_States_Left, Natural (24 + V_By));
         Self.F_Mb_States_Left :=
           Self.F_Mb_States_Left
             and (16#FFFF_FFFF# xor Interfaces.Shift_Left (Wuffs.U32'(1), Natural (24 + V_By)));
         V_Bx := 0;
         while V_Bx < 4 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_By < 4);
            pragma Warnings ("c");
            V_Tnz :=
              1
                and Interfaces.Shift_Right (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)),
                                            Natural (24 + V_Bx));
            Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
              Self.F_Mb_States_Top (Wuffs.Index (A_Mbx))
                and (16#FFFF_FFFF# xor Interfaces.Shift_Left (Wuffs.U32'(1), Natural (24 + V_Bx)));
            V_B := 4 * V_By + V_Bx;
            V_Lnz :=
              Decode_Subblock_Coefficients (Self,
                                            A_Workbuf => A_Workbuf,
                                            A_Mby => A_Mby,
                                            A_Seg => A_Seg,
                                            A_B => V_B,
                                            A_Plane => V_Plane,
                                            A_Context => V_Lnz + V_Tnz);
            V_Bit := 0;
            if Self.F_Mb_Coeffs (Wuffs.Index (V_B)) (0) /= 0 then
               V_Bit := 1;
            end if;
            Self.F_Mb_Dc_Nz := Self.F_Mb_Dc_Nz or Interfaces.Shift_Left (V_Bit, Natural (V_B));
            Self.F_Mb_Ac_Nz := Self.F_Mb_Ac_Nz or Interfaces.Shift_Left (V_Lnz, Natural (V_B));
            Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
              Self.F_Mb_States_Top (Wuffs.Index (A_Mbx))
                or Interfaces.Shift_Left (V_Lnz, Natural (24 + V_Bx));
            V_Bx := V_Bx + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_By < 4);
         pragma Warnings ("c");
         Self.F_Mb_States_Left :=
           Self.F_Mb_States_Left or Interfaces.Shift_Left (V_Lnz, Natural (24 + V_By));
         V_By := V_By + 1;
      end loop;
      V_Bc := 0;
      while V_Bc <= 2 loop
         V_By := 0;
         while V_By < 2 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Bc <= 2);
            pragma Warnings ("c");
            V_Lnz :=
              1 and Interfaces.Shift_Right (Self.F_Mb_States_Left, Natural (28 + V_Bc + V_By));
            Self.F_Mb_States_Left :=
              Self.F_Mb_States_Left
                and (16#FFFF_FFFF#
                       xor Interfaces.Shift_Left (Wuffs.U32'(1), Natural (28 + V_Bc + V_By)));
            V_Bx := 0;
            while V_Bx < 2 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_Bc <= 2);
               pragma Loop_Invariant (V_By < 2);
               pragma Warnings ("c");
               V_Tnz :=
                 1
                   and Interfaces.Shift_Right (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)),
                                               Natural (28 + V_Bc + V_Bx));
               Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
                 Self.F_Mb_States_Top (Wuffs.Index (A_Mbx))
                   and (16#FFFF_FFFF#
                          xor Interfaces.Shift_Left (Wuffs.U32'(1), Natural (28 + V_Bc + V_Bx)));
               V_B := 2 * V_Bc + 2 * V_By + V_Bx + 16;
               V_Lnz :=
                 Decode_Subblock_Coefficients (Self,
                                               A_Workbuf => A_Workbuf,
                                               A_Mby => A_Mby,
                                               A_Seg => A_Seg,
                                               A_B => V_B,
                                               A_Plane => 2,
                                               A_Context => V_Lnz + V_Tnz);
               Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
                 Self.F_Mb_States_Top (Wuffs.Index (A_Mbx))
                   or Interfaces.Shift_Left (V_Lnz, Natural (28 + V_Bc + V_Bx));
               V_Bit := 0;
               if Self.F_Mb_Coeffs (Wuffs.Index (V_B)) (0) /= 0 then
                  V_Bit := 1;
               end if;
               Self.F_Mb_Dc_Nz := Self.F_Mb_Dc_Nz or Interfaces.Shift_Left (V_Bit, Natural (V_B));
               Self.F_Mb_Ac_Nz := Self.F_Mb_Ac_Nz or Interfaces.Shift_Left (V_Lnz, Natural (V_B));
               V_Bx := V_Bx + 1;
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_Bc <= 2);
            pragma Assert (V_By < 2);
            pragma Warnings ("c");
            Self.F_Mb_States_Left :=
              Self.F_Mb_States_Left or Interfaces.Shift_Left (V_Lnz, Natural (28 + V_Bc + V_By));
            V_By := V_By + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Bc <= 2);
         pragma Warnings ("c");
         V_Bc := V_Bc + 2;
      end loop;
      if Self.F_Mb_Dc_Nz = 0 and then Self.F_Mb_Ac_Nz = 0 then
         return 1;
      end if;
      return 0;
   end Decode_Coefficients;

   procedure Initialize_Mb_Coeffs (Self : in out Decoder) is
      V_I : Wuffs.U32 := 0;
      V_J : Wuffs.U32 := 0;
   begin
      V_I := 0;
      while V_I < 25 loop
         V_J := 0;
         while V_J < 16 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_I < 25);
            pragma Warnings ("c");
            Self.F_Mb_Coeffs (Wuffs.Index (V_I)) (Wuffs.Index (V_J)) := 0;
            V_J := V_J + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_I < 25);
         pragma Warnings ("c");
         V_I := V_I + 1;
      end loop;
   end Initialize_Mb_Coeffs;

   function Decode_Subblock_Coefficients
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Mby : G_U32_Range_0_1023;
      A_Seg : G_U32_Range_0_3;
      A_B : G_U32_Range_0_24;
      A_Plane : G_U32_Range_0_3;
      A_Context : G_U32_Range_0_2)
      return G_U32_Range_0_1
   is
      V_Q1 : G_U32_Range_0_2 := 0;
      V_Q2 : G_U32_Range_0_1 := 0;
      V_Quant : Wuffs.U32 range 0 .. 65535 := 0;
      V_I : Wuffs.U32 := 0;
      V_Part : G_U32_Range_0_8 := 0;
      V_Prob_Base : G_U32_Range_0_1045 := 0;
      V_V1 : G_U32_Range_0_1 := 0;
      V_Value : Wuffs.U32 := 0;
   begin
      V_Q1 := 0;
      if A_B = 24 then
         V_Q1 := 1;
      elsif A_B >= 16 then
         V_Q1 := 2;
      end if;
      V_I := 0;
      pragma Warnings ("C");
      pragma Assert (V_I <= 1);
      pragma Warnings ("c");
      if A_Plane = 0 then
         V_I := 1;
         pragma Warnings ("C");
         pragma Assert (V_I <= 1);
         pragma Warnings ("c");
      end if;
      V_Part := 1 + (A_Mby and Self.F_Num_Other_Partitions_M1);
      V_Prob_Base := A_Plane * 264 + COEFF_BANDS_33 (Wuffs.Index (V_I)) + A_Context * 11;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => V_Part,
                  A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (V_Prob_Base + 0))));
      if V_V1 = 0 then
         return 0;
      end if;
      G_Loop_1 :
      loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_I < 16);
         pragma Warnings ("c");
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => V_Part,
                     A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (V_Prob_Base + 1))));
         if V_V1 = 0 then
            V_I := V_I + 1;
            if V_I >= 16 then
               exit G_Loop_1;
            end if;
            V_Prob_Base := A_Plane * 264 + COEFF_BANDS_33 (Wuffs.Index (V_I + 0)) + 0;
            goto G_Continue_1;
         end if;
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => V_Part,
                     A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (V_Prob_Base + 2))));
         if V_V1 = 0 then
            V_Value := 1;
            V_Prob_Base := A_Plane * 264 + COEFF_BANDS_33 (Wuffs.Index (V_I + 1)) + 11;
         else
            V_Value :=
              Decode_Large_Value (Self,
                                  A_Workbuf => A_Workbuf,
                                  A_Part => V_Part,
                                  A_Prob_Base => V_Prob_Base);
            V_Prob_Base := A_Plane * 264 + COEFF_BANDS_33 (Wuffs.Index (V_I + 1)) + 22;
         end if;
         V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => V_Part, A_Prob => 128);
         if V_V1 /= 0 then
            V_Value := 0 - V_Value;
         end if;
         V_Q2 := 0;
         if V_I /= 0 then
            V_Q2 := 1;
         end if;
         V_Quant :=
           Wuffs.U32 (Self.F_Dequants (Wuffs.Index (A_Seg)) (Wuffs.Index (V_Q1))
                        (Wuffs.Index (V_Q2)));
         Self.F_Mb_Coeffs (Wuffs.Index (A_B)) (Wuffs.Index (ZIGZAG (Wuffs.Index (V_I)))) :=
           Wuffs.U16 (V_Value * V_Quant and 16#FFFF#);
         if V_I >= 15 then
            exit G_Loop_1;
         end if;
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => V_Part,
                     A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (V_Prob_Base + 0))));
         if V_V1 = 0 then
            exit G_Loop_1;
         end if;
         V_I := V_I + 1;
         <<G_Continue_1>>
         null;
      end loop G_Loop_1;
      return 1;
   end Decode_Subblock_Coefficients;

   function Decode_Large_Value
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Part : G_U32_Range_0_8;
      A_Prob_Base : G_U32_Range_0_1045)
      return G_U32_Range_2_2114
   is
      pragma Unmodified (A_Workbuf);
      V_V1 : G_U32_Range_0_1 := 0;
      V_W1 : G_U32_Range_0_1 := 0;
      V_Category : G_U32_Range_0_3 := 0;
      V_Value : Wuffs.U32 := 0;
      V_I : G_U32_Range_0_15 := 0;
   begin
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => A_Part,
                  A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (A_Prob_Base + 3))));
      if V_V1 = 0 then
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => A_Part,
                     A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (A_Prob_Base + 4))));
         if V_V1 = 0 then
            return 2;
         end if;
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => A_Part,
                     A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (A_Prob_Base + 5))));
         return 3 + V_V1;
      end if;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => A_Part,
                  A_Prob => Wuffs.U32 (Self.F_Coeff_Probs (Wuffs.Index (A_Prob_Base + 6))));
      if V_V1 = 0 then
         V_V1 :=
           Read_Bit (Self,
