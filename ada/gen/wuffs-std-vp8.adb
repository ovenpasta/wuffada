   overriding function Get_Quirk (Self : Decoder; A_Key : Wuffs.U32) return Wuffs.U64 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return 0;
      end if;
      if A_Key = 3 then
         return Self.F_Quirk_Source_Length;
      elsif A_Key = QUIRK_HAS_ALPHA_SIDE_CHANNEL then
         if Self.F_Quirk_Has_Alpha_Side_Channel then
            return 1;
         end if;
      elsif A_Key = QUIRK_WIDTH_AND_HEIGHT then
         return Self.F_Quirk_Width_And_Height;
      end if;
      return 0;
   end Get_Quirk;

   overriding function Set_Quirk
     (Self : in out Decoder; A_Key : Wuffs.U32; A_Value : Wuffs.U64) return Wuffs.Status
   is
      V_W : Wuffs.U32 := 0;
      V_H : Wuffs.U32 := 0;
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return
           (if Self.Magic = Wuffs.Runtime.Magic_Disabled
            then Wuffs.Base.Error_Disabled_By_Previous_Error
            else Wuffs.Base.Error_Initialize_Not_Called);
      end if;
      if A_Key = 3 then
         if (A_Value and 1) = 0 then
            if A_Value /= 0 then
               return Error_Bad_QUIRK_SOURCE_LENGTH;
            end if;
            Self.F_Quirk_Source_Length := 0;
            Self.F_Partitioned_Data_Length := 0;
         elsif Interfaces.Shift_Right (A_Value, 1) < 10 then
            return Error_Bad_QUIRK_SOURCE_LENGTH;
         elsif Interfaces.Shift_Right (A_Value, 1) > 16#900_0001# then
            return Error_Unsupported_QUIRK_SOURCE_LENGTH;
         else
            Self.F_Quirk_Source_Length := A_Value;
            Self.F_Partitioned_Data_Length := Wuffs.U32 (Interfaces.Shift_Right (A_Value, 1)) - 10;
         end if;
         return Wuffs.Ok_Status;
      elsif A_Key = QUIRK_HAS_ALPHA_SIDE_CHANNEL then
         Self.F_Quirk_Has_Alpha_Side_Channel := A_Value /= 0;
         return Wuffs.Ok_Status;
      elsif A_Key = QUIRK_WIDTH_AND_HEIGHT then
         V_W := Wuffs.U32 (A_Value and 16#FFFF_FFFF#);
         V_H := Wuffs.U32 (Interfaces.Shift_Right (A_Value, 32));
         if V_W < 1 or else 16#3FFF# < V_W or else V_H < 1 or else 16#3FFF# < V_H then
            return Error_Bad_QUIRK_WIDTH_AND_HEIGHT;
         end if;
         Self.F_Quirk_Width_And_Height := A_Value;
         Self.F_Width := V_W;
         Self.F_Height := V_H;
         Calculate_Mbw_Mbh (Self);
         return Wuffs.Ok_Status;
      end if;
      return Wuffs.Base.Error_Unsupported_Option;
   end Set_Quirk;

