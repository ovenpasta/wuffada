      V_I : Wuffs.U32 := 0;
   begin
      V_Dc :=
        Wuffs.Base.Ints.Sign_Extend_Rshift_U16 (A => Self.F_Mb_Coeffs (Wuffs.Index (A_B)) (0) + 4,
                                                N => 3);
      V_I := 0;
      while V_I < 16 loop
         Self.F_Yuv_Cache (Wuffs.Index (A_Cachey + Interfaces.Shift_Right (V_I, 2)))
           (Wuffs.Index (A_Cachex + (V_I and 3))) :=
           CLAMP (Wuffs.Index (1023
                                 and V_Dc
                                       + Wuffs.U16
                                           (Self.F_Yuv_Cache
                                              (Wuffs.Index
                                                 (A_Cachey + Interfaces.Shift_Right (V_I, 2)))
                                              (Wuffs.Index (A_Cachex + (V_I and 3))))));
         V_I := V_I + 1;
      end loop;
   end Inverse_Dct_Dc_Only;

