   begin
      V_A00 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#0#));
      V_A01 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#4#));
      V_A02 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#8#));
      V_A03 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#C#));
      V_B00 := V_A00 + V_A03;
      V_B01 := V_A01 + V_A02;
      V_B02 := V_A01 - V_A02;
      V_B03 := V_A00 - V_A03;
      V_M00 := V_B00 + V_B01;
      V_M01 := V_B03 + V_B02;
      V_M02 := V_B00 - V_B01;
      V_M03 := V_B03 - V_B02;
      V_A10 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#1#));
      V_A11 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#5#));
      V_A12 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#9#));
      V_A13 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#D#));
      V_B10 := V_A10 + V_A13;
      V_B11 := V_A11 + V_A12;
      V_B12 := V_A11 - V_A12;
      V_B13 := V_A10 - V_A13;
      V_M10 := V_B10 + V_B11;
      V_M11 := V_B13 + V_B12;
      V_M12 := V_B10 - V_B11;
      V_M13 := V_B13 - V_B12;
      V_A20 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#2#));
      V_A21 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#6#));
      V_A22 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#A#));
      V_A23 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#E#));
      V_B20 := V_A20 + V_A23;
      V_B21 := V_A21 + V_A22;
      V_B22 := V_A21 - V_A22;
      V_B23 := V_A20 - V_A23;
      V_M20 := V_B20 + V_B21;
      V_M21 := V_B23 + V_B22;
      V_M22 := V_B20 - V_B21;
      V_M23 := V_B23 - V_B22;
      V_A30 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#3#));
      V_A31 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#7#));
      V_A32 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#B#));
      V_A33 := Wuffs.Base.Ints.Sign_Extend_Convert_U16_U32 (Self.F_Mb_Coeffs (24) (16#F#));
      V_B30 := V_A30 + V_A33;
      V_B31 := V_A31 + V_A32;
      V_B32 := V_A31 - V_A32;
      V_B33 := V_A30 - V_A33;
      V_M30 := V_B30 + V_B31;
      V_M31 := V_B33 + V_B32;
      V_M32 := V_B30 - V_B31;
      V_M33 := V_B33 - V_B32;
      V_P00 := V_M00 + V_M30 + 3;
      V_P01 := V_M10 + V_M20;
      V_P02 := V_M10 - V_M20;
      V_P03 := (V_M00 - V_M30) + 3;
      Self.F_Mb_Coeffs (16#0#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P00 + V_P01, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#1#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P03 + V_P02, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#2#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P00 - V_P01, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#3#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P03 - V_P02, N => 3)
                     and 16#FFFF#);
      V_P10 := V_M01 + V_M31 + 3;
      V_P11 := V_M11 + V_M21;
      V_P12 := V_M11 - V_M21;
      V_P13 := (V_M01 - V_M31) + 3;
      Self.F_Mb_Coeffs (16#4#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P10 + V_P11, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#5#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P13 + V_P12, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#6#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P10 - V_P11, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#7#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P13 - V_P12, N => 3)
                     and 16#FFFF#);
      V_P20 := V_M02 + V_M32 + 3;
      V_P21 := V_M12 + V_M22;
      V_P22 := V_M12 - V_M22;
      V_P23 := (V_M02 - V_M32) + 3;
      Self.F_Mb_Coeffs (16#8#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P20 + V_P21, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#9#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P23 + V_P22, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#A#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P20 - V_P21, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#B#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P23 - V_P22, N => 3)
                     and 16#FFFF#);
      V_P30 := V_M03 + V_M33 + 3;
      V_P31 := V_M13 + V_M23;
      V_P32 := V_M13 - V_M23;
      V_P33 := (V_M03 - V_M33) + 3;
      Self.F_Mb_Coeffs (16#C#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P30 + V_P31, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#D#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P33 + V_P32, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#E#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P30 - V_P31, N => 3)
                     and 16#FFFF#);
      Self.F_Mb_Coeffs (16#F#) (0) :=
        Wuffs.U16 (Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_P33 - V_P32, N => 3)
                     and 16#FFFF#);
   end Inverse_Wht;

   function Decode_Macroblocks
     (Self : in out Decoder; A_Workbuf : in out Wuffs.Bytes) return Wuffs.Status
   is
      V_Mby : Wuffs.U32 := 0;
      V_Mbx : Wuffs.U32 := 0;
   begin
      V_Mbx := 0;
      while V_Mbx < Self.F_Mbw loop
         pragma Warnings ("C");
         pragma Assert (V_Mbx < 16#400#);
         pragma Warnings ("c");
         Self.F_Mb_States_Top (Wuffs.Index (V_Mbx)) := 0;
         V_Mbx := V_Mbx + 1;
      end loop;
      V_Mby := 0;
      while V_Mby < Self.F_Mbh loop
         pragma Warnings ("C");
         pragma Assert (V_Mby < 16#400#);
         pragma Warnings ("c");
         Self.F_Mb_States_Left := 0;
         V_Mbx := 0;
         while V_Mbx < Self.F_Mbw loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Mby < 16#400#);
            pragma Assert (V_Mbx < 16#400#);
            pragma Warnings ("c");
            Decode_One_Macroblock (Self, A_Workbuf => A_Workbuf, A_Mbx => V_Mbx, A_Mby => V_Mby);
            V_Mbx := V_Mbx + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Mby < 16#400#);
         pragma Warnings ("c");
         if V_Mby > 0 then
            if Self.F_Filt_Level = 0 then
               null;
            elsif Self.F_Filt_Simple then
               Filter_Simple (Self, A_Workbuf => A_Workbuf, A_Mby => V_Mby - 1);
            else
               Filter_Normal (Self, A_Workbuf => A_Workbuf, A_Mby => V_Mby - 1);
            end if;
         end if;
         V_Mby := V_Mby + 1;
      end loop;
      if Self.F_Mbh > 0 then
         if Self.F_Filt_Level = 0 then
            null;
         elsif Self.F_Filt_Simple then
            Filter_Simple (Self, A_Workbuf => A_Workbuf, A_Mby => Self.F_Mbh - 1);
         else
            Filter_Normal (Self, A_Workbuf => A_Workbuf, A_Mby => Self.F_Mbh - 1);
         end if;
      end if;
      return Wuffs.Ok_Status;
   end Decode_Macroblocks;

   procedure Decode_One_Macroblock
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Mbx : G_U32_Range_0_1023;
      A_Mby : G_U32_Range_0_1023)
   is
      V_V1 : G_U32_Range_0_1 := 0;
      V_Seg : G_U32_Range_0_3 := 0;
      V_Skip : G_U32_Range_0_1 := 0;
      V_Mask : Wuffs.U32 range 0 .. 8454143 := 0;
      V_Luma_Mode : G_U32_Range_0_4 := 0;
      V_Chroma_Mode : G_U32_Range_0_3 := 0;
   begin
      V_Seg := 0;
      if Self.F_Seg_Update_Map then
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => 0,
                     A_Prob => Wuffs.U32 (Self.F_Seg_Probs (0)));
         if V_V1 = 0 then
            V_V1 :=
              Read_Bit (Self,
                        A_Workbuf => A_Workbuf,
                        A_Part => 0,
                        A_Prob => Wuffs.U32 (Self.F_Seg_Probs (1)));
            V_Seg := V_V1;
         else
            V_V1 :=
              Read_Bit (Self,
                        A_Workbuf => A_Workbuf,
                        A_Part => 0,
                        A_Prob => Wuffs.U32 (Self.F_Seg_Probs (2)));
            V_Seg := V_V1 + 2;
         end if;
      end if;
      V_Skip := 0;
      if (Self.F_Prob_Skip and 16#100#) /= 0 then
         V_Skip :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => 0,
                     A_Prob => Self.F_Prob_Skip and 16#FF#);
      end if;
      V_Luma_Mode := Decode_Luma_Mode (Self, A_Workbuf);
      Decode_Subblock_Modes (Self,
                             A_Workbuf => A_Workbuf,
                             A_Mbx => A_Mbx,
                             A_Luma_Mode => V_Luma_Mode);
      V_Chroma_Mode := Decode_Chroma_Mode (Self, A_Workbuf);
      if V_Skip /= 0 then
         V_Mask := 16#0000_FFFF#;
         if V_Luma_Mode = 4 then
            V_Mask := 16#0080_FFFF#;
         end if;
         Self.F_Mb_States_Left := Self.F_Mb_States_Left and V_Mask;
         Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
           Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) and V_Mask;
         Self.F_Mb_Dc_Nz := 0;
         Self.F_Mb_Ac_Nz := 0;
      else
         V_Skip :=
           Decode_Coefficients (Self,
                                A_Workbuf => A_Workbuf,
                                A_Mbx => A_Mbx,
                                A_Mby => A_Mby,
                                A_Seg => V_Seg,
                                A_Luma_Mode => V_Luma_Mode);
      end if;
      Reconstruct (Self,
                   A_Workbuf => A_Workbuf,
                   A_Mbx => A_Mbx,
                   A_Mby => A_Mby,
                   A_Luma_Mode => V_Luma_Mode,
                   A_Chroma_Mode => V_Chroma_Mode);
      Copy_From_Yuv_Cache (Self, A_Workbuf => A_Workbuf, A_Mbx => A_Mbx, A_Mby => A_Mby);
      Self.F_Mb_Filters (Wuffs.Index (A_Mby and 1)) (Wuffs.Index (A_Mbx)) :=
        Wuffs.U8 (Interfaces.Shift_Left (1 xor V_Skip, 3)
                    or Interfaces.Shift_Left (V_Seg, 1)
                    or Interfaces.Shift_Right (V_Luma_Mode, 2));
   end Decode_One_Macroblock;

   function Decode_Luma_Mode
     (Self : in out Decoder; A_Workbuf : in out Wuffs.Bytes) return G_U32_Range_0_4
   is
      pragma Unmodified (A_Workbuf);
      V_V1 : G_U32_Range_0_1 := 0;
   begin
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 145);
      if V_V1 = 0 then
         return 4;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 156);
      if V_V1 = 0 then
         V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 163);
         return 2 * V_V1;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      return 3 - 2 * V_V1;
   end Decode_Luma_Mode;

   function Decode_Chroma_Mode
     (Self : in out Decoder; A_Workbuf : in out Wuffs.Bytes) return G_U32_Range_0_3
   is
      pragma Unmodified (A_Workbuf);
      V_V1 : G_U32_Range_0_1 := 0;
   begin
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 142);
      if V_V1 = 0 then
         return 0;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 114);
      if V_V1 = 0 then
         return 2;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 183);
      return 3 - 2 * V_V1;
   end Decode_Chroma_Mode;

   procedure Decode_Subblock_Modes
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Mbx : G_U32_Range_0_1023;
      A_Luma_Mode : G_U32_Range_0_4)
   is
      V_I : Wuffs.U32 := 0;
      V_Top_Mode : G_U8_Range_0_9 := 0;
      V_Left_Mode : G_U8_Range_0_9 := 0;
      V_Mode : G_U8_Range_0_9 := 0;
   begin
      if A_Luma_Mode < 4 then
         Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
           (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) and 16#FFFF_0000#) or A_Luma_Mode * 16#1111#;
         Self.F_Mb_States_Left :=
           (Self.F_Mb_States_Left and 16#FFFF_0000#) or A_Luma_Mode * 16#1111#;
         return;
      end if;
      V_I := 0;
      while V_I < 16 loop
         if V_I < 4 then
            V_Top_Mode :=
              CLAMP_NO_MORE_THAN_9 (Wuffs.Index
                                      (15
                                         and Interfaces.Shift_Right
                                               (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)),
                                                Natural (V_I * 4))));
         else
            V_Top_Mode := Self.F_Mb_Subblock_Modes (Wuffs.Index (V_I - 4));
         end if;
         if (V_I and 3) = 0 then
            V_Left_Mode :=
              CLAMP_NO_MORE_THAN_9 (Wuffs.Index
                                      (15
                                         and Interfaces.Shift_Right
                                               (Self.F_Mb_States_Left,
                                                Natural (V_I and 12))));
         else
            V_Left_Mode := Self.F_Mb_Subblock_Modes (Wuffs.Index (V_I + 15 and 15));
         end if;
         V_Mode :=
           Decode_One_Subblock_Mode (Self,
                                     A_Workbuf => A_Workbuf,
                                     A_Top_Mode => V_Top_Mode,
                                     A_Left_Mode => V_Left_Mode);
         Self.F_Mb_Subblock_Modes (Wuffs.Index (V_I)) := V_Mode;
         V_I := V_I + 1;
      end loop;
      Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) :=
        (Self.F_Mb_States_Top (Wuffs.Index (A_Mbx)) and 16#FFFF_0000#)
          or Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#C#))
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#D#)), 16#4#)
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#E#)), 16#8#)
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#F#)), 16#C#);
      Self.F_Mb_States_Left :=
        (Self.F_Mb_States_Left and 16#FFFF_0000#)
          or Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#3#))
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#7#)), 16#4#)
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#B#)), 16#8#)
          or Interfaces.Shift_Left (Wuffs.U32 (Self.F_Mb_Subblock_Modes (16#F#)), 16#C#);
   end Decode_Subblock_Modes;

   function Decode_One_Subblock_Mode
     (Self : in out Decoder;
      A_Workbuf : in out Wuffs.Bytes;
      A_Top_Mode : G_U8_Range_0_9;
      A_Left_Mode : G_U8_Range_0_9)
      return G_U8_Range_0_9
   is
      pragma Unmodified (A_Workbuf);
      V_V1 : G_U32_Range_0_1 := 0;
      V_Tm : G_U8_Range_0_9 := 0;
      V_Lm : G_U8_Range_0_9 := 0;
   begin
      V_Tm := A_Top_Mode;
      V_Lm := A_Left_Mode;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => 0,
                  A_Prob => Wuffs.U32 (SUBBLOCK_MODE_PROBS (Wuffs.Index (V_Tm)) (Wuffs.Index (V_Lm))
                                         (0)));
      if V_V1 = 0 then
         return 0;
      end if;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => 0,
                  A_Prob => Wuffs.U32 (SUBBLOCK_MODE_PROBS (Wuffs.Index (V_Tm)) (Wuffs.Index (V_Lm))
                                         (1)));
      if V_V1 = 0 then
         return 1;
      end if;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => 0,
                  A_Prob => Wuffs.U32 (SUBBLOCK_MODE_PROBS (Wuffs.Index (V_Tm)) (Wuffs.Index (V_Lm))
                                         (2)));
      if V_V1 = 0 then
         return 2;
      end if;
      V_V1 :=
        Read_Bit (Self,
                  A_Workbuf => A_Workbuf,
                  A_Part => 0,
                  A_Prob => Wuffs.U32 (SUBBLOCK_MODE_PROBS (Wuffs.Index (V_Tm)) (Wuffs.Index (V_Lm))
                                         (3)));
      if V_V1 = 0 then
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => 0,
                     A_Prob => Wuffs.U32 (SUBBLOCK_MODE_PROBS (Wuffs.Index (V_Tm))
                                            (Wuffs.Index (V_Lm))
                                            (4)));
         if V_V1 = 0 then
            return 3;
         end if;
