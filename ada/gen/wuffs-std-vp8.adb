               V_O := M_W - Wuffs.U64 (A_J_Step) * 2;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_P1 + V_A3);
               end if;
               V_O := M_W - Wuffs.U64 (A_J_Step) * 1;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_P0 + V_A2);
               end if;
               V_O := M_W + Wuffs.U64 (A_J_Step) * 0;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_Q0 - V_A1);
               end if;
               V_O := M_W + Wuffs.U64 (A_J_Step) * 1;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_Q1 - V_A3);
               end if;
            else
               V_A := 3 * (V_Q0 - V_P0) + Clip_M128_P127 (Self, V_P1 - V_Q1);
               V_A := Clip_M128_P127 (Self, V_A);
               V_A1 := Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_A * 16#1B# + 63, N => 7);
               V_A2 := Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_A * 16#12# + 63, N => 7);
               V_A3 := Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_A * 16#09# + 63, N => 7);
               V_O := M_W - Wuffs.U64 (A_J_Step) * 3;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_P2 + V_A3);
               end if;
               V_O := M_W - Wuffs.U64 (A_J_Step) * 2;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_P1 + V_A2);
               end if;
               V_O := M_W - Wuffs.U64 (A_J_Step) * 1;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_P0 + V_A1);
               end if;
               V_O := M_W + Wuffs.U64 (A_J_Step) * 0;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_Q0 - V_A1);
               end if;
               V_O := M_W + Wuffs.U64 (A_J_Step) * 1;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_Q1 - V_A2);
               end if;
               V_O := M_W + Wuffs.U64 (A_J_Step) * 2;
               if V_O < Wuffs.U64 (A_Workbuf'Length) then
                  A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)) :=
                    Clip_255_U8 (Self, V_Q2 - V_A3);
               end if;
            end if;
            exit G_Loop_2_Goto_Increment_And_Continue;
         end loop G_Loop_2_Goto_Increment_And_Continue;
         pragma Warnings ("C");
         pragma Assert (M_N > 0);
         pragma Warnings ("c");
         M_W := M_W + Wuffs.U64 (A_I_Step);
         M_N := M_N - 1;
      end loop;
   end Filter_246;

   function Abs_Diff (Self : Decoder; A_A : Wuffs.U32; A_B : Wuffs.U32) return Wuffs.U32 is
      pragma Unreferenced (Self);
      V_C : Wuffs.U32 := 0;
   begin
      V_C := A_A - A_B;
      if V_C < 16#8000_0000# then
         return V_C;
      end if;
      return 0 - V_C;
   end Abs_Diff;

   function Clip_M16_P15 (Self : Decoder; A_A : Wuffs.U32) return Wuffs.U32 is
      pragma Unreferenced (Self);
   begin
      if A_A + 16#10# <= 16#20# then
         return A_A;
      elsif A_A < 16#8000_0000# then
         return 16#0F#;
      end if;
      return 16#FFFF_FFF0#;
   end Clip_M16_P15;

   function Clip_M128_P127 (Self : Decoder; A_A : Wuffs.U32) return Wuffs.U32 is
      pragma Unreferenced (Self);
   begin
      if A_A + 16#80# <= 16#FF# then
         return A_A;
      elsif A_A < 16#8000_0000# then
         return 16#7F#;
      end if;
      return 16#FFFF_FF80#;
   end Clip_M128_P127;

   function Clip_255_U8 (Self : Decoder; A_A : Wuffs.U32) return Wuffs.U8 is
      pragma Unreferenced (Self);
   begin
      if A_A <= 255 then
         return Wuffs.U8 (A_A);
      elsif A_A < 16#8000_0000# then
         return 255;
      end if;
      return 0;
   end Clip_255_U8;

   function Copy_Partitions_To_Workbuf
     (Self : in out Decoder;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Workbuf : in out Wuffs.Bytes)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_I : Wuffs.U64 := 0;
      V_J : Wuffs.U64 := 0;
      V_N : Wuffs.U32 := 0;
      G_T1 : Wuffs.Runtime.Slice_U8;
      G_T2 : Wuffs.U32;
      G_Susp : Wuffs.U32;
   begin
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      G_Susp := Self.G_P_16_Copy_Partitions_To_Workbuf;
      if G_Susp /= 0 then
         V_I := Self.G_S_16_Copy_Partitions_To_Workbuf_I;
         V_J := Self.G_S_16_Copy_Partitions_To_Workbuf_J;
      end if;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when others =>
            goto G_Suspend;
      end case;
      V_I := Self.F_Workbuf_Yuv_V_End;
      V_J := Self.F_Workbuf_Yuv_V_End + Wuffs.U64 (Self.F_Partitioned_Data_Length);
      <<G_Head_1>>
      if V_I >= V_J then
         goto G_Done_2;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_J <= 16#20FF_FFF7#);
      pragma Warnings ("c");
      if V_J > Wuffs.U64 (A_Workbuf'Length) then
         G_Status := Wuffs.Base.Error_Bad_Workbuf_Length;
         goto G_Exit;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_J > V_I);
      pragma Warnings ("c");
      G_T1 :=
        Wuffs.Runtime.Subslice_IJ (S => (Base => A_Workbuf'Unrestricted_Access,
                                         First => A_Workbuf'First,
                                         Length => A_Workbuf'Length),
                                   I => Wuffs.Index (V_I),
                                   J => Wuffs.Index (V_J));
      Wuffs.Runtime.Reader_Limited_Copy_U32_To_Slice
        (Data => A_Src,
         R => G_R_Src,
         Up_To => Wuffs.U32 (V_J - V_I and 16#FFFF_FFFF#),
         Dst => G_T1.Base (G_T1.First .. Wuffs.Runtime.Last (G_T1)),
         N => G_T2);
      V_N := G_T2;
      V_I := V_I + Wuffs.U64 (V_N);
      if V_I >= V_J then
         goto G_Else_4;
      end if;
      G_Status := Wuffs.Base.Suspension_Short_Read;
      G_Susp := 1;
      goto G_Suspend;
      <<G_Resume_1>>
      goto G_Fi_3;
      <<G_Else_4>>
      null;
      <<G_Fi_3>>
      goto G_Head_1;
      <<G_Done_2>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_J <= 16#20FF_FFF7#);
      pragma Warnings ("c");
      V_J := V_J + 8;
      while V_I < V_J loop
         pragma Warnings ("C");
         pragma Assert (V_I < 16#FFFF_FFFF_FFFF_FFFF#);
         pragma Warnings ("c");
         if V_I >= Wuffs.U64 (A_Workbuf'Length) then
            G_Status := Wuffs.Base.Error_Bad_Workbuf_Length;
            goto G_Exit;
         end if;
         A_Workbuf (A_Workbuf'First + Wuffs.Index (V_I)) := 16#00#;
         V_I := V_I + 1;
      end loop;
      Self.G_P_16_Copy_Partitions_To_Workbuf := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_16_Copy_Partitions_To_Workbuf :=
        (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_S_16_Copy_Partitions_To_Workbuf_I := V_I;
      Self.G_S_16_Copy_Partitions_To_Workbuf_J := V_J;
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return G_Status;
   end Copy_Partitions_To_Workbuf;

   function Decode_Header_Partition
     (Self : in out Decoder; A_Workbuf : Wuffs.Bytes) return Wuffs.Status
   is
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
      G_Discard_1 : Wuffs.U32;
      pragma Warnings (Off, G_Discard_1);
      G_Discard_2 : Wuffs.U32;
      pragma Warnings (Off, G_Discard_2);
      G_Discard_3 : Wuffs.U32;
      pragma Warnings (Off, G_Discard_3);
   begin
      if Self.F_Is_Key_Frame then
         G_Discard_1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
         G_Discard_2 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      end if;
      Decode_Segment_Header (Self, A_Workbuf);
      Decode_Filter_Header (Self, A_Workbuf);
      Calculate_Loop_Filters (Self);
      V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 2);
      Self.F_Num_Other_Partitions_M1 :=
        Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_V32 and 3)) - 1;
      V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 7);
      Self.F_Quant_Yac_Qi := V_V32 and 127;
      Self.F_Quant_Ydc_Delta := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 4);
      Self.F_Quant_Y2dc_Delta := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 4);
      Self.F_Quant_Y2ac_Delta := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 4);
      Self.F_Quant_Uvdc_Delta := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 4);
      Self.F_Quant_Uvac_Delta := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 4);
      Calculate_Dequants (Self);
      if not Self.F_Is_Key_Frame then
         return Error_Unsupported_VP8_File;
      end if;
      G_Discard_3 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      Decode_Coeff_Probs (Self, A_Workbuf);
      if not Self.F_Is_Key_Frame then
         return Error_Unsupported_VP8_File;
      else
         V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
         if V_V1 /= 0 then
            V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 8);
            Self.F_Prob_Skip := (V_V32 and 16#FF#) or 16#100#;
         end if;
      end if;
      return Wuffs.Ok_Status;
   end Decode_Header_Partition;

   procedure Decode_Segment_Header (Self : in out Decoder; A_Workbuf : Wuffs.Bytes) is
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
      V_I : Wuffs.U32 := 0;
   begin
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      Self.F_Seg_Enabled := V_V1 /= 0;
      if not Self.F_Seg_Enabled then
         Self.F_Seg_Update_Map := False;
         return;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      Self.F_Seg_Update_Map := V_V1 /= 0;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      if V_V1 /= 0 then
         V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
         Self.F_Seg_Absolute := V_V1 /= 0;
         V_I := 0;
         while V_I < 4 loop
            V_V32 := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 7);
            Self.F_Seg_Quants (Wuffs.Index (V_I)) := Wuffs.U8 (V_V32 and 16#FF#);
            V_I := V_I + 1;
         end loop;
         V_I := 0;
         while V_I < 4 loop
            V_V32 := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 6);
            Self.F_Seg_Strengths (Wuffs.Index (V_I)) := Wuffs.U8 (V_V32 and 16#FF#);
            V_I := V_I + 1;
         end loop;
      end if;
      if Self.F_Seg_Update_Map then
         V_I := 0;
         while V_I < 3 loop
            V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
            if V_V1 /= 0 then
               V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 8);
               Self.F_Seg_Probs (Wuffs.Index (V_I)) := Wuffs.U8 (V_V32 and 16#FF#);
            else
               Self.F_Seg_Probs (Wuffs.Index (V_I)) := 16#FF#;
            end if;
            V_I := V_I + 1;
         end loop;
      end if;
   end Decode_Segment_Header;

   procedure Decode_Filter_Header (Self : in out Decoder; A_Workbuf : Wuffs.Bytes) is
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
      V_I : Wuffs.U32 := 0;
   begin
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      Self.F_Filt_Simple := V_V1 /= 0;
      V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 6);
      Self.F_Filt_Level := Wuffs.U8 (V_V32 and 16#3F#);
      V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 3);
      Self.F_Filt_Sharpness := Wuffs.U8 (V_V32 and 16#07#);
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      Self.F_Filt_Deltas_Enabled := V_V1 /= 0;
      if not Self.F_Filt_Deltas_Enabled then
         return;
      end if;
      V_V1 := Read_Bit (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_Prob => 128);
      if V_V1 = 0 then
         return;
      end if;
      V_I := 0;
      while V_I < 8 loop
         V_V32 := Read_Signed (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 6);
         Self.F_Filt_Deltas (Wuffs.Index (Interfaces.Shift_Right (V_I, 2)))
           (Wuffs.Index (V_I and 3)) :=
           Wuffs.U8 (V_V32 and 16#FF#);
         V_I := V_I + 1;
      end loop;
   end Decode_Filter_Header;

   procedure Decode_Coeff_Probs (Self : in out Decoder; A_Workbuf : Wuffs.Bytes) is
      V_V1 : G_U32_Range_0_1 := 0;
      V_V32 : Wuffs.U32 := 0;
      V_I : Wuffs.U32 := 0;
   begin
      V_I := 0;
      while V_I < 1056 loop
         V_V1 :=
           Read_Bit (Self,
                     A_Workbuf => A_Workbuf,
                     A_Part => 0,
                     A_Prob => Wuffs.U32 (COEFF_UPDATE_PROBS (Wuffs.Index (V_I))));
         if V_V1 /= 0 then
            V_V32 := Read_Unsigned (Self, A_Workbuf => A_Workbuf, A_Part => 0, A_N => 8);
            Self.F_Coeff_Probs (Wuffs.Index (V_I)) := Wuffs.U8 (V_V32 and 16#FF#);
         else
            Self.F_Coeff_Probs (Wuffs.Index (V_I)) := DEFAULT_COEFF_PROBS (Wuffs.Index (V_I));
         end if;
         V_I := V_I + 1;
      end loop;
   end Decode_Coeff_Probs;

   procedure Calculate_Loop_Filters (Self : in out Decoder) is
      V_Seg : Wuffs.U32 := 0;
      V_Inner : Wuffs.U32 := 0;
      V_Level : Wuffs.U32 := 0;
      V_Ilevel : Wuffs.U32 := 0;
      V_Hlevel : Wuffs.U32 range 0 .. 2 := 0;
   begin
      V_Seg := 0;
      while V_Seg < 4 loop
         V_Inner := 0;
         while V_Inner < 2 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Seg < 4);
            pragma Warnings ("c");
            V_Level := Wuffs.U32 (Self.F_Filt_Level);
            if not Self.F_Seg_Enabled then
               null;
            elsif not Self.F_Filt_Deltas_Enabled then
               V_Level :=
                 Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32
                   (Self.F_Seg_Strengths (Wuffs.Index (V_Seg)));
            else
               V_Level :=
                 V_Level
                   + Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32
                       (Self.F_Seg_Strengths (Wuffs.Index (V_Seg)));
            end if;
            if Self.F_Filt_Deltas_Enabled then
               V_Level :=
                 V_Level + Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Self.F_Filt_Deltas (0) (0));
               if V_Inner /= 0 then
                  V_Level :=
                    V_Level
                      + Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Self.F_Filt_Deltas (1) (0));
               end if;
            end if;
            if V_Level >= 16#8000_0000# then
               Self.F_Loop_Filters (Wuffs.Index (2 * V_Seg + V_Inner)) := 0;
               V_Inner := V_Inner + 1;
               goto G_Continue_2;
            elsif V_Level > 63 then
               V_Level := 63;
            end if;
            V_Ilevel := V_Level;
            if Self.F_Filt_Sharpness > 0 then
               if Self.F_Filt_Sharpness <= 4 then
                  V_Ilevel := Interfaces.Shift_Right (V_Ilevel, 1);
               else
                  V_Ilevel := Interfaces.Shift_Right (V_Ilevel, 2);
               end if;
               V_Ilevel :=
                 Wuffs.Base.Ints.Max_U32 (X => V_Ilevel,
                                          Y => Wuffs.U32 (9 - Self.F_Filt_Sharpness));
            end if;
            if V_Ilevel < 1 or else 16#8000_0000# <= V_Ilevel then
               V_Ilevel := 1;
            end if;
            if V_Level < 15 then
               V_Hlevel := 0;
            elsif V_Level < 40 then
               V_Hlevel := 1;
            else
               V_Hlevel := 2;
            end if;
            V_Level := 2 * V_Level + V_Ilevel;
            Self.F_Loop_Filters (Wuffs.Index (2 * V_Seg + V_Inner)) :=
              V_Level
                or Interfaces.Shift_Left (V_Ilevel, 8)
                or Interfaces.Shift_Left (V_Hlevel, 16)
                or Interfaces.Shift_Left (V_Inner, 31);
            V_Inner := V_Inner + 1;
            <<G_Continue_2>>
            null;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Seg < 4);
         pragma Warnings ("c");
         V_Seg := V_Seg + 1;
      end loop;
   end Calculate_Loop_Filters;

   procedure Calculate_Dequants (Self : in out Decoder) is
      V_Seg : Wuffs.U32 := 0;
      V_Q : Wuffs.U32 := 0;
   begin
      V_Seg := 0;
      while V_Seg < 4 loop
         V_Q := Self.F_Quant_Yac_Qi;
         if not Self.F_Seg_Enabled then
            null;
         elsif Self.F_Seg_Absolute then
            V_Q :=
              Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Self.F_Seg_Quants (Wuffs.Index (V_Seg)));
         else
            V_Q :=
              V_Q
                + Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32
                    (Self.F_Seg_Quants (Wuffs.Index (V_Seg)));
         end if;
         Self.F_Dequants (Wuffs.Index (V_Seg)) (0) (0) :=
           DEQUANTS (0) (Wuffs.Index (Clip_127 (Self, V_Q + Self.F_Quant_Ydc_Delta)));
         Self.F_Dequants (Wuffs.Index (V_Seg)) (0) (1) :=
           DEQUANTS (1) (Wuffs.Index (Clip_127 (Self, V_Q)));
         Self.F_Dequants (Wuffs.Index (V_Seg)) (1) (0) :=
           DEQUANTS (0) (Wuffs.Index (Clip_127 (Self, V_Q + Self.F_Quant_Y2dc_Delta))) * 2;
         Self.F_Dequants (Wuffs.Index (V_Seg)) (1) (1) :=
           (DEQUANTS (1) (Wuffs.Index (Clip_127 (Self, V_Q + Self.F_Quant_Y2ac_Delta))) * 155)
             / 100;
         if Self.F_Dequants (Wuffs.Index (V_Seg)) (1) (1) < 8 then
            Self.F_Dequants (Wuffs.Index (V_Seg)) (1) (1) := 8;
         end if;
         Self.F_Dequants (Wuffs.Index (V_Seg)) (2) (0) :=
           DEQUANTS (0) (Wuffs.Index (Clip_127 (Self, V_Q + Self.F_Quant_Uvdc_Delta)));
         if Self.F_Dequants (Wuffs.Index (V_Seg)) (2) (0) > 132 then
            Self.F_Dequants (Wuffs.Index (V_Seg)) (2) (0) := 132;
         end if;
         Self.F_Dequants (Wuffs.Index (V_Seg)) (2) (1) :=
           DEQUANTS (1) (Wuffs.Index (Clip_127 (Self, V_Q + Self.F_Quant_Uvac_Delta)));
         V_Seg := V_Seg + 1;
      end loop;
   end Calculate_Dequants;

   function Clip_127 (Self : Decoder; A_A : Wuffs.U32) return G_U32_Range_0_127 is
      pragma Unreferenced (Self);
   begin
      if A_A <= 127 then
         return A_A;
      elsif A_A < 16#8000_0000# then
         return 127;
      end if;
      return 0;
   end Clip_127;

   function Decode_Other_Partition_Lengths
     (Self : in out Decoder; A_Workbuf : Wuffs.Bytes) return Wuffs.Status
   is
      V_V32 : Wuffs.U32 := 0;
      V_Remainder : Wuffs.U32 := 0;
      V_I : Wuffs.U32 := 0;
      V_O : Wuffs.U64 := 0;
   begin
      V_Remainder :=
        Wuffs.Base.Ints.Sat_Sub_U32 (X => Self.F_Partitioned_Data_Length,
                                     Y => Self.F_Part_Lens (0));
      V_Remainder :=
        Wuffs.Base.Ints.Sat_Sub_U32 (X => V_Remainder, Y => 3 * Self.F_Num_Other_Partitions_M1);
      V_O := Self.F_Workbuf_Yuv_V_End + Wuffs.U64 (Self.F_Part_Lens (0));
      V_I := 0;
      while V_I < Self.F_Num_Other_Partitions_M1 loop
         pragma Warnings ("C");
         pragma Assert (V_I < 7);
         pragma Warnings ("c");
         V_V32 := 0;
         if V_O >= Wuffs.U64 (A_Workbuf'Length) then
            return Error_Bad_Header;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_O < 16#FFFF_FFFF_FFFF_FFFF#);
         pragma Warnings ("c");
         V_V32 := V_V32 or Wuffs.U32 (A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O)));
         V_O := V_O + 1;
         if V_O >= Wuffs.U64 (A_Workbuf'Length) then
            return Error_Bad_Header;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_O < 16#FFFF_FFFF_FFFF_FFFF#);
         pragma Warnings ("c");
         V_V32 :=
           V_V32
             or Interfaces.Shift_Left (Wuffs.U32 (A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O))),
                                       8);
         V_O := V_O + 1;
         if V_O >= Wuffs.U64 (A_Workbuf'Length) then
            return Error_Bad_Header;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_O < 16#FFFF_FFFF_FFFF_FFFF#);
         pragma Warnings ("c");
         V_V32 :=
           V_V32
             or Interfaces.Shift_Left (Wuffs.U32 (A_Workbuf (A_Workbuf'First + Wuffs.Index (V_O))),
                                       16);
         V_O := V_O + 1;
         if V_Remainder < V_V32 then
            return Error_Bad_Header;
         end if;
         V_Remainder := V_Remainder - V_V32;
         Self.F_Part_Lens (Wuffs.Index (1 + V_I)) := V_V32;
         V_I := V_I + 1;
      end loop;
      if V_Remainder > 16#FF_FFFF# then
         return Error_Unsupported_VP8_File;
      end if;
      Self.F_Part_Lens (Wuffs.Index (1 + Self.F_Num_Other_Partitions_M1)) := V_Remainder;
      V_I := 0;
      while V_I < 1 + Self.F_Num_Other_Partitions_M1 loop
         pragma Warnings ("C");
         pragma Assert (V_I < 8);
         pragma Warnings ("c");
         Self.F_Part_Workbuf_Ris (Wuffs.Index (1 + V_I)) := V_O;
         V_O := V_O + Wuffs.U64 (Self.F_Part_Lens (Wuffs.Index (1 + V_I)));
         if V_O > Wuffs.U64 (A_Workbuf'Length) then
            return Error_Bad_Header;
         end if;
         V_I := V_I + 1;
      end loop;
      return Wuffs.Ok_Status;
   end Decode_Other_Partition_Lengths;

