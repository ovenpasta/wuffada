   procedure Calculate_Mbw_Mbh (Self : in out Decoder) is
   begin
      Self.F_Mbw := (Self.F_Width + 15) / 16;
      Self.F_Mbh := (Self.F_Height + 15) / 16;
      Self.F_Workbuf_Yuv_Y_Stride := Self.F_Mbw * 16;
      Self.F_Workbuf_Yuv_Uv_Stride := Self.F_Mbw * 8;
      Self.F_Workbuf_Yuv_Y_End :=
        Wuffs.U64 (Self.F_Workbuf_Yuv_Y_Stride) * Wuffs.U64 (Self.F_Mbh * 16);
      Self.F_Workbuf_Yuv_U_End :=
        Self.F_Workbuf_Yuv_Y_End
          + Wuffs.U64 (Self.F_Workbuf_Yuv_Uv_Stride) * Wuffs.U64 (Self.F_Mbh * 8);
      Self.F_Workbuf_Yuv_V_End :=
        Self.F_Workbuf_Yuv_U_End
          + Wuffs.U64 (Self.F_Workbuf_Yuv_Uv_Stride) * Wuffs.U64 (Self.F_Mbh * 8);
