            elsif Wuffs.Base.IO.Length (G_R_Src) = 0 then
               if A_Src_Meta.Closed then
                  Self.F_Lzw_Read_From_Return_Value := 3;
               else
                  Self.F_Lzw_Read_From_Return_Value := 2;
               end if;
               exit G_Loop_1;
            else
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               if V_N_Bits >= V_Width then
                  null;
               elsif Wuffs.Base.IO.Length (G_R_Src) = 0 then
                  if A_Src_Meta.Closed then
                     Self.F_Lzw_Read_From_Return_Value := 3;
                  else
                     Self.F_Lzw_Read_From_Return_Value := 2;
                  end if;
                  exit G_Loop_1;
               else
                  V_Bits :=
                    V_Bits
                      or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                                Natural (V_N_Bits));
                  Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
                  V_N_Bits := V_N_Bits + 8;
                  pragma Warnings ("C");
                  pragma Assert (V_Width <= V_N_Bits);
                  pragma Assert (V_N_Bits >= V_Width);
                  pragma Warnings ("c");
                  if V_N_Bits < V_Width then
                     Self.F_Lzw_Read_From_Return_Value := 5;
                     exit G_Loop_1;
                  end if;
               end if;
            end if;
         end if;
         V_Code := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => V_Width);
         V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Width));
         V_N_Bits := V_N_Bits - V_Width;
         if V_Code < V_Clear_Code then
            pragma Warnings ("C");
            pragma Assert (V_Code < 256);
            pragma Warnings ("c");
            Self.F_Lzw_Output (Wuffs.Index (V_Output_Wi)) := Wuffs.U8 (V_Code);
            V_Output_Wi := V_Output_Wi + 1 and 8191;
            if V_Save_Code <= 4095 then
               V_Lm1_A := Self.F_Lzw_Lm1s (Wuffs.Index (V_Prev_Code)) + 1 and 4095;
               Self.F_Lzw_Lm1s (Wuffs.Index (V_Save_Code)) := V_Lm1_A;
               if V_Lm1_A mod 8 /= 0 then
                  Self.F_Lzw_Prefixes (Wuffs.Index (V_Save_Code)) :=
                    Self.F_Lzw_Prefixes (Wuffs.Index (V_Prev_Code));
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) :=
                    Self.F_Lzw_Suffixes (Wuffs.Index (V_Prev_Code));
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) (Wuffs.Index (V_Lm1_A mod 8)) :=
                    Wuffs.U8 (V_Code);
               else
                  Self.F_Lzw_Prefixes (Wuffs.Index (V_Save_Code)) := Wuffs.U16 (V_Prev_Code);
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) (0) := Wuffs.U8 (V_Code);
               end if;
               V_Save_Code := V_Save_Code + 1;
               if V_Width < 12 then
                  V_Width :=
                    V_Width + (1 and Interfaces.Shift_Right (V_Save_Code, Natural (V_Width)));
               end if;
               V_Prev_Code := V_Code;
            end if;
         elsif V_Code <= V_End_Code then
            if V_Code = V_End_Code then
               Self.F_Lzw_Read_From_Return_Value := 0;
               exit G_Loop_1;
            end if;
            V_Save_Code := V_End_Code;
            V_Prev_Code := V_End_Code;
            V_Width := Self.F_Lzw_Literal_Width + 1;
         elsif V_Code <= V_Save_Code then
            V_C := V_Code;
            if V_Code = V_Save_Code then
               V_C := V_Prev_Code;
            end if;
            V_O :=
              V_Output_Wi + (Wuffs.U32 (Self.F_Lzw_Lm1s (Wuffs.Index (V_C))) and 16#FFFF_FFF8#)
                and 8191;
            V_Output_Wi :=
              V_Output_Wi + 1 + Wuffs.U32 (Self.F_Lzw_Lm1s (Wuffs.Index (V_C))) and 8191;
            V_Steps := Interfaces.Shift_Right (Wuffs.U32 (Self.F_Lzw_Lm1s (Wuffs.Index (V_C))), 3);
            G_Loop_2 :
            loop
               pragma Warnings ("C");
               pragma Assert (V_O <= V_O + 8);
               pragma Warnings ("c");
               Wuffs.Base.Slices.Copy_From_Slice
                 (Dst => Self.F_Lzw_Output (Wuffs.Index (V_O) .. (Wuffs.Index (V_O) + 8) - 1),
                  Src => Self.F_Lzw_Suffixes (Wuffs.Index (V_C)) (0 .. 7),
                  N => G_T1);
               if V_Steps = 0 then
                  exit G_Loop_2;
               end if;
               V_Steps := V_Steps - 1;
               V_O := V_O - 8 and 8191;
               V_C := Wuffs.U32 (Self.F_Lzw_Prefixes (Wuffs.Index (V_C)));
            end loop G_Loop_2;
            V_First_Byte := Self.F_Lzw_Suffixes (Wuffs.Index (V_C)) (0);
            if V_Code = V_Save_Code then
               Self.F_Lzw_Output (Wuffs.Index (V_Output_Wi)) := V_First_Byte;
               V_Output_Wi := V_Output_Wi + 1 and 8191;
            end if;
            if V_Save_Code <= 4095 then
               V_Lm1_B := Self.F_Lzw_Lm1s (Wuffs.Index (V_Prev_Code)) + 1 and 4095;
               Self.F_Lzw_Lm1s (Wuffs.Index (V_Save_Code)) := V_Lm1_B;
               if V_Lm1_B mod 8 /= 0 then
                  Self.F_Lzw_Prefixes (Wuffs.Index (V_Save_Code)) :=
                    Self.F_Lzw_Prefixes (Wuffs.Index (V_Prev_Code));
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) :=
                    Self.F_Lzw_Suffixes (Wuffs.Index (V_Prev_Code));
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) (Wuffs.Index (V_Lm1_B mod 8)) :=
                    V_First_Byte;
               else
                  Self.F_Lzw_Prefixes (Wuffs.Index (V_Save_Code)) := Wuffs.U16 (V_Prev_Code);
                  Self.F_Lzw_Suffixes (Wuffs.Index (V_Save_Code)) (0) := V_First_Byte;
               end if;
               V_Save_Code := V_Save_Code + 1;
               if V_Width < 12 then
                  V_Width :=
                    V_Width + (1 and Interfaces.Shift_Right (V_Save_Code, Natural (V_Width)));
               end if;
               V_Prev_Code := V_Code;
            end if;
         else
            Self.F_Lzw_Read_From_Return_Value := 4;
            exit G_Loop_1;
         end if;
         if V_Output_Wi > 4095 then
            Self.F_Lzw_Read_From_Return_Value := 1;
            exit G_Loop_1;
         end if;
      end loop G_Loop_1;
      if Self.F_Lzw_Read_From_Return_Value /= 2 then
         G_Loop_3 :
         while V_N_Bits >= 8 loop
            V_N_Bits := V_N_Bits - 8;
            if Wuffs.Base.IO.Can_Undo_Byte (G_R_Src) then
               Wuffs.Base.IO.Undo_Byte (G_R_Src);
            else
               Self.F_Lzw_Read_From_Return_Value := 5;
               exit G_Loop_3;
            end if;
         end loop G_Loop_3;
      end if;
      Self.F_Lzw_Save_Code := V_Save_Code;
      Self.F_Lzw_Prev_Code := V_Prev_Code;
      Self.F_Lzw_Width := V_Width;
      Self.F_Lzw_Bits := V_Bits;
      Self.F_Lzw_N_Bits := V_N_Bits;
      Self.F_Lzw_Output_Wi := V_Output_Wi;
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
   end Lzw_Read_From;

end Wuffs.Std.Gif;
