      V_B : Wuffs.U32 := 0;
   begin
      V_Y := 0;
      while V_Y < 16 loop
         V_X := 0;
         while V_X < 16 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 16);
            pragma Warnings ("c");
            V_Yy1 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 0))
                * 16#1_0101#;
            V_Cb1 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 1))
                - 16#80#;
            V_Cr1 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 2))
                - 16#80#;
            V_R := V_Yy1 + 91881 * V_Cr1;
            if (V_R and 16#FF00_0000#) = 0 then
               V_R := Interfaces.Shift_Right (V_R, 16);
            else
               V_R := 16#FFFF_FFFF# xor Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_R, N => 31);
            end if;
            V_G := V_Yy1 - (22554 * V_Cb1 + 46802 * V_Cr1);
            if (V_G and 16#FF00_0000#) = 0 then
               V_G := Interfaces.Shift_Right (V_G, 16);
            else
               V_G := 16#FFFF_FFFF# xor Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_G, N => 31);
            end if;
            V_B := V_Yy1 + 116130 * V_Cb1;
            if (V_B and 16#FF00_0000#) = 0 then
               V_B := Interfaces.Shift_Right (V_B, 16);
            else
               V_B := 16#FFFF_FFFF# xor Wuffs.Base.Ints.Sign_Extend_Rshift_U32 (A => V_B, N => 31);
            end if;
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 0) :=
              Wuffs.U8 (V_B and 16#FF#);
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 1) :=
              Wuffs.U8 (V_G and 16#FF#);
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 2) :=
              Wuffs.U8 (V_R and 16#FF#);
            V_X := V_X + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 16);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
   end Convert_Ycca_To_Bgra;

   procedure Scale_Horizontal (Self : in out Decoder) is
      V_Y : Wuffs.U32 := 0;
      V_Dstx : G_U32_Range_0_15 := 0;
      V_Srcx : Wuffs.U32 := 0;
      V_Acc0 : Wuffs.U32 := 0;
      V_Acc1 : Wuffs.U32 := 0;
      V_Acc2 : Wuffs.U32 := 0;
      V_Acc3 : Wuffs.U32 := 0;
      V_S0 : G_U32_Range_0_255 := 0;
      V_S1 : G_U32_Range_0_255 := 0;
      V_S2 : G_U32_Range_0_255 := 0;
      V_S3 : G_U32_Range_0_255 := 0;
      V_Remainder : G_U32_Range_0_16 := 0;
      V_Partial : G_U32_Range_0_16 := 0;
   begin
      V_Y := 0;
      while V_Y < 16 loop
         V_Dstx := 0;
         V_Srcx := 0;
         V_Acc0 := 0;
         V_Acc1 := 0;
         V_Acc2 := 0;
         V_Acc3 := 0;
         V_Remainder := 16;
         while V_Srcx < 16 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 16);
            pragma Warnings ("c");
            V_S0 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Srcx) + 0));
            V_S1 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Srcx) + 1));
            V_S2 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Srcx) + 2));
            V_S3 :=
              Wuffs.U32 (Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Srcx) + 3));
            if V_Remainder > Self.F_Width then
               V_Remainder := V_Remainder - Self.F_Width;
               V_Acc0 := V_Acc0 + Self.F_Width * V_S0;
               V_Acc1 := V_Acc1 + Self.F_Width * V_S1;
               V_Acc2 := V_Acc2 + Self.F_Width * V_S2;
               V_Acc3 := V_Acc3 + Self.F_Width * V_S3;
            else
               pragma Warnings ("C");
               pragma Assert (Self.F_Width >= V_Remainder);
               pragma Warnings ("c");
               V_Acc0 := V_Acc0 + V_Remainder * V_S0;
               V_Acc1 := V_Acc1 + V_Remainder * V_S1;
               V_Acc2 := V_Acc2 + V_Remainder * V_S2;
               V_Acc3 := V_Acc3 + V_Remainder * V_S3;
               Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Dstx) + 0) :=
                 Wuffs.U8 ((V_Acc0 + 8) / 16 and 16#FF#);
               Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Dstx) + 1) :=
                 Wuffs.U8 ((V_Acc1 + 8) / 16 and 16#FF#);
               Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Dstx) + 2) :=
                 Wuffs.U8 ((V_Acc2 + 8) / 16 and 16#FF#);
               Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_Dstx) + 3) :=
                 Wuffs.U8 ((V_Acc3 + 8) / 16 and 16#FF#);
               V_Dstx := V_Dstx + 1 and 15;
               V_Partial := Self.F_Width - V_Remainder;
               V_Acc0 := V_Partial * V_S0;
               V_Acc1 := V_Partial * V_S1;
               V_Acc2 := V_Partial * V_S2;
               V_Acc3 := V_Partial * V_S3;
               V_Remainder := 16 - V_Partial;
            end if;
            V_Srcx := V_Srcx + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 16);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
   end Scale_Horizontal;

