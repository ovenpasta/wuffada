   procedure Decode_Zigzag_Coeffs (Self : in out Decoder) is
      V_Dcm : Wuffs.U16 range 0 .. 136 := 0;
      V_Dcn : Wuffs.U16 range 0 .. 1024 := 0;
      V_Acm : Wuffs.U16 range 0 .. 64 := 0;
      V_Acn : Wuffs.U16 range 0 .. 512 := 0;
      V_Z : G_U32_Range_0_1 := 0;
      V_Num_Coeffs : G_U32_Range_0_15 := 0;
      V_Bo : Wuffs.U32 := 0;
      V_Nibble : G_U8_Range_0_15 := 0;
      V_I : Wuffs.U32 := 0;
   begin
      V_Dcm := 16#88#;
      V_Dcn := 1024;
      V_Acm := 64;
      V_Acn := 512;
      V_Z := 0;
      if Self.F_Quality /= 0 then
         V_Dcm := 16#44#;
         V_Dcn := 512;
         V_Acm := 32;
         V_Acn := 256;
         V_Z := 1;
      end if;
      V_Num_Coeffs := NUM_COEFFS (Wuffs.Index (Self.F_Quality));
      V_Bo := Wuffs.U32 (Self.F_Bit_Offset);
      V_Nibble :=
        Interfaces.Shift_Right (Self.F_Bits (Wuffs.Index
                                               (Interfaces.Shift_Right (V_Bo, 3) and 255)),
                                Natural (V_Bo and 4))
          and 15;
      Self.F_Coeffs (0) := Wuffs.U16 (V_Nibble) * V_Dcm - V_Dcn;
      V_Bo := V_Bo + 4;
      V_I := 1;
      while V_I < V_Num_Coeffs loop
         pragma Warnings ("C");
         pragma Assert (V_I < 15);
         pragma Warnings ("c");
         V_Nibble :=
           Interfaces.Shift_Right (Self.F_Bits (Wuffs.Index
                                                  (Interfaces.Shift_Right (V_Bo, 3) and 255)),
                                   Natural (V_Bo and 4))
             and 15;
         Self.F_Coeffs (Wuffs.Index (ZIGZAG (Wuffs.Index (V_Z)) (Wuffs.Index (V_I)))) :=
           Wuffs.U16 (V_Nibble) * V_Acm - V_Acn;
         V_Bo := V_Bo + 4;
         V_I := V_I + 1;
      end loop;
      Self.F_Bit_Offset := Wuffs.U16 (V_Bo and 16#FFFF#);
   end Decode_Zigzag_Coeffs;

