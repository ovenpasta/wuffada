   procedure Upsample_Chroma_And_Alpha (Self : in out Decoder) is
      V_Y : Wuffs.U32 := 0;
      V_Dy : Wuffs.U32 := 0;
      V_Y0 : G_U32_Range_0_7 := 0;
      V_Y1 : G_U32_Range_0_7 := 0;
      V_X : Wuffs.U32 := 0;
      V_Dx : Wuffs.U32 := 0;
      V_X0 : G_U32_Range_0_7 := 0;
      V_X1 : G_U32_Range_0_7 := 0;
   begin
      V_Y := 0;
      while V_Y < 16 loop
         V_Dy := (V_Y and 1) * 2 - 1;
         V_Y0 := Interfaces.Shift_Right (V_Y, 1);
         V_Y1 := Wuffs.U32 (CLAMP_7 (Wuffs.Index (V_Y0 + V_Dy and 31)));
         V_X := 0;
         while V_X < 16 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 16);
            pragma Warnings ("c");
            V_Dx := (V_X and 1) * 2 - 1;
            V_X0 := Interfaces.Shift_Right (V_X, 1);
            V_X1 := Wuffs.U32 (CLAMP_7 (Wuffs.Index (V_X0 + V_Dx and 31)));
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 1) :=
              Wuffs.U8 ((Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                      (Wuffs.Index (4 * V_X0) + 1))
                           * 9
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                          (Wuffs.Index (4 * V_X1) + 1))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X0) + 1))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X1) + 1))
                           + 8)
                          / 16);
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 2) :=
              Wuffs.U8 ((Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                      (Wuffs.Index (4 * V_X0) + 2))
                           * 9
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                          (Wuffs.Index (4 * V_X1) + 2))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X0) + 2))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X1) + 2))
                           + 8)
                          / 16);
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 3) :=
              Wuffs.U8 ((Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                      (Wuffs.Index (4 * V_X0) + 3))
                           * 9
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y0))
                                          (Wuffs.Index (4 * V_X1) + 3))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X0) + 3))
                               * 3
                           + Wuffs.U32 (Self.F_Buffers (1) (Wuffs.Index (V_Y1))
                                          (Wuffs.Index (4 * V_X1) + 3))
                           + 8)
                          / 16);
            V_X := V_X + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 16);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
      if Self.F_Color < 3 then
         return;
      end if;
      V_Y := 0;
      while V_Y < 16 loop
         V_X := 0;
         while V_X < 16 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 16);
            pragma Warnings ("c");
            Self.F_Buffers (0) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 3) :=
              CUBE_ROOT (Wuffs.Index (Self.F_Buffers (0) (Wuffs.Index (V_Y))
                                        (Wuffs.Index (4 * V_X) + 3)));
            V_X := V_X + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 16);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
   end Upsample_Chroma_And_Alpha;

