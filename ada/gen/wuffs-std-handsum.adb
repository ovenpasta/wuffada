   procedure Scale_And_Bias_Chroma_Down (Self : in out Decoder) is
      V_Y : Wuffs.U32 := 0;
      V_X : Wuffs.U32 := 0;
   begin
      V_Y := 0;
      while V_Y < 8 loop
         V_X := 0;
         while V_X < 8 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 8);
            pragma Warnings ("c");
            Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 1) :=
              16#3C#
                + Interfaces.Shift_Right (Self.F_Buffers (1) (Wuffs.Index (V_Y))
                                            (Wuffs.Index (4 * V_X) + 1),
                                          1);
            Self.F_Buffers (1) (Wuffs.Index (V_Y)) (Wuffs.Index (4 * V_X) + 2) :=
              16#3C#
                + Interfaces.Shift_Right (Self.F_Buffers (1) (Wuffs.Index (V_Y))
                                            (Wuffs.Index (4 * V_X) + 2),
                                          1);
            V_X := V_X + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 8);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
