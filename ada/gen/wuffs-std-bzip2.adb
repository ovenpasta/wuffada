      Self.F_N_Bits := 8;
      pragma Warnings ("C");
      pragma Assert (Self.F_N_Bits > 0);
      pragma Warnings ("c");
      goto G_Fi_5;
      <<G_Else_6>>
      null;
      <<G_Fi_5>>
      V_Child :=
        Self.F_Huffman_Trees (Wuffs.Index (Self.F_Decode_Huffman_Which))
          (Wuffs.Index (V_Node_Index))
          (Wuffs.Index (Interfaces.Shift_Right (Self.F_Bits, 31)));
      Self.F_Bits := Interfaces.Shift_Left (Self.F_Bits, 1);
      Self.F_N_Bits := Self.F_N_Bits - 1;
      if V_Child < 257 then
         V_Node_Index := Wuffs.U32 (V_Child);
         goto G_Continue_2;
      elsif V_Child < 16#300# then
         V_Child_Ff := Wuffs.U32 (V_Child and 16#FF#);
         V_Output := Wuffs.U32 (Self.F_Mtft (Wuffs.Index (V_Child_Ff)));
         Wuffs.Base.Slices.Copy_Within (Data => Self.F_Mtft,
                                        Dst_First => 1,
                                        Dst_Length => Wuffs.Index (1 + V_Child_Ff) - 1,
                                        Src_First => 0,
                                        Src_Length => Wuffs.Index (V_Child_Ff),
                                        N => G_T2);
         Self.F_Mtft (0) := Wuffs.U8 (V_Output);
         Self.F_Letter_Counts (Wuffs.Index (V_Output)) :=
           Self.F_Letter_Counts (Wuffs.Index (V_Output)) + 1;
         Self.F_Bwt (Wuffs.Index (Self.F_Block_Size)) := V_Output;
         if Self.F_Block_Size >= Self.F_Max_Incl_Block_Size then
            G_Status := Error_Bad_Block_Length;
            goto G_Exit;
         end if;
         pragma Warnings ("C");
         pragma Assert (Self.F_Block_Size < 900000);
         pragma Warnings ("c");
         Self.F_Block_Size := Self.F_Block_Size + 1;
         Self.F_Decode_Huffman_Run_Shift := 0;
         goto G_Done_4;
      elsif V_Child = 16#300# then
         Self.F_Decode_Huffman_Finished := True;
         goto G_Done_2;
      end if;
      if Self.F_Decode_Huffman_Run_Shift = 23 then
         G_Status := Error_Bad_Block_Length;
         goto G_Exit;
      end if;
      V_Run :=
        Interfaces.Shift_Left (Wuffs.U32 (V_Child) and 3,
                               Natural (Self.F_Decode_Huffman_Run_Shift));
      Self.F_Decode_Huffman_Run_Shift := Self.F_Decode_Huffman_Run_Shift + 1;
      V_I := Self.F_Block_Size;
      V_J := V_Run + Self.F_Block_Size;
      if V_J > Self.F_Max_Incl_Block_Size then
         G_Status := Error_Bad_Block_Length;
         goto G_Exit;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_J <= 900000);
      pragma Warnings ("c");
      Self.F_Block_Size := V_J;
      V_Mtft0 := Wuffs.U32 (Self.F_Mtft (0));
      Self.F_Letter_Counts (Wuffs.Index (V_Mtft0)) :=
        Self.F_Letter_Counts (Wuffs.Index (V_Mtft0)) + V_Run;
      while V_I < V_J loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_J <= 900000);
         pragma Assert (V_I < 900000);
         pragma Warnings ("c");
         Self.F_Bwt (Wuffs.Index (V_I)) := V_Mtft0;
         V_I := V_I + 1;
      end loop;
      goto G_Done_4;
      <<G_Continue_2>>
      goto G_Head_3;
      <<G_Done_4>>
      goto G_Head_1;
      <<G_Done_2>>
      Self.G_P_15_Decode_Huffman_Slow := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_15_Decode_Huffman_Slow := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_S_15_Decode_Huffman_Slow_Node_Index := V_Node_Index;
