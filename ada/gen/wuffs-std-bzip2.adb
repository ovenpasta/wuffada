         if (Self.F_Code_Lengths_Bitmask
               and Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_Code_Length)))
              = 0
         then
            V_Code_Length := V_Code_Length + 1;
            goto G_Continue_1;
         end if;
         V_Symbol_Index := 0;
         while V_Symbol_Index < Self.F_Num_Symbols loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Code_Length <= 20);
            pragma Assert (V_Symbol_Index < 258);
            pragma Warnings ("c");
