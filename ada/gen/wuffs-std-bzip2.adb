   function Decode_Huffman_Fast
     (Self : in out Decoder;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Bits : Wuffs.U32 := 0;
      V_N_Bits : G_U32_Range_0_31 := 0;
      V_Block_Size : G_U32_Range_0_900000 := 0;
      V_Which : G_U8_Range_0_5 := 0;
      V_Ticks : G_U32_Range_0_50 := 0;
      V_Section : Wuffs.U32 := 0;
      V_Run_Shift : G_U32_Range_0_23 := 0;
      V_Table_Entry : Wuffs.U16 := 0;
      V_Child : Wuffs.U16 := 0;
      V_Child_Ff : G_U32_Range_0_255 := 0;
      V_I : Wuffs.U32 := 0;
      V_J : Wuffs.U32 range 0 .. 13482912 := 0;
      V_Output : G_U32_Range_0_255 := 0;
      V_Run : G_U32_Range_0_12582912 := 0;
      V_Mtft0 : G_U32_Range_0_255 := 0;
      G_T1 : Wuffs.U64;
      pragma Warnings (Off, G_T1);
   begin
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      V_Bits := Self.F_Bits;
      V_N_Bits := Self.F_N_Bits;
      V_Block_Size := Self.F_Block_Size;
      V_Which := Self.F_Decode_Huffman_Which;
      V_Ticks := Self.F_Decode_Huffman_Ticks;
      V_Section := Self.F_Decode_Huffman_Section;
      V_Run_Shift := Self.F_Decode_Huffman_Run_Shift;
      G_Loop_1_Outer :
      while Wuffs.Base.IO.Length (G_R_Src) >= 4 loop
         if V_Ticks > 0 then
            V_Ticks := V_Ticks - 1;
         else
            V_Ticks := 49;
            V_Section := V_Section + 1;
            if V_Section >= Self.F_Num_Sections then
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Bad_Number_Of_Sections;
            end if;
            V_Which :=
              CLAMP_NO_MORE_THAN_5 (Wuffs.Index
                                      (Self.F_Huffman_Selectors (Wuffs.Index (V_Section and 32767))
                                         and 7));
         end if;
         V_Bits :=
           V_Bits
             or Interfaces.Shift_Right (Wuffs.Base.IO.Peek_U32BE (A_Src, G_R_Src),
                                        Natural (V_N_Bits));
         Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src,
                                      Actual => Interfaces.Shift_Right (31 - V_N_Bits, 3));
         V_N_Bits := V_N_Bits or 24;
         V_Table_Entry :=
           Self.F_Huffman_Tables (Wuffs.Index (V_Which))
             (Wuffs.Index (Interfaces.Shift_Right (V_Bits, 24)));
         V_Bits :=
           Interfaces.Shift_Left (V_Bits, Natural (Interfaces.Shift_Right (V_Table_Entry, 12)));
         V_N_Bits := V_N_Bits - Wuffs.U32 (Interfaces.Shift_Right (V_Table_Entry, 12));
         V_Child := V_Table_Entry and 16#3FF#;
         while V_Child < 257 loop
            V_Child :=
              Self.F_Huffman_Trees (Wuffs.Index (V_Which)) (Wuffs.Index (V_Child))
                (Wuffs.Index (Interfaces.Shift_Right (V_Bits, 31)));
            V_Bits := Interfaces.Shift_Left (V_Bits, 1);
            if V_N_Bits = 0 then
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            end if;
            V_N_Bits := V_N_Bits - 1;
         end loop;
         if V_Child < 16#300# then
            V_Child_Ff := Wuffs.U32 (V_Child and 16#FF#);
            V_Output := Wuffs.U32 (Self.F_Mtft (Wuffs.Index (V_Child_Ff)));
            Wuffs.Base.Slices.Copy_Within (Data => Self.F_Mtft,
                                           Dst_First => 1,
                                           Dst_Length => Wuffs.Index (1 + V_Child_Ff) - 1,
                                           Src_First => 0,
                                           Src_Length => Wuffs.Index (V_Child_Ff),
                                           N => G_T1);
            Self.F_Mtft (0) := Wuffs.U8 (V_Output);
            Self.F_Letter_Counts (Wuffs.Index (V_Output)) :=
              Self.F_Letter_Counts (Wuffs.Index (V_Output)) + 1;
            Self.F_Bwt (Wuffs.Index (V_Block_Size)) := V_Output;
            if V_Block_Size >= Self.F_Max_Incl_Block_Size then
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Bad_Block_Length;
            end if;
            pragma Warnings ("C");
            pragma Assert (V_Block_Size < 900000);
            pragma Warnings ("c");
            V_Block_Size := V_Block_Size + 1;
            V_Run_Shift := 0;
            goto G_Continue_1_Outer;
         elsif V_Child = 16#300# then
            Self.F_Decode_Huffman_Finished := True;
            exit G_Loop_1_Outer;
         end if;
         if V_Run_Shift = 23 then
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Bad_Block_Length;
         end if;
         V_Run := Interfaces.Shift_Left (Wuffs.U32 (V_Child) and 3, Natural (V_Run_Shift));
         V_Run_Shift := V_Run_Shift + 1;
         V_I := V_Block_Size;
         V_J := V_Run + V_Block_Size;
         if V_J > Self.F_Max_Incl_Block_Size then
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Bad_Block_Length;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_J <= 900000);
         pragma Warnings ("c");
         V_Block_Size := V_J;
         V_Mtft0 := Wuffs.U32 (Self.F_Mtft (0));
         Self.F_Letter_Counts (Wuffs.Index (V_Mtft0)) :=
           Self.F_Letter_Counts (Wuffs.Index (V_Mtft0)) + V_Run;
         while V_I < V_J loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_J <= 900000);
            pragma Assert (V_I < 900000);
            pragma Warnings ("c");
            Self.F_Bwt (Wuffs.Index (V_I)) := V_Mtft0;
            V_I := V_I + 1;
         end loop;
         <<G_Continue_1_Outer>>
         null;
      end loop G_Loop_1_Outer;
      Self.F_Bits := V_Bits;
      Self.F_N_Bits := V_N_Bits;
      Self.F_Block_Size := V_Block_Size;
      Self.F_Decode_Huffman_Which := V_Which;
      Self.F_Decode_Huffman_Ticks := V_Ticks;
      Self.F_Decode_Huffman_Section := V_Section;
      Self.F_Decode_Huffman_Run_Shift := V_Run_Shift;
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return Wuffs.Ok_Status;
   end Decode_Huffman_Fast;

   function Decode_Huffman_Slow
     (Self : in out Decoder;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_C8 : Wuffs.U8 := 0;
      V_Node_Index : G_U32_Range_0_256 := 0;
      V_Child : Wuffs.U16 := 0;
      V_Child_Ff : G_U32_Range_0_255 := 0;
      V_I : Wuffs.U32 := 0;
      V_J : Wuffs.U32 := 0;
      V_Output : G_U32_Range_0_255 := 0;
      V_Run : G_U32_Range_0_12582912 := 0;
      V_Mtft0 : G_U32_Range_0_255 := 0;
      G_T1 : Wuffs.U8;
      G_Susp : Wuffs.U32;
      G_T2 : Wuffs.U64;
      pragma Warnings (Off, G_T2);
   begin
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      G_Susp := Self.G_P_15_Decode_Huffman_Slow;
      if G_Susp /= 0 then
         V_Node_Index := Self.G_S_15_Decode_Huffman_Slow_Node_Index;
      end if;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when others =>
            goto G_Suspend;
      end case;
      <<G_Head_1>>
      if Self.G_P_15_Decode_Huffman_Slow /= 0 then
         goto G_Done_2;
      end if;
      if Self.F_Decode_Huffman_Ticks > 0 then
         Self.F_Decode_Huffman_Ticks := Self.F_Decode_Huffman_Ticks - 1;
      else
         Self.F_Decode_Huffman_Ticks := 49;
         Self.F_Decode_Huffman_Section := Self.F_Decode_Huffman_Section + 1;
         if Self.F_Decode_Huffman_Section >= Self.F_Num_Sections then
            G_Status := Error_Bad_Number_Of_Sections;
            goto G_Exit;
         end if;
         Self.F_Decode_Huffman_Which :=
           CLAMP_NO_MORE_THAN_5 (Wuffs.Index (Self.F_Huffman_Selectors
                                                (Wuffs.Index
                                                   (Self.F_Decode_Huffman_Section and 32767))
                                                and 7));
      end if;
      V_Node_Index := 0;
      <<G_Head_3>>
      if Self.F_N_Bits > 0 then
         goto G_Else_6;
      end if;
      G_Susp := 1;
      <<G_Resume_1>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
