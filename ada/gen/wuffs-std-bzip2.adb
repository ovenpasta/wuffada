                  return Error_Bad_Huffman_Code_Over_Subscribed;
               elsif V_Stack_Height >= V_Code_Length then
                  exit G_Loop_3;
               end if;
               pragma Warnings ("C");
               pragma Assert (V_Stack_Height < 20);
               pragma Warnings ("c");
               V_Node_Index := V_Stack_Values (Wuffs.Index (V_Stack_Height - 1));
