      V_Rgb0 :=
        Interfaces.Shift_Left (Wuffs.U32 (V_R (0)), 16#10#)
          or Interfaces.Shift_Left (Wuffs.U32 (V_G (0)), 16#08#)
          or Wuffs.U32 (V_B (0));
      V_Rgb2 :=
        Interfaces.Shift_Left (Wuffs.U32 (V_R (2)), 16#10#)
          or Interfaces.Shift_Left (Wuffs.U32 (V_G (2)), 16#08#)
          or Wuffs.U32 (V_B (2));
      V_Which :=
        Wuffs.U32 (16#04# and Interfaces.Shift_Right (A_Bits, 16#20#))
          or Wuffs.U32 (16#02# and Interfaces.Shift_Right (A_Bits, 16#1F#));
      if V_Rgb0 >= V_Rgb2 then
         V_Which := V_Which or 1;
      end if;
      V_Delta := Wuffs.U32 (T_H_MODIFIERS (Wuffs.Index (V_Which)));
      V_R (1) := CLAMP (Wuffs.Index (Wuffs.U32 (V_R (0)) - V_Delta and 1023));
      V_G (1) := CLAMP (Wuffs.Index (Wuffs.U32 (V_G (0)) - V_Delta and 1023));
      V_B (1) := CLAMP (Wuffs.Index (Wuffs.U32 (V_B (0)) - V_Delta and 1023));
      V_A (1) := 16#FF#;
      V_R (0) := CLAMP (Wuffs.Index (Wuffs.U32 (V_R (0)) + V_Delta and 1023));
      V_G (0) := CLAMP (Wuffs.Index (Wuffs.U32 (V_G (0)) + V_Delta and 1023));
      V_B (0) := CLAMP (Wuffs.Index (Wuffs.U32 (V_B (0)) + V_Delta and 1023));
      V_A (0) := 16#FF#;
      V_R (3) := CLAMP (Wuffs.Index (Wuffs.U32 (V_R (2)) - V_Delta and 1023));
      V_G (3) := CLAMP (Wuffs.Index (Wuffs.U32 (V_G (2)) - V_Delta and 1023));
      V_B (3) := CLAMP (Wuffs.Index (Wuffs.U32 (V_B (2)) - V_Delta and 1023));
      V_A (3) := 16#FF#;
      V_R (2) := CLAMP (Wuffs.Index (Wuffs.U32 (V_R (2)) + V_Delta and 1023));
      V_G (2) := CLAMP (Wuffs.Index (Wuffs.U32 (V_G (2)) + V_Delta and 1023));
      V_B (2) := CLAMP (Wuffs.Index (Wuffs.U32 (V_B (2)) + V_Delta and 1023));
      V_A (2) := 16#FF#;
      if A_Transparent then
         V_R (2) := 0;
         V_G (2) := 0;
         V_B (2) := 0;
         V_A (2) := 0;
      end if;
      while V_Y < 4 loop
         V_X := 0;
         while V_X < 4 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 4);
            pragma Warnings ("c");
            V_X4y := V_X * 4 or V_Y;
            V_Index :=
              Wuffs.U32 (Interfaces.Shift_Right (A_Bits, Natural (V_X4y)) and 1)
                or Wuffs.U32 (Interfaces.Shift_Right (A_Bits, Natural (V_X4y + 15)) and 2);
            V_O := A_Offset + V_X * 4 + V_Y * 1024;
            Self.F_Buffer (Wuffs.Index (V_O + 0)) := V_B (Wuffs.Index (V_Index));
            Self.F_Buffer (Wuffs.Index (V_O + 1)) := V_G (Wuffs.Index (V_Index));
            Self.F_Buffer (Wuffs.Index (V_O + 2)) := V_R (Wuffs.Index (V_Index));
            Self.F_Buffer (Wuffs.Index (V_O + 3)) := V_A (Wuffs.Index (V_Index));
            V_X := V_X + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 4);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
   end Decode_H_Mode;

   procedure Decode_Planar_Mode
     (Self : in out Decoder; A_Bits : Wuffs.U64; A_Offset : G_U32_Range_0_1008)
   is
      V_Ro : Wuffs.U32 := 0;
      V_Go : Wuffs.U32 := 0;
      V_Bo : Wuffs.U32 := 0;
      V_Rh : Wuffs.U32 := 0;
      V_Gh : Wuffs.U32 := 0;
      V_Bh : Wuffs.U32 := 0;
      V_Rv : Wuffs.U32 := 0;
      V_Gv : Wuffs.U32 := 0;
      V_Bv : Wuffs.U32 := 0;
      V_Y : Wuffs.U32 := 0;
      V_X : Wuffs.U32 := 0;
      V_O : G_U32_Range_0_4092 := 0;
      V_Rp : Wuffs.U32 := 0;
      V_Gp : Wuffs.U32 := 0;
      V_Bp : Wuffs.U32 := 0;
   begin
      V_Ro := Wuffs.U32 (16#3F# and Interfaces.Shift_Right (A_Bits, 16#39#));
      V_Ro := Interfaces.Shift_Left (V_Ro, 2) or Interfaces.Shift_Right (V_Ro, 4);
      V_Go :=
        Wuffs.U32 (16#40# and Interfaces.Shift_Right (A_Bits, 16#32#))
          or Wuffs.U32 (16#3F# and Interfaces.Shift_Right (A_Bits, 16#31#));
      V_Go := Interfaces.Shift_Left (V_Go, 1) or Interfaces.Shift_Right (V_Go, 6);
      V_Bo :=
        Wuffs.U32 (16#20# and Interfaces.Shift_Right (A_Bits, 16#2B#))
          or Wuffs.U32 (16#18# and Interfaces.Shift_Right (A_Bits, 16#28#))
          or Wuffs.U32 (16#07# and Interfaces.Shift_Right (A_Bits, 16#27#));
      V_Bo := Interfaces.Shift_Left (V_Bo, 2) or Interfaces.Shift_Right (V_Bo, 4);
      V_Rh :=
        Wuffs.U32 (16#3E# and Interfaces.Shift_Right (A_Bits, 16#21#))
          or Wuffs.U32 (16#01# and Interfaces.Shift_Right (A_Bits, 16#20#));
      V_Rh := Interfaces.Shift_Left (V_Rh, 2) or Interfaces.Shift_Right (V_Rh, 4);
      V_Gh := Wuffs.U32 (16#7F# and Interfaces.Shift_Right (A_Bits, 16#19#));
      V_Gh := Interfaces.Shift_Left (V_Gh, 1) or Interfaces.Shift_Right (V_Gh, 6);
      V_Bh := Wuffs.U32 (16#3F# and Interfaces.Shift_Right (A_Bits, 16#13#));
      V_Bh := Interfaces.Shift_Left (V_Bh, 2) or Interfaces.Shift_Right (V_Bh, 4);
      V_Rv := Wuffs.U32 (16#3F# and Interfaces.Shift_Right (A_Bits, 16#0D#));
      V_Rv := Interfaces.Shift_Left (V_Rv, 2) or Interfaces.Shift_Right (V_Rv, 4);
      V_Gv := Wuffs.U32 (16#7F# and Interfaces.Shift_Right (A_Bits, 16#06#));
      V_Gv := Interfaces.Shift_Left (V_Gv, 1) or Interfaces.Shift_Right (V_Gv, 6);
      V_Bv := Wuffs.U32 (16#3F# and A_Bits);
      V_Bv := Interfaces.Shift_Left (V_Bv, 2) or Interfaces.Shift_Right (V_Bv, 4);
      V_Rh := V_Rh - V_Ro;
      V_Gh := V_Gh - V_Go;
      V_Bh := V_Bh - V_Bo;
      V_Rv := V_Rv - V_Ro;
      V_Gv := V_Gv - V_Go;
      V_Bv := V_Bv - V_Bo;
      V_Ro := V_Ro * 4;
      V_Go := V_Go * 4;
      V_Bo := V_Bo * 4;
      while V_Y < 4 loop
         V_X := 0;
         while V_X < 4 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 4);
            pragma Warnings ("c");
            V_O := A_Offset + V_X * 4 + V_Y * 1024;
            V_Bp := V_X * V_Bh + V_Y * V_Bv + V_Bo;
            Self.F_Buffer (Wuffs.Index (V_O + 0)) := CLAMP (Wuffs.Index ((V_Bp + 2) / 4 and 1023));
            V_Gp := V_X * V_Gh + V_Y * V_Gv + V_Go;
            Self.F_Buffer (Wuffs.Index (V_O + 1)) := CLAMP (Wuffs.Index ((V_Gp + 2) / 4 and 1023));
            V_Rp := V_X * V_Rh + V_Y * V_Rv + V_Ro;
            Self.F_Buffer (Wuffs.Index (V_O + 2)) := CLAMP (Wuffs.Index ((V_Rp + 2) / 4 and 1023));
            V_X := V_X + 1;
            Self.F_Buffer (Wuffs.Index (V_O + 3)) := 16#FF#;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Y < 4);
         pragma Warnings ("c");
         V_Y := V_Y + 1;
      end loop;
   end Decode_Planar_Mode;

   procedure Decode_Half_Block
     (Self : in out Decoder;
      A_Bits : Wuffs.U32;
      A_Offset : G_U32_Range_0_1008;
      A_Which : G_U32_Range_0_7;
      A_R : Wuffs.U32;
      A_G : Wuffs.U32;
      A_B : Wuffs.U32;
      A_Flip : Boolean;
      A_Transparent : Boolean;
      A_Second : Boolean)
   is
      V_Which : G_U32_Range_0_15 := 0;
      V_X0 : G_U32_Range_0_2 := 0;
      V_Y0 : G_U32_Range_0_2 := 0;
      V_X : G_U32_Range_0_3 := 0;
      V_Y : G_U32_Range_0_3 := 0;
      V_I : Wuffs.U32 := 0;
      V_X4y : G_U32_Range_0_15 := 0;
      V_Index : G_U32_Range_0_3 := 0;
      V_Modif : Wuffs.U32 := 0;
      V_O : G_U32_Range_0_4092 := 0;
   begin
      V_Which := A_Which;
      if A_Transparent then
         V_Which := V_Which or 8;
      end if;
      if not A_Second then
         null;
      elsif A_Flip then
         V_Y0 := 2;
      else
         V_X0 := 2;
      end if;
      while V_I < 8 loop
         if A_Flip then
            V_X := V_X0 + V_I / 2 and 3;
            V_Y := V_Y0 + (V_I and 1);
         else
            V_X := V_X0 + V_I / 4;
            V_Y := V_Y0 + V_I and 3;
         end if;
         V_X4y := V_X * 4 or V_Y;
         V_Index :=
           (Interfaces.Shift_Right (A_Bits, Natural (V_X4y)) and 1)
             or (Interfaces.Shift_Right (A_Bits, Natural (V_X4y + 15)) and 2);
         V_Modif := MODIFIERS (Wuffs.Index (V_Which)) (Wuffs.Index (V_Index));
         V_O := A_Offset + V_X * 4 + V_Y * 1024;
         if A_Transparent and then V_Index = 2 then
            Self.F_Buffer (Wuffs.Index (V_O + 0)) := 0;
            Self.F_Buffer (Wuffs.Index (V_O + 1)) := 0;
            Self.F_Buffer (Wuffs.Index (V_O + 2)) := 0;
            Self.F_Buffer (Wuffs.Index (V_O + 3)) := 0;
         else
            Self.F_Buffer (Wuffs.Index (V_O + 0)) := CLAMP (Wuffs.Index (A_B + V_Modif and 1023));
            Self.F_Buffer (Wuffs.Index (V_O + 1)) := CLAMP (Wuffs.Index (A_G + V_Modif and 1023));
            Self.F_Buffer (Wuffs.Index (V_O + 2)) := CLAMP (Wuffs.Index (A_R + V_Modif and 1023));
            Self.F_Buffer (Wuffs.Index (V_O + 3)) := 16#FF#;
         end if;
         V_I := V_I + 1;
      end loop;
   end Decode_Half_Block;

   procedure From_Alphas_To_Buffer (Self : in out Decoder) is
      V_Bi : G_U32_Range_0_64 := 0;
      V_Alpha : Wuffs.U64 := 0;
      V_A0 : Wuffs.U32 range 0 .. 255 := 0;
      V_Multiplier : G_U32_Range_0_15 := 0;
      V_Which : G_U32_Range_0_15 := 0;
      V_Offset : G_U32_Range_0_1008 := 0;
      V_Y : Wuffs.U32 := 0;
      V_X : Wuffs.U32 := 0;
      V_Shift : G_U32_Range_0_45 := 0;
      V_Delta : Wuffs.U32 := 0;
      V_O : G_U32_Range_0_4092 := 0;
   begin
      while V_Bi < Self.F_Num_Buffered_Blocks loop
         pragma Warnings ("C");
         pragma Assert (V_Bi < 64);
         pragma Warnings ("c");
         V_Alpha := Self.F_Colors (0) (Wuffs.Index (V_Bi));
         V_A0 := Wuffs.U32 (Interfaces.Shift_Right (V_Alpha, 56));
         V_Multiplier := Wuffs.U32 (Interfaces.Shift_Right (V_Alpha, 52) and 16#0F#);
         V_Which := Wuffs.U32 (Interfaces.Shift_Right (V_Alpha, 48) and 16#0F#);
         V_Offset := 16 * V_Bi;
         V_Y := 0;
         while V_Y < 4 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Bi < 64);
            pragma Warnings ("c");
            V_X := 0;
            while V_X < 4 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_Bi < 64);
               pragma Loop_Invariant (V_Y < 4);
               pragma Warnings ("c");
               V_Shift := ((V_X xor 3) * 4 or (V_Y xor 3)) * 3;
               V_Delta :=
                 V_Multiplier
                   * ALPHA_MODIFIERS (Wuffs.Index (V_Which))
                       (Wuffs.Index (7 and Interfaces.Shift_Right (V_Alpha, Natural (V_Shift))));
               V_O := V_Offset + V_X * 4 + V_Y * 1024;
               Self.F_Buffer (Wuffs.Index (V_O + 3)) :=
                 CLAMP (Wuffs.Index (V_A0 + V_Delta and 1023));
               V_X := V_X + 1;
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_Bi < 64);
            pragma Assert (V_Y < 4);
            pragma Warnings ("c");
            V_Y := V_Y + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Bi < 64);
         pragma Warnings ("c");
         V_Bi := V_Bi + 1;
      end loop;
   end From_Alphas_To_Buffer;

