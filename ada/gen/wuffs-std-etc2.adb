      V_C0 : Wuffs.U32 range 0 .. 2044 := 0;
      V_Multiplier : G_U32_Range_0_120 := 0;
      V_Which : G_U32_Range_0_15 := 0;
      V_Offset : G_U32_Range_0_996 := 0;
      V_Y : Wuffs.U32 := 0;
      V_X : Wuffs.U32 := 0;
      V_Shift : G_U32_Range_0_45 := 0;
      V_Delta : Wuffs.U32 := 0;
      V_C11 : Wuffs.U32 := 0;
