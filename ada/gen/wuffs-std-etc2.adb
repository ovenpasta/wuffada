      V_R (2) := Interfaces.Shift_Left (V_R (2), 4) or V_R (2);
      V_G (2) := Wuffs.U8 (16#0F# and Interfaces.Shift_Right (A_Bits, 16#27#));
      V_G (2) := Interfaces.Shift_Left (V_G (2), 4) or V_G (2);
      V_B (2) := Wuffs.U8 (16#0F# and Interfaces.Shift_Right (A_Bits, 16#23#));
