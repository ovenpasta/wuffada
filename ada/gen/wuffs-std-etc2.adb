      V_O : G_U32_Range_0_4092 := 0;
   begin
      V_Nbb := Wuffs.Base.Ints.Min_U32 (X => Self.F_Num_Buffered_Blocks, Y => 32);
      while V_Bi < V_Nbb loop
         pragma Warnings ("C");
         pragma Assert (V_Bi < 32);
         pragma Warnings ("c");
         V_Color := Self.F_Colors (Wuffs.Index (A_Input)) (Wuffs.Index (V_Bi));
         V_C0 := Wuffs.U32 (Interfaces.Shift_Right (V_Color, 56)) * 8 + 4;
         V_Multiplier := Wuffs.U32 (Interfaces.Shift_Right (V_Color, 52) and 16#0F#);
         V_Multiplier := V_Multiplier * 8;
         if V_Multiplier = 0 then
            V_Multiplier := 1;
         end if;
         V_Which := Wuffs.U32 (Interfaces.Shift_Right (V_Color, 48) and 16#0F#);
         V_Offset := 4 * A_Dst_Bytes_Per_Pixel * V_Bi + A_Offset_Adjustment;
         V_Y := 0;
         while V_Y < 4 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Bi < 32);
            pragma Warnings ("c");
            V_X := 0;
            while V_X < 4 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_Bi < 32);
               pragma Loop_Invariant (V_Y < 4);
               pragma Warnings ("c");
               V_Shift := ((V_X xor 3) * 4 or (V_Y xor 3)) * 3;
               V_Delta :=
                 V_Multiplier
