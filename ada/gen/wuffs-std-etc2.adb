               V_C11 := V_C0 + V_Delta;
               if V_C11 >= 16#8000_0000# then
                  V_C11 := 0;
                  pragma Warnings ("C");
                  pragma Assert (V_C11 <= 2047);
                  pragma Warnings ("c");
               elsif V_C11 > 2047 then
                  V_C11 := 2047;
                  pragma Warnings ("C");
                  pragma Assert (V_C11 <= 2047);
                  pragma Warnings ("c");
               end if;
               V_C16 := Interfaces.Shift_Left (V_C11, 5) or Interfaces.Shift_Right (V_C11, 6);
               V_O := V_Offset + V_X * A_Dst_Bytes_Per_Pixel + V_Y * 1024;
               Self.F_Buffer (Wuffs.Index (V_O + 0)) := Wuffs.U8 (V_C16 and 16#FF#);
               Self.F_Buffer (Wuffs.Index (V_O + 1)) :=
                 Wuffs.U8 (Interfaces.Shift_Right (V_C16, 8) and 16#FF#);
               V_X := V_X + 1;
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_Bi < 32);
            pragma Assert (V_Y < 4);
            pragma Warnings ("c");
            V_Y := V_Y + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Bi < 32);
         pragma Warnings ("c");
         V_Bi := V_Bi + 1;
