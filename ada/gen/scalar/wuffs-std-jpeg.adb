   function Calculate_Huff_Tables
     (Self : in out Decoder;
      A_Tc4_Th : G_U8_Range_0_7;
      A_Total_Count : G_U32_Range_0_256)
      return Boolean
   is
      V_I : Wuffs.U32 := 0;
      V_J : Wuffs.U8 := 0;
      V_K : Wuffs.U8 := 0;
      V_Bit_Length_Minus_One : G_U32_Range_0_15 := 0;
      V_Bit_Length : G_U8_Range_0_16 := 0;
      V_Bit_String : Wuffs.U32 := 0;
      V_Slow : Wuffs.U32 range 0 .. 255 := 0;
      V_Prefix : Wuffs.U8 := 0;
      V_Fast : Wuffs.U16 range 0 .. 2303 := 0;
      V_Reps : Wuffs.U32 := 0;
   begin
      V_I := 0;
      V_K := 0;
      V_Bit_Length_Minus_One := 0;
      while V_I < A_Total_Count loop
         pragma Warnings ("C");
         pragma Assert (V_I < 256);
         pragma Warnings ("c");
         while V_K >= Self.F_Dht_Temp_Counts (Wuffs.Index (V_Bit_Length_Minus_One)) loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_I < 256);
            pragma Warnings ("c");
            V_K := 0;
            V_Bit_Length_Minus_One := V_Bit_Length_Minus_One + 1 and 15;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_I < 256);
         pragma Assert (V_K < Self.F_Dht_Temp_Counts (Wuffs.Index (V_Bit_Length_Minus_One)));
         pragma Assert (V_K < 255);
         pragma Warnings ("c");
         V_K := V_K + 1;
         Self.F_Dht_Temp_Bit_Lengths (Wuffs.Index (V_I)) := Wuffs.U8 (V_Bit_Length_Minus_One + 1);
         V_I := V_I + 1;
      end loop;
      V_Bit_Length := 0;
      V_Bit_String := 0;
      V_I := 0;
      while V_I < A_Total_Count loop
         pragma Warnings ("C");
         pragma Assert (V_I < 256);
         pragma Warnings ("c");
         while V_Bit_Length < Self.F_Dht_Temp_Bit_Lengths (Wuffs.Index (V_I)) loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_I < 256);
            pragma Warnings ("c");
            if V_Bit_Length = 16 then
               return True;
            end if;
            V_Bit_Length := V_Bit_Length + 1;
            V_Bit_String := Interfaces.Shift_Left (V_Bit_String, 1);
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_I < 256);
         pragma Warnings ("c");
         Self.F_Dht_Temp_Bit_Strings (Wuffs.Index (V_I)) := Wuffs.U16 (V_Bit_String and 16#FFFF#);
         V_Bit_String := V_Bit_String + 1;
         if Interfaces.Shift_Right (V_Bit_String, Natural (V_Bit_Length)) > 0 then
            return True;
         end if;
         V_I := V_I + 1;
      end loop;
      V_K := 0;
      V_Bit_Length_Minus_One := 0;
      G_Loop_5 :
      loop
         if Self.F_Dht_Temp_Counts (Wuffs.Index (V_Bit_Length_Minus_One)) = 0 then
            Self.F_Huff_Tables_Slow (Wuffs.Index (A_Tc4_Th))
              (Wuffs.Index (V_Bit_Length_Minus_One)) :=
              0;
         else
            V_Slow :=
              16#FF#
                and Wuffs.U32 (V_K) - Wuffs.U32 (Self.F_Dht_Temp_Bit_Strings (Wuffs.Index (V_K)));
            V_K := V_K + Self.F_Dht_Temp_Counts (Wuffs.Index (V_Bit_Length_Minus_One));
            Self.F_Huff_Tables_Slow (Wuffs.Index (A_Tc4_Th))
              (Wuffs.Index (V_Bit_Length_Minus_One)) :=
              V_Slow
                or Interfaces.Shift_Left (Wuffs.U32
                                            (Self.F_Dht_Temp_Bit_Strings (Wuffs.Index (V_K - 1)))
                                            + 1,
                                          8);
         end if;
         V_Bit_Length_Minus_One := V_Bit_Length_Minus_One + 1 and 15;
         if V_Bit_Length_Minus_One = 0 then
            exit G_Loop_5;
         end if;
      end loop G_Loop_5;
      V_I := 0;
      while V_I < 256 loop
         Self.F_Huff_Tables_Fast (Wuffs.Index (A_Tc4_Th)) (Wuffs.Index (V_I)) := 16#FFFF#;
         V_I := V_I + 1;
      end loop;
      V_J := 0;
      V_Bit_Length_Minus_One := 0;
      while V_Bit_Length_Minus_One < 8 loop
         V_K := 0;
         while V_K < Self.F_Dht_Temp_Counts (Wuffs.Index (V_Bit_Length_Minus_One)) loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Bit_Length_Minus_One < 8);
            pragma Assert (V_K < 255);
            pragma Warnings ("c");
            V_Prefix :=
              Wuffs.U8 (Interfaces.Shift_Left (Wuffs.U32
                                                 (Self.F_Dht_Temp_Bit_Strings (Wuffs.Index (V_J))),
                                               Natural (7 - V_Bit_Length_Minus_One))
                          and 16#FF#);
            V_Fast :=
              Wuffs.U16 (Interfaces.Shift_Left (V_Bit_Length_Minus_One + 1, 8)
                           or Wuffs.U32 (Self.F_Huff_Tables_Symbols (Wuffs.Index (A_Tc4_Th))
                                           (Wuffs.Index (V_J))));
            V_Reps := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (7 - V_Bit_Length_Minus_One));
            while V_Reps > 0 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_Bit_Length_Minus_One < 8);
               pragma Loop_Invariant (V_K < 255);
               pragma Warnings ("c");
               Self.F_Huff_Tables_Fast (Wuffs.Index (A_Tc4_Th)) (Wuffs.Index (V_Prefix)) := V_Fast;
               V_Prefix := V_Prefix + 1;
               V_Reps := V_Reps - 1;
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_Bit_Length_Minus_One < 8);
            pragma Assert (V_K < 255);
            pragma Warnings ("c");
            V_K := V_K + 1;
            V_J := V_J + 1;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Bit_Length_Minus_One < 8);
         pragma Warnings ("c");
         V_Bit_Length_Minus_One := V_Bit_Length_Minus_One + 1;
      end loop;
      return False;
   end Calculate_Huff_Tables;

