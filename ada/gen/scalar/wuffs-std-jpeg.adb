      end if;
      V_Tc := Interfaces.Shift_Right (V_C8, 4);
      V_Th := V_C8 and 16#0F#;
      V_Tc4_Th := V_Tc * 4 or V_Th;
      if Self.F_Sof_Marker = 16#C0# and then (V_Tc4_Th and 3) > 1 then
         G_Status := Error_Bad_DHT_Marker;
         goto G_Exit;
      end if;
      V_I := 0;
      <<G_Head_3>>
      if V_I >= 16 then
         goto G_Done_4;
      end if;
      G_Susp := 2;
      <<G_Resume_2>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T2);
      Self.F_Dht_Temp_Counts (Wuffs.Index (V_I)) := G_T2;
      V_I := V_I + 1;
      goto G_Head_3;
      <<G_Done_4>>
      V_Working_Total_Count := 0;
      V_I := 0;
      while V_I < 16 loop
         V_Working_Total_Count :=
