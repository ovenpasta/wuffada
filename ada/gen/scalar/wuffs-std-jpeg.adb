         pragma Warnings ("C");
         pragma Assert (V_B < 10);
         pragma Warnings ("c");
         V_Ssel := Self.F_Mcu_Blocks_Sselector (Wuffs.Index (V_B));
         V_Csel := Self.F_Scan_Comps_Cselector (Wuffs.Index (V_Ssel));
         Self.F_Mcu_Blocks_Offset (Wuffs.Index (V_B)) :=
           Self.F_Components_Workbuf_Offsets (Wuffs.Index (V_Csel))
             + 8 * Wuffs.U64 (Self.F_Scan_Comps_Bx_Offset (Wuffs.Index (V_B)))
             + 8
                 * Wuffs.U64 (Self.F_Scan_Comps_By_Offset (Wuffs.Index (V_B)))
                 * Wuffs.U64 (Self.F_Components_Workbuf_Widths (Wuffs.Index (V_Csel)));
         Self.F_Mcu_Blocks_Mx_Mul (Wuffs.Index (V_B)) :=
           8 * Wuffs.U32 (Self.F_Components_H (Wuffs.Index (V_Csel)));
         Self.F_Mcu_Blocks_My_Mul (Wuffs.Index (V_B)) :=
           8
             * Wuffs.U32 (Self.F_Components_V (Wuffs.Index (V_Csel)))
             * Self.F_Components_Workbuf_Widths (Wuffs.Index (V_Csel));
         Self.F_Mcu_Blocks_Dc_Hselector (Wuffs.Index (V_B)) :=
           0 or Self.F_Scan_Comps_Td (Wuffs.Index (V_Ssel));
         Self.F_Mcu_Blocks_Ac_Hselector (Wuffs.Index (V_B)) :=
           4 or Self.F_Scan_Comps_Ta (Wuffs.Index (V_Ssel));
         V_Sibo :=
           Self.F_Swizzle_Immediately_C_Offsets (Wuffs.Index (V_Csel))
             + 8 * Wuffs.U32 (Self.F_Scan_Comps_Bx_Offset (Wuffs.Index (V_B)))
             + 64
                 * Wuffs.U32 (Self.F_Scan_Comps_By_Offset (Wuffs.Index (V_B)))
                 * Wuffs.U32 (Self.F_Components_H (Wuffs.Index (V_Csel)));
         Self.F_Swizzle_Immediately_B_Offsets (Wuffs.Index (V_B)) :=
