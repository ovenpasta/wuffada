      pragma Assert (V_I < 4);
      pragma Warnings ("c");
      V_J := 0;
      while V_J < V_I loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_I < 4);
         pragma Assert (V_J < 4);
