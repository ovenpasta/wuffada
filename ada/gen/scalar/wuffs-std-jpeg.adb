   function Calculate_Multiple_Component_Scan_Fields (Self : in out Decoder) return Boolean is
      V_I : Wuffs.U32 := 0;
      V_H : G_U32_Range_0_4 := 0;
      V_V : G_U32_Range_0_4 := 0;
      V_Hv : G_U32_Range_0_16 := 0;
