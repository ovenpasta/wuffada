            goto G_Resume_2;
         when 3 =>
            goto G_Resume_3;
         when 4 =>
            goto G_Resume_4;
         when 5 =>
            goto G_Resume_5;
         when 6 =>
            goto G_Resume_6;
         when 7 =>
            goto G_Resume_7;
         when 8 =>
            goto G_Resume_8;
         when 9 =>
            goto G_Resume_9;
         when others =>
            goto G_Suspend;
      end case;
      if Self.F_Payload_Length < 6 or else Self.F_Payload_Length > 12 then
         G_Status := Error_Bad_SOS_Marker;
         goto G_Exit;
      end if;
      G_Susp := 1;
      <<G_Resume_1>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T1);
      V_C8 := G_T1;
      if V_C8 < 1 or else V_C8 > 4 then
         G_Status := Error_Bad_SOS_Marker;
         goto G_Exit;
      end if;
      Self.F_Scan_Num_Components := Wuffs.U32 (V_C8);
      if Self.F_Scan_Num_Components > Self.F_Num_Components
           or else Self.F_Payload_Length /= 4 + 2 * Self.F_Scan_Num_Components
      then
         G_Status := Error_Bad_SOS_Marker;
         goto G_Exit;
      end if;
      Self.F_Payload_Length := 0;
      V_I := 0;
      <<G_Head_1>>
      if V_I >= Self.F_Scan_Num_Components then
         goto G_Done_2;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_I < 4);
      pragma Warnings ("c");
      G_Susp := 2;
      <<G_Resume_2>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T2);
      V_C8 := G_T2;
      V_J := 0;
      G_Loop_2 :
      loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_I < 4);
         pragma Warnings ("c");
         if V_J >= Self.F_Num_Components then
            G_Status := Error_Bad_SOS_Marker;
            goto G_Exit;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_J < 4);
         pragma Warnings ("c");
         if V_C8 = Self.F_Components_C (Wuffs.Index (V_J)) then
            if not Self.F_Seen_Dqt (Wuffs.Index (Self.F_Components_Tq (Wuffs.Index (V_J)))) then
