             and 16#FFFF#;
         V_I := V_I + 1;
      end loop;
      if V_Working_Total_Count = 0 or else 256 < V_Working_Total_Count then
         G_Status := Error_Bad_DHT_Marker;
         goto G_Exit;
      end if;
