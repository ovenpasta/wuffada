      V_Sibo : Wuffs.U32 := 0;
      V_Ssel : G_U8_Range_0_3 := 0;
      V_Csel : G_U8_Range_0_3 := 0;
   begin
      V_Total_Hv := 0;
      V_I := 0;
      V_B := 0;
      V_Bx_Offset := 0;
      V_By_Offset := 0;
      while V_I < Self.F_Scan_Num_Components loop
         pragma Warnings ("C");
         pragma Assert (V_I < 4);
         pragma Warnings ("c");
         V_H :=
           Wuffs.U32 (Self.F_Components_H (Wuffs.Index
                                             (Self.F_Scan_Comps_Cselector (Wuffs.Index (V_I)))));
         V_V :=
           Wuffs.U32 (Self.F_Components_V (Wuffs.Index
                                             (Self.F_Scan_Comps_Cselector (Wuffs.Index (V_I)))));
         V_Hv :=
           Wuffs.U32 (Self.F_Components_H (Wuffs.Index
                                             (Self.F_Scan_Comps_Cselector (Wuffs.Index (V_I)))))
             * Wuffs.U32 (Self.F_Components_V (Wuffs.Index
                                                 (Self.F_Scan_Comps_Cselector
                                                    (Wuffs.Index (V_I)))));
         Self.F_Swizzle_Immediately_C_Offsets (Wuffs.Index (V_I)) := 64 * V_Total_Hv;
         V_Total_Hv := V_Total_Hv + V_Hv;
         while V_Hv > 0 loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_I < 4);
            pragma Warnings ("c");
            Self.F_Scan_Comps_Bx_Offset (Wuffs.Index (V_B and 15)) := Wuffs.U8 (V_Bx_Offset and 3);
            Self.F_Scan_Comps_By_Offset (Wuffs.Index (V_B and 15)) := Wuffs.U8 (V_By_Offset and 3);
            Self.F_Mcu_Blocks_Sselector (Wuffs.Index (V_B and 15)) := Wuffs.U8 (V_I);
            V_B := V_B + 1;
            V_Bx_Offset := V_Bx_Offset + 1;
