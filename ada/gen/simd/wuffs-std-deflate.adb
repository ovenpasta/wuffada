           or else not Wuffs.Runtime.Valid_Buffer (A_Dst, A_Dst_Meta)
           or else not Wuffs.Runtime.Valid_Buffer (A_Src, A_Src_Meta)
      then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
         return Wuffs.Base.Error_Bad_Argument;
      end if;
      if Self.G_Active_Coroutine /= 0 and then Self.G_Active_Coroutine /= 1 then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
         return Wuffs.Base.Error_Interleaved_Coroutine_Calls;
      end if;
      Self.G_Active_Coroutine := 0;
      G_Susp := Self.G_P_6_Transform_Io;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when others =>
            goto G_Suspend;
      end case;
      <<G_Head_1>>
      V_Status :=
        Do_Transform_Io (Self,
                         A_Dst => A_Dst,
                         A_Dst_Meta => A_Dst_Meta,
                         A_Src => A_Src,
                         A_Src_Meta => A_Src_Meta,
                         A_Workbuf => A_Workbuf);
      if V_Status = Wuffs.Base.Suspension_Short_Read and then A_Src_Meta.Closed then
         G_Status := Error_Truncated_Input;
         goto G_Exit;
      end if;
      G_Status := V_Status;
      if Wuffs.Is_Ok (G_Status) then
         goto G_Ok;
      elsif not Wuffs.Is_Suspension (G_Status) then
         goto G_Exit;
      end if;
      G_Susp := 1;
      goto G_Suspend;
      <<G_Resume_1>>
      goto G_Head_1;
      <<G_Ok>>
      Self.G_P_6_Transform_Io := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_6_Transform_Io := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_Active_Coroutine := (if Wuffs.Is_Suspension (G_Status) then 1 else 0);
      <<G_Exit>>
      if Wuffs.Is_Error (G_Status) then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
      end if;
      return G_Status;
   end Transform_Io;

   function Do_Transform_Io
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Workbuf : in out Wuffs.Bytes)
      return Wuffs.Status
   is
      pragma Unreferenced (A_Workbuf);
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_W_Dst : Wuffs.Base.IO.Writer;
      V_Mark : Wuffs.U64 := 0;
      V_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_T1 : Wuffs.Runtime.Slice_U8;
      G_Susp : Wuffs.U32;
   begin
      G_W_Dst := Wuffs.Base.IO.To_Writer (M => A_Dst_Meta, Data_Length => A_Dst'Length);
      G_Susp := Self.G_P_7_Do_Transform_Io;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when others =>
            goto G_Suspend;
      end case;
      if Wuffs.Runtime.CPU.Have_X86_BMI2 then
         Self.G_Choosy_Decode_Huffman_Fast64 := 1;
      end if;
      <<G_Head_1>>
      V_Mark := Wuffs.Base.IO.Mark (G_W_Dst);
      Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
      V_Status :=
        Decode_Blocks (Self,
                       A_Dst => A_Dst,
                       A_Dst_Meta => A_Dst_Meta,
                       A_Src => A_Src,
                       A_Src_Meta => A_Src_Meta);
      Wuffs.Base.IO.Reload (G_W_Dst, A_Dst_Meta);
      if not Wuffs.Is_Suspension (V_Status) then
         G_Status := V_Status;
         if Wuffs.Is_Error (G_Status) then
            goto G_Exit;
         elsif Wuffs.Is_Suspension (G_Status) then
            G_Status := Wuffs.Base.Error_Cannot_Return_A_Suspension;
            goto G_Exit;
         end if;
         goto G_Ok;
      end if;
      Self.F_Transformed_History_Count :=
        Wuffs.Base.Ints.Sat_Add_U64 (X => Self.F_Transformed_History_Count,
                                     Y => Wuffs.Base.IO.Count_Since (W => G_W_Dst, Mark => V_Mark));
      G_T1 :=
        Wuffs.Runtime.Subslice_IJ (S => (Base => A_Dst'Unrestricted_Access,
                                         First => A_Dst'First,
                                         Length => A_Dst'Length),
                                   I => Wuffs.Base.IO.Since_Offset (W => G_W_Dst, Mark => V_Mark),
                                   J => Wuffs.Base.IO.Since_Offset (W => G_W_Dst, Mark => V_Mark)
                                          + Wuffs.Base.IO.Since_Length
                                              (W => G_W_Dst,
                                               Mark => V_Mark));
      Add_History (Self, G_T1.Base (G_T1.First .. Wuffs.Runtime.Last (G_T1)));
      G_Status := V_Status;
      if Wuffs.Is_Ok (G_Status) then
         goto G_Ok;
      elsif not Wuffs.Is_Suspension (G_Status) then
         goto G_Exit;
      end if;
      G_Susp := 1;
      goto G_Suspend;
      <<G_Resume_1>>
      goto G_Head_1;
      <<G_Ok>>
      Self.G_P_7_Do_Transform_Io := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_7_Do_Transform_Io := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
      return G_Status;
   end Do_Transform_Io;

   function Decode_Blocks
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Final : Wuffs.U32 := 0;
      V_B0 : G_U32_Range_0_255 := 0;
      V_Type : Wuffs.U32 := 0;
      V_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_T1 : Wuffs.U8;
      G_Susp : Wuffs.U32;
   begin
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      G_Susp := Self.G_P_8_Decode_Blocks;
      if G_Susp /= 0 then
         V_Final := Self.G_S_8_Decode_Blocks_Final;
      end if;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when 2 =>
            goto G_Resume_2;
         when 3 =>
            goto G_Resume_3;
         when 4 =>
            goto G_Resume_4;
         when others =>
            goto G_Suspend;
      end case;
      <<G_Head_1>>
      if V_Final /= 0 then
         goto G_Done_2;
      end if;
      <<G_Head_3>>
      if Self.F_N_Bits >= 3 then
         goto G_Done_4;
      end if;
      G_Susp := 1;
      <<G_Resume_1>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T1);
      V_B0 := Wuffs.U32 (G_T1);
      Self.F_Bits := Self.F_Bits or Interfaces.Shift_Left (V_B0, Natural (Self.F_N_Bits and 3));
      Self.F_N_Bits := (Self.F_N_Bits and 3) + 8;
      goto G_Head_3;
      <<G_Done_4>>
      null;
      pragma Warnings ("C");
      pragma Assert (Self.F_N_Bits >= 3);
      pragma Warnings ("c");
      V_Final := Self.F_Bits and 16#01#;
      V_Type := Interfaces.Shift_Right (Self.F_Bits, 1) and 16#03#;
      Self.F_Bits := Interfaces.Shift_Right (Self.F_Bits, 3);
      Self.F_N_Bits := Self.F_N_Bits - 3;
      if V_Type /= 0 then
         goto G_Else_6;
      end if;
      G_Susp := 2;
      <<G_Resume_2>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      G_Status :=
        Decode_Uncompressed (Self,
                             A_Dst => A_Dst,
                             A_Dst_Meta => A_Dst_Meta,
                             A_Src => A_Src,
                             A_Src_Meta => A_Src_Meta);
      Wuffs.Base.IO.Reload (G_R_Src, A_Src_Meta);
      if not Wuffs.Is_Ok (G_Status) then
         goto G_Suspend;
      end if;
      goto G_Continue_1_Outer;
      <<G_Else_6>>
      if V_Type /= 1 then
         goto G_Else_7;
      end if;
      V_Status := Init_Fixed_Huffman (Self);
      if not Wuffs.Is_Ok (V_Status) then
         G_Status := V_Status;
         if Wuffs.Is_Error (G_Status) then
            goto G_Exit;
         elsif Wuffs.Is_Suspension (G_Status) then
            G_Status := Wuffs.Base.Error_Cannot_Return_A_Suspension;
            goto G_Exit;
         end if;
         goto G_Ok;
      end if;
      goto G_Fi_5;
      <<G_Else_7>>
      if V_Type /= 2 then
         goto G_Else_8;
      end if;
      G_Susp := 3;
      <<G_Resume_3>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      G_Status := Init_Dynamic_Huffman (Self, A_Src => A_Src, A_Src_Meta => A_Src_Meta);
      Wuffs.Base.IO.Reload (G_R_Src, A_Src_Meta);
      if not Wuffs.Is_Ok (G_Status) then
         goto G_Suspend;
      end if;
      goto G_Fi_5;
      <<G_Else_8>>
      G_Status := Error_Bad_Block;
      goto G_Exit;
      <<G_Fi_5>>
      Self.F_End_Of_Block := False;
      <<G_Head_9>>
      if Wuffs.Runtime.Target.CPU_Arch_Is_32_Bit then
         Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
         V_Status :=
           Decode_Huffman_Fast32 (Self,
                                  A_Dst => A_Dst,
                                  A_Dst_Meta => A_Dst_Meta,
                                  A_Src => A_Src,
                                  A_Src_Meta => A_Src_Meta);
         Wuffs.Base.IO.Reload (G_R_Src, A_Src_Meta);
      else
         Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
         V_Status :=
           Decode_Huffman_Fast64 (Self,
                                  A_Dst => A_Dst,
                                  A_Dst_Meta => A_Dst_Meta,
                                  A_Src => A_Src,
                                  A_Src_Meta => A_Src_Meta);
         Wuffs.Base.IO.Reload (G_R_Src, A_Src_Meta);
      end if;
      if Wuffs.Is_Error (V_Status) then
         G_Status := V_Status;
         goto G_Exit;
      end if;
      if Self.F_End_Of_Block then
         goto G_Continue_1_Outer;
      end if;
      G_Susp := 4;
      <<G_Resume_4>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      G_Status :=
        Decode_Huffman_Slow (Self,
                             A_Dst => A_Dst,
                             A_Dst_Meta => A_Dst_Meta,
                             A_Src => A_Src,
                             A_Src_Meta => A_Src_Meta);
      Wuffs.Base.IO.Reload (G_R_Src, A_Src_Meta);
      if not Wuffs.Is_Ok (G_Status) then
         goto G_Suspend;
      end if;
      if Self.F_End_Of_Block then
         goto G_Continue_1_Outer;
      end if;
      goto G_Head_9;
      <<G_Continue_1_Outer>>
      goto G_Head_1;
      <<G_Done_2>>
      null;
      <<G_Ok>>
      Self.G_P_8_Decode_Blocks := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_8_Decode_Blocks := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_S_8_Decode_Blocks_Final := V_Final;
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return G_Status;
   end Decode_Blocks;

   function Decode_Uncompressed
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_W_Dst : Wuffs.Base.IO.Writer;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Length : Wuffs.U32 := 0;
      V_N_Copied : Wuffs.U32 := 0;
      G_T1 : Wuffs.U32;
      G_T2 : Boolean;
      G_T3 : Wuffs.U64;
      G_Susp : Wuffs.U32;
      G_T4 : Wuffs.U32;
      G_T5 : Wuffs.Base.IO.Reader;
      G_T6 : Wuffs.Base.IO.Writer;
   begin
      G_W_Dst := Wuffs.Base.IO.To_Writer (M => A_Dst_Meta, Data_Length => A_Dst'Length);
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      G_Susp := Self.G_P_9_Decode_Uncompressed;
      if G_Susp /= 0 then
         V_Length := Self.G_S_9_Decode_Uncompressed_Length;
      end if;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when 2 =>
            goto G_Resume_2;
         when 3 =>
            goto G_Resume_3;
         when others =>
            goto G_Suspend;
      end case;
      if Self.F_N_Bits >= 8
           or else Interfaces.Shift_Right (Self.F_Bits, Natural (Self.F_N_Bits and 7)) /= 0
      then
         G_Status := Error_Internal_Error_Inconsistent_N_Bits;
         goto G_Exit;
      end if;
      Self.F_N_Bits := 0;
      Self.F_Bits := 0;
      if Wuffs.Base.IO.Length (G_R_Src) < 4 then
         goto G_Else_2;
      end if;
      G_T1 := Wuffs.Base.IO.Peek_U32LE (A_Src, G_R_Src);
      Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 4);
      goto G_Fi_1;
      <<G_Else_2>>
      Self.G_Scratch_9_Decode_Uncompressed := 0;
      G_Susp := 1;
      <<G_Resume_1>>
      loop
         if Wuffs.Base.IO.Length (G_R_Src) = 0 then
            G_Status := Wuffs.Base.Suspension_Short_Read;
            goto G_Suspend;
         end if;
         G_T5 := G_R_Src;
         Wuffs.Base.IO.Read_Step_LE (Data => A_Src,
                                     R => G_T5,
                                     Scratch => Self.G_Scratch_9_Decode_Uncompressed,
                                     Last_Shift => 24,
                                     Done => G_T2,
                                     Value => G_T3);
         G_R_Src := G_T5;
         exit when G_T2;
      end loop;
      G_T1 := Wuffs.U32 (G_T3);
      <<G_Fi_1>>
      V_Length := G_T1;
      if Wuffs.Base.Ints.Low_Bits_U32 (X => V_Length, N => 16)
           + Wuffs.Base.Ints.High_Bits_U32 (X => V_Length, N => 16)
           /= 16#FFFF#
      then
         G_Status := Error_Inconsistent_Stored_Block_Length;
         goto G_Exit;
      end if;
      V_Length := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Length, N => 16);
      <<G_Head_3>>
      G_T6 := G_W_Dst;
      G_T5 := G_R_Src;
      Wuffs.Runtime.Writer_Limited_Copy_U32_From_Reader
        (Data => A_Dst,
         W => G_T6,
         Up_To => V_Length,
         Src_Data => A_Src,
         R => G_T5,
         N => G_T4);
      G_W_Dst := G_T6;
      G_R_Src := G_T5;
      V_N_Copied := G_T4;
      if V_Length <= V_N_Copied then
         G_Status := Wuffs.Ok_Status;
         goto G_Ok;
      end if;
      V_Length := V_Length - V_N_Copied;
      if Wuffs.Base.IO.Length (G_W_Dst) /= 0 then
         goto G_Else_6;
      end if;
      G_Status := Wuffs.Base.Suspension_Short_Write;
      G_Susp := 2;
      goto G_Suspend;
      <<G_Resume_2>>
      goto G_Fi_5;
      <<G_Else_6>>
      G_Status := Wuffs.Base.Suspension_Short_Read;
      G_Susp := 3;
      goto G_Suspend;
      <<G_Resume_3>>
      null;
      <<G_Fi_5>>
      goto G_Head_3;
      <<G_Ok>>
      Self.G_P_9_Decode_Uncompressed := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_9_Decode_Uncompressed := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_S_9_Decode_Uncompressed_Length := V_Length;
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return G_Status;
   end Decode_Uncompressed;

   function Init_Fixed_Huffman (Self : in out Decoder) return Wuffs.Status is
      V_I : Wuffs.U32 := 0;
      V_Status : Wuffs.Status := Wuffs.Ok_Status;
   begin
      while V_I < 144 loop
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := 8;
         V_I := V_I + 1;
      end loop;
      while V_I < 256 loop
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := 9;
         V_I := V_I + 1;
      end loop;
      while V_I < 280 loop
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := 7;
         V_I := V_I + 1;
      end loop;
      while V_I < 288 loop
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := 8;
         V_I := V_I + 1;
      end loop;
      while V_I < 320 loop
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := 5;
         V_I := V_I + 1;
      end loop;
      V_Status :=
        Init_Huff (Self, A_Which => 0, A_N_Codes0 => 0, A_N_Codes1 => 288, A_Base_Symbol => 257);
      if Wuffs.Is_Error (V_Status) then
         return Wuffs.Base.Ensure_Not_A_Suspension (V_Status);
      end if;
      V_Status :=
        Init_Huff (Self, A_Which => 1, A_N_Codes0 => 288, A_N_Codes1 => 320, A_Base_Symbol => 0);
      if Wuffs.Is_Error (V_Status) then
         return Wuffs.Base.Ensure_Not_A_Suspension (V_Status);
      end if;
      return Wuffs.Ok_Status;
   end Init_Fixed_Huffman;

   function Init_Dynamic_Huffman
     (Self : in out Decoder;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Bits : Wuffs.U32 := 0;
      V_N_Bits : Wuffs.U32 := 0;
      V_B0 : G_U32_Range_0_255 := 0;
      V_N_Lit : G_U32_Range_0_288 := 0;
      V_N_Dist : G_U32_Range_0_32 := 0;
      V_N_Clen : G_U32_Range_0_19 := 0;
      V_I : Wuffs.U32 := 0;
      V_B1 : G_U32_Range_0_255 := 0;
      V_Status : Wuffs.Status := Wuffs.Ok_Status;
      V_Mask : G_U32_Range_0_511 := 0;
      V_Table_Entry : Wuffs.U32 := 0;
      V_Table_Entry_N_Bits : G_U32_Range_0_15 := 0;
      V_B2 : G_U32_Range_0_255 := 0;
      V_N_Extra_Bits : G_U32_Range_0_7 := 0;
      V_Rep_Symbol : G_U8_Range_0_15 := 0;
      V_Rep_Count : Wuffs.U32 := 0;
      V_B3 : G_U32_Range_0_255 := 0;
      G_T1 : Wuffs.U8;
      G_Susp : Wuffs.U32;
      G_T2 : Wuffs.U8;
      G_T3 : Wuffs.U8;
      G_T4 : Wuffs.U8;
   begin
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      G_Susp := Self.G_P_11_Init_Dynamic_Huffman;
      if G_Susp /= 0 then
         V_Bits := Self.G_S_11_Init_Dynamic_Huffman_Bits;
         V_N_Bits := Self.G_S_11_Init_Dynamic_Huffman_N_Bits;
         V_N_Lit := Self.G_S_11_Init_Dynamic_Huffman_N_Lit;
         V_N_Dist := Self.G_S_11_Init_Dynamic_Huffman_N_Dist;
         V_N_Clen := Self.G_S_11_Init_Dynamic_Huffman_N_Clen;
         V_I := Self.G_S_11_Init_Dynamic_Huffman_I;
         V_Mask := Self.G_S_11_Init_Dynamic_Huffman_Mask;
         V_N_Extra_Bits := Self.G_S_11_Init_Dynamic_Huffman_N_Extra_Bits;
         V_Rep_Symbol := Self.G_S_11_Init_Dynamic_Huffman_Rep_Symbol;
         V_Rep_Count := Self.G_S_11_Init_Dynamic_Huffman_Rep_Count;
      end if;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when 2 =>
            goto G_Resume_2;
         when 3 =>
            goto G_Resume_3;
         when 4 =>
            goto G_Resume_4;
         when others =>
            goto G_Suspend;
      end case;
      V_Bits := Self.F_Bits;
      V_N_Bits := Self.F_N_Bits;
      <<G_Head_1>>
      if V_N_Bits >= 14 then
         goto G_Done_2;
      end if;
      G_Susp := 1;
      <<G_Resume_1>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T1);
      V_B0 := Wuffs.U32 (G_T1);
      V_Bits := V_Bits or Interfaces.Shift_Left (V_B0, Natural (V_N_Bits));
      V_N_Bits := V_N_Bits + 8;
      goto G_Head_1;
      <<G_Done_2>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_N_Bits >= 14);
      pragma Warnings ("c");
      V_N_Lit := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => 5) + 257;
      if V_N_Lit > 286 then
         G_Status := Error_Bad_Literal_Length_Code_Count;
         goto G_Exit;
      end if;
      V_Bits := Interfaces.Shift_Right (V_Bits, 5);
      V_N_Dist := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => 5) + 1;
      if V_N_Dist > 30 then
         G_Status := Error_Bad_Distance_Code_Count;
         goto G_Exit;
      end if;
      V_Bits := Interfaces.Shift_Right (V_Bits, 5);
      V_N_Clen := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => 4) + 4;
      V_Bits := Interfaces.Shift_Right (V_Bits, 4);
      V_N_Bits := V_N_Bits - 14;
      V_I := 0;
      <<G_Head_3>>
      if V_I >= V_N_Clen then
         goto G_Done_4;
      end if;
      <<G_Head_5>>
      if V_N_Bits >= 3 then
         goto G_Done_6;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_I < V_N_Clen);
      pragma Warnings ("c");
      G_Susp := 2;
      <<G_Resume_2>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T2);
      V_B1 := Wuffs.U32 (G_T2);
      V_Bits := V_Bits or Interfaces.Shift_Left (V_B1, Natural (V_N_Bits));
      V_N_Bits := V_N_Bits + 8;
      goto G_Head_5;
      <<G_Done_6>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_I < V_N_Clen);
      pragma Assert (V_N_Bits >= 3);
      pragma Assert (V_I < 19);
      pragma Warnings ("c");
      Self.F_Code_Lengths (Wuffs.Index (CODE_ORDER (Wuffs.Index (V_I)))) :=
        Wuffs.U8 (V_Bits and 16#07#);
      V_Bits := Interfaces.Shift_Right (V_Bits, 3);
      V_N_Bits := V_N_Bits - 3;
      V_I := V_I + 1;
      goto G_Head_3;
      <<G_Done_4>>
      while V_I < 19 loop
         Self.F_Code_Lengths (Wuffs.Index (CODE_ORDER (Wuffs.Index (V_I)))) := 0;
         V_I := V_I + 1;
      end loop;
      V_Status :=
        Init_Huff (Self, A_Which => 0, A_N_Codes0 => 0, A_N_Codes1 => 19, A_Base_Symbol => 16#FFF#);
      if Wuffs.Is_Error (V_Status) then
         G_Status := V_Status;
         goto G_Exit;
      end if;
      V_Mask := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (Self.F_N_Huffs_Bits (0))) - 1;
      V_I := 0;
      <<G_Head_7>>
      if V_I >= V_N_Lit + V_N_Dist then
         goto G_Done_8;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_I < 320);
      pragma Warnings ("c");
      <<G_Head_9>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_I < 320);
      pragma Warnings ("c");
      V_Table_Entry := Self.F_Huffs (0) (Wuffs.Index (V_Bits and V_Mask));
      V_Table_Entry_N_Bits := V_Table_Entry and 15;
      if V_N_Bits >= V_Table_Entry_N_Bits then
         V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
         V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         goto G_Done_10;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_N_Bits < 15);
      pragma Warnings ("c");
      G_Susp := 3;
      <<G_Resume_3>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T3);
      V_B2 := Wuffs.U32 (G_T3);
      V_Bits := V_Bits or Interfaces.Shift_Left (V_B2, Natural (V_N_Bits));
      V_N_Bits := V_N_Bits + 8;
      goto G_Head_9;
      <<G_Done_10>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_I < 320);
      pragma Warnings ("c");
      if Interfaces.Shift_Right (V_Table_Entry, 24) /= 16#80# then
         G_Status := Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         goto G_Exit;
      end if;
      V_Table_Entry := Interfaces.Shift_Right (V_Table_Entry, 8) and 16#FF#;
      if V_Table_Entry < 16 then
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := Wuffs.U8 (V_Table_Entry);
         V_I := V_I + 1;
         goto G_Continue_5;
      end if;
      V_N_Extra_Bits := 0;
      V_Rep_Symbol := 0;
      V_Rep_Count := 0;
      if V_Table_Entry = 16 then
         V_N_Extra_Bits := 2;
         if V_I = 0 then
            G_Status := Error_Bad_Huffman_Code_Length_Repetition;
            goto G_Exit;
         end if;
         V_Rep_Symbol := Self.F_Code_Lengths (Wuffs.Index (V_I) - 1) and 15;
         V_Rep_Count := 3;
         pragma Warnings ("C");
         pragma Assert (V_Rep_Count <= 11);
         pragma Warnings ("c");
      elsif V_Table_Entry = 17 then
         V_N_Extra_Bits := 3;
         V_Rep_Symbol := 0;
         V_Rep_Count := 3;
         pragma Warnings ("C");
         pragma Assert (V_Rep_Count <= 11);
         pragma Warnings ("c");
      elsif V_Table_Entry = 18 then
         V_N_Extra_Bits := 7;
         V_Rep_Symbol := 0;
         V_Rep_Count := 11;
         pragma Warnings ("C");
         pragma Assert (V_Rep_Count <= 11);
         pragma Warnings ("c");
      else
         G_Status := Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         goto G_Exit;
      end if;
      <<G_Head_11>>
      if V_N_Bits >= V_N_Extra_Bits then
         goto G_Done_12;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_I < 320);
      pragma Assert (V_Rep_Count <= 11);
      pragma Assert (V_N_Bits < 7);
      pragma Warnings ("c");
      G_Susp := 4;
      <<G_Resume_4>>
      if Wuffs.Base.IO.Length (G_R_Src) = 0 then
         G_Status := Wuffs.Base.Suspension_Short_Read;
         goto G_Suspend;
      end if;
      Wuffs.Base.IO.Read_U8 (Data => A_Src, R => G_R_Src, V => G_T4);
      V_B3 := Wuffs.U32 (G_T4);
      V_Bits := V_Bits or Interfaces.Shift_Left (V_B3, Natural (V_N_Bits));
      V_N_Bits := V_N_Bits + 8;
      goto G_Head_11;
      <<G_Done_12>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_I < 320);
      pragma Assert (V_Rep_Count <= 11);
      pragma Assert (V_N_Bits >= V_N_Extra_Bits);
      pragma Warnings ("c");
      V_Rep_Count := V_Rep_Count + Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => V_N_Extra_Bits);
      V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_N_Extra_Bits));
      V_N_Bits := V_N_Bits - V_N_Extra_Bits;
      while V_Rep_Count > 0 loop
         if V_I >= V_N_Lit + V_N_Dist then
            G_Status := Error_Bad_Huffman_Code_Length_Count;
            goto G_Exit;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_I < 320);
         pragma Warnings ("c");
         Self.F_Code_Lengths (Wuffs.Index (V_I)) := V_Rep_Symbol;
         V_I := V_I + 1;
         V_Rep_Count := V_Rep_Count - 1;
      end loop;
      <<G_Continue_5>>
      goto G_Head_7;
      <<G_Done_8>>
      if V_I /= V_N_Lit + V_N_Dist then
         G_Status := Error_Bad_Huffman_Code_Length_Count;
         goto G_Exit;
      end if;
      if Self.F_Code_Lengths (256) = 0 then
         G_Status := Error_Missing_End_Of_Block_Code;
         goto G_Exit;
      end if;
      V_Status :=
        Init_Huff (Self,
                   A_Which => 0,
                   A_N_Codes0 => 0,
                   A_N_Codes1 => V_N_Lit,
                   A_Base_Symbol => 257);
      if Wuffs.Is_Error (V_Status) then
         G_Status := V_Status;
         goto G_Exit;
      end if;
      V_Status :=
        Init_Huff (Self,
                   A_Which => 1,
                   A_N_Codes0 => V_N_Lit,
                   A_N_Codes1 => V_N_Lit + V_N_Dist,
                   A_Base_Symbol => 0);
      if Wuffs.Is_Error (V_Status) then
         G_Status := V_Status;
         goto G_Exit;
      end if;
      Self.F_Bits := V_Bits;
      Self.F_N_Bits := V_N_Bits;
      Self.G_P_11_Init_Dynamic_Huffman := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_11_Init_Dynamic_Huffman := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      Self.G_S_11_Init_Dynamic_Huffman_Bits := V_Bits;
      Self.G_S_11_Init_Dynamic_Huffman_N_Bits := V_N_Bits;
      Self.G_S_11_Init_Dynamic_Huffman_N_Lit := V_N_Lit;
      Self.G_S_11_Init_Dynamic_Huffman_N_Dist := V_N_Dist;
      Self.G_S_11_Init_Dynamic_Huffman_N_Clen := V_N_Clen;
      Self.G_S_11_Init_Dynamic_Huffman_I := V_I;
      Self.G_S_11_Init_Dynamic_Huffman_Mask := V_Mask;
      Self.G_S_11_Init_Dynamic_Huffman_N_Extra_Bits := V_N_Extra_Bits;
      Self.G_S_11_Init_Dynamic_Huffman_Rep_Symbol := V_Rep_Symbol;
      Self.G_S_11_Init_Dynamic_Huffman_Rep_Count := V_Rep_Count;
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return G_Status;
   end Init_Dynamic_Huffman;

   function Init_Huff
     (Self : in out Decoder;
      A_Which : G_U32_Range_0_1;
      A_N_Codes0 : G_U32_Range_0_288;
      A_N_Codes1 : G_U32_Range_0_320;
      A_Base_Symbol : Wuffs.U32)
      return Wuffs.Status
   is
      V_Counts : Wuffs.U16_Array (0 .. 15) := [others => 0];
      V_I : Wuffs.U32 := 0;
      V_Remaining : Wuffs.U32 := 0;
      V_Offsets : Wuffs.U16_Array (0 .. 15) := [others => 0];
      V_N_Symbols : G_U32_Range_0_320 := 0;
      V_Count : G_U32_Range_0_320 := 0;
      V_Symbols : Wuffs.U16_Array (0 .. 319) := [others => 0];
      V_Min_Cl : G_U32_Range_0_9 := 0;
      V_Max_Cl : G_U32_Range_0_15 := 0;
      V_Initial_High_Bits : Wuffs.U32 range 0 .. 512 := 0;
      V_Prev_Cl : G_U32_Range_0_15 := 0;
      V_Prev_Redirect_Key : Wuffs.U32 := 0;
      V_Top : G_U32_Range_0_1024 := 0;
      V_Next_Top : G_U32_Range_0_1024 := 0;
      V_Code : Wuffs.U32 := 0;
      V_Key : Wuffs.U32 range 0 .. 32767 := 0;
      V_Value : Wuffs.U32 := 0;
      V_Cl : G_U32_Range_0_15 := 0;
      V_Redirect_Key : G_U32_Range_0_511 := 0;
      V_J : G_U32_Range_0_16 := 0;
      V_Reversed_Key : G_U32_Range_0_511 := 0;
      V_Symbol : G_U32_Range_0_319 := 0;
      V_High_Bits : Wuffs.U32 := 0;
      V_Delta : Wuffs.U32 range 0 .. 512 := 0;
   begin
      V_I := A_N_Codes0;
      while V_I < A_N_Codes1 loop
         pragma Warnings ("C");
         pragma Assert (V_I < 320);
         pragma Warnings ("c");
         if V_Counts (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) >= 320 then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Counts (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) :=
           V_Counts (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) + 1;
         V_I := V_I + 1;
      end loop;
      if Wuffs.U32 (V_Counts (0)) + A_N_Codes0 = A_N_Codes1 then
         if V_Counts (0) = 1 and then A_Which = 1 then
            Self.F_N_Huffs_Bits (1) := 0;
            Self.F_Huffs (1) (0) := DCODE_MAGIC_NUMBERS (31) or 1;
            return Wuffs.Ok_Status;
         end if;
         return Error_No_Huffman_Codes;
      end if;
      V_Remaining := 1;
      V_I := 1;
      while V_I <= 15 loop
         if V_Remaining > 16#4000_0000# then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Remaining := Interfaces.Shift_Left (V_Remaining, 1);
         if V_Remaining < Wuffs.U32 (V_Counts (Wuffs.Index (V_I))) then
            return Error_Bad_Huffman_Code_Over_Subscribed;
         end if;
         V_Remaining := V_Remaining - Wuffs.U32 (V_Counts (Wuffs.Index (V_I)));
         V_I := V_I + 1;
      end loop;
      if V_Remaining /= 0 then
         if A_Which = 1
              and then V_Counts (1) = 1
              and then Wuffs.U32 (V_Counts (0)) + A_N_Codes0 + 1 = A_N_Codes1
         then
            V_I := 0;
            while V_I <= 29 loop
               if Self.F_Code_Lengths (Wuffs.Index (A_N_Codes0) + Wuffs.Index (V_I)) = 1 then
                  Self.F_N_Huffs_Bits (1) := 1;
                  Self.F_Huffs (1) (0) := DCODE_MAGIC_NUMBERS (Wuffs.Index (V_I)) or 1;
                  Self.F_Huffs (1) (1) := DCODE_MAGIC_NUMBERS (31) or 1;
                  return Wuffs.Ok_Status;
               end if;
               V_I := V_I + 1;
            end loop;
         end if;
         return Error_Bad_Huffman_Code_Under_Subscribed;
      end if;
      V_I := 1;
      while V_I <= 15 loop
         V_Offsets (Wuffs.Index (V_I)) := Wuffs.U16 (V_N_Symbols);
         V_Count := Wuffs.U32 (V_Counts (Wuffs.Index (V_I)));
         if V_N_Symbols > 320 - V_Count then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_N_Symbols + V_Count <= 320);
         pragma Warnings ("c");
         V_N_Symbols := V_N_Symbols + V_Count;
         V_I := V_I + 1;
      end loop;
      if V_N_Symbols > 288 then
         return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
      end if;
      V_I := A_N_Codes0;
      while V_I < A_N_Codes1 loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_N_Symbols <= 288);
         pragma Assert (V_I < 320);
         pragma Warnings ("c");
         if V_I < A_N_Codes0 then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         if Self.F_Code_Lengths (Wuffs.Index (V_I)) /= 0 then
            if V_Offsets (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) >= 320 then
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            end if;
            V_Symbols (Wuffs.Index (V_Offsets (Wuffs.Index
                                                 (Self.F_Code_Lengths (Wuffs.Index (V_I))
                                                    and 15)))) :=
              Wuffs.U16 (V_I - A_N_Codes0);
            V_Offsets (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) :=
              V_Offsets (Wuffs.Index (Self.F_Code_Lengths (Wuffs.Index (V_I)) and 15)) + 1;
         end if;
         V_I := V_I + 1;
      end loop;
      pragma Warnings ("C");
      pragma Assert (V_N_Symbols <= 288);
      pragma Warnings ("c");
      V_Min_Cl := 1;
      G_Loop_6 :
      loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_N_Symbols <= 288);
         pragma Warnings ("c");
         if V_Counts (Wuffs.Index (V_Min_Cl)) /= 0 then
            exit G_Loop_6;
         end if;
         if V_Min_Cl = 9 then
            return Error_Bad_Huffman_Minimum_Code_Length;
         end if;
         V_Min_Cl := V_Min_Cl + 1;
      end loop G_Loop_6;
      pragma Warnings ("C");
      pragma Assert (V_N_Symbols <= 288);
      pragma Warnings ("c");
      V_Max_Cl := 15;
      G_Loop_7 :
      loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_N_Symbols <= 288);
         pragma Warnings ("c");
         if V_Counts (Wuffs.Index (V_Max_Cl)) /= 0 then
            exit G_Loop_7;
         end if;
         if V_Max_Cl <= 1 then
            return Error_No_Huffman_Codes;
         end if;
         V_Max_Cl := V_Max_Cl - 1;
      end loop G_Loop_7;
      pragma Warnings ("C");
      pragma Assert (V_N_Symbols <= 288);
      pragma Warnings ("c");
      if V_Max_Cl <= 9 then
         Self.F_N_Huffs_Bits (Wuffs.Index (A_Which)) := V_Max_Cl;
      else
         Self.F_N_Huffs_Bits (Wuffs.Index (A_Which)) := 9;
      end if;
      V_I := 0;
      if V_N_Symbols /= Wuffs.U32 (V_Offsets (Wuffs.Index (V_Max_Cl)))
           or else V_N_Symbols /= Wuffs.U32 (V_Offsets (15))
      then
         return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
      end if;
      if A_N_Codes0 + Wuffs.U32 (V_Symbols (0)) >= 320 then
         return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
      end if;
      V_Initial_High_Bits := 512;
      if V_Max_Cl < 9 then
         V_Initial_High_Bits := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_Max_Cl));
      end if;
      V_Prev_Cl :=
        Wuffs.U32 (Self.F_Code_Lengths (Wuffs.Index (A_N_Codes0)
                                          + Wuffs.Index (Wuffs.U32 (V_Symbols (0))))
                     and 15);
      V_Prev_Redirect_Key := 16#FFFF_FFFF#;
      V_Top := 0;
      V_Next_Top := 512;
      V_Code := 0;
      V_Key := 0;
      V_Value := 0;
      G_Loop_8 :
      loop
         pragma Warnings ("C");
         pragma Loop_Invariant (V_Code < 32768);
         pragma Loop_Invariant (V_I < 288);
         pragma Loop_Invariant (V_N_Symbols <= 288);
         pragma Warnings ("c");
         if A_N_Codes0 + Wuffs.U32 (V_Symbols (Wuffs.Index (V_I))) >= 320 then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Cl :=
           Wuffs.U32 (Self.F_Code_Lengths (Wuffs.Index (A_N_Codes0)
                                             + Wuffs.Index
                                                 (Wuffs.U32 (V_Symbols (Wuffs.Index (V_I)))))
                        and 15);
         if V_Cl > V_Prev_Cl then
            V_Code := Interfaces.Shift_Left (V_Code, Natural (V_Cl - V_Prev_Cl));
            if V_Code >= 32768 then
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            end if;
         end if;
         V_Prev_Cl := V_Cl;
         V_Key := V_Code;
         if V_Cl > 9 then
            V_Cl := V_Cl - 9;
            pragma Warnings ("C");
            pragma Assert (V_Cl <= 9);
            pragma Warnings ("c");
            V_Redirect_Key := Interfaces.Shift_Right (V_Key, Natural (V_Cl)) and 511;
            V_Key := Wuffs.Base.Ints.Low_Bits_U32 (X => V_Key, N => V_Cl);
            if V_Prev_Redirect_Key /= V_Redirect_Key then
               V_Prev_Redirect_Key := V_Redirect_Key;
               V_Remaining := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_Cl));
               V_J := V_Prev_Cl;
               G_Loop_9 :
               while V_J <= 15 loop
                  pragma Warnings ("C");
                  pragma Loop_Invariant (V_Cl <= 9);
                  pragma Loop_Invariant (V_Code < 32768);
                  pragma Loop_Invariant (V_I < 288);
                  pragma Loop_Invariant (V_N_Symbols <= 288);
                  pragma Warnings ("c");
                  if V_Remaining <= Wuffs.U32 (V_Counts (Wuffs.Index (V_J))) then
                     exit G_Loop_9;
                  end if;
                  V_Remaining := V_Remaining - Wuffs.U32 (V_Counts (Wuffs.Index (V_J)));
                  if V_Remaining > 16#4000_0000# then
                     return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
                  end if;
                  V_Remaining := Interfaces.Shift_Left (V_Remaining, 1);
                  V_J := V_J + 1;
               end loop G_Loop_9;
               pragma Warnings ("C");
               pragma Assert (V_Cl <= 9);
               pragma Assert (V_Code < 32768);
               pragma Assert (V_I < 288);
               pragma Assert (V_N_Symbols <= 288);
               pragma Warnings ("c");
               if V_J <= 9 or else 15 < V_J then
                  return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
               end if;
               V_J := V_J - 9;
               V_Initial_High_Bits := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_J));
               V_Top := V_Next_Top;
               if V_Top + Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_J)) > HUFFS_TABLE_SIZE
               then
                  return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
               end if;
               pragma Warnings ("C");
               pragma Assert (V_Top + Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_J)) <= 1024);
               pragma Warnings ("c");
               V_Next_Top := V_Top + Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_J));
               V_Redirect_Key :=
                 Wuffs.U32 (REVERSE8 (Wuffs.Index (Interfaces.Shift_Right (V_Redirect_Key, 1))))
                   or Interfaces.Shift_Left (V_Redirect_Key and 1, 8);
               Self.F_Huffs (Wuffs.Index (A_Which)) (Wuffs.Index (V_Redirect_Key)) :=
                 16#1000_0009#
                   or Interfaces.Shift_Left (V_Top, 8)
                   or Interfaces.Shift_Left (V_J, 4);
            end if;
         end if;
         if V_Key >= 512 or else V_Counts (Wuffs.Index (V_Prev_Cl)) = 0 then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Counts (Wuffs.Index (V_Prev_Cl)) := V_Counts (Wuffs.Index (V_Prev_Cl)) - 1;
         V_Reversed_Key :=
           Wuffs.U32 (REVERSE8 (Wuffs.Index (Interfaces.Shift_Right (V_Key, 1))))
             or Interfaces.Shift_Left (V_Key and 1, 8);
         V_Reversed_Key := Interfaces.Shift_Right (V_Reversed_Key, Natural (9 - V_Cl));
         V_Symbol := Wuffs.U32 (V_Symbols (Wuffs.Index (V_I)));
         if V_Symbol = 256 then
            V_Value := 16#2000_0000# or V_Cl;
         elsif V_Symbol < 256 and then A_Which = 0 then
            V_Value := 16#8000_0000# or Interfaces.Shift_Left (V_Symbol, 8) or V_Cl;
         elsif V_Symbol >= A_Base_Symbol then
            V_Symbol := V_Symbol - A_Base_Symbol;
            if A_Which = 0 then
               V_Value := LCODE_MAGIC_NUMBERS (Wuffs.Index (V_Symbol and 31)) or V_Cl;
            else
               V_Value := DCODE_MAGIC_NUMBERS (Wuffs.Index (V_Symbol and 31)) or V_Cl;
            end if;
         else
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_High_Bits := V_Initial_High_Bits;
         V_Delta := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_Cl));
         while V_High_Bits >= V_Delta loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Code < 32768);
            pragma Loop_Invariant (V_I < 288);
            pragma Loop_Invariant (V_N_Symbols <= 288);
            pragma Warnings ("c");
            V_High_Bits := V_High_Bits - V_Delta;
            if V_Top + ((V_High_Bits or V_Reversed_Key) and 511) >= HUFFS_TABLE_SIZE then
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            end if;
            pragma Warnings ("C");
            pragma Assert (V_Top + ((V_High_Bits or V_Reversed_Key) and 511) < 1024);
            pragma Warnings ("c");
            Self.F_Huffs (Wuffs.Index (A_Which))
              (Wuffs.Index (V_Top) + Wuffs.Index ((V_High_Bits or V_Reversed_Key) and 511)) :=
              V_Value;
         end loop;
         pragma Warnings ("C");
         pragma Assert (V_Code < 32768);
         pragma Assert (V_I < 288);
         pragma Assert (V_N_Symbols <= 288);
         pragma Warnings ("c");
         V_I := V_I + 1;
         if V_I >= V_N_Symbols then
            exit G_Loop_8;
         end if;
         pragma Warnings ("C");
         pragma Assert (V_I < 288);
         pragma Warnings ("c");
         V_Code := V_Code + 1;
         if V_Code >= 32768 then
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
      end loop G_Loop_8;
      pragma Warnings ("C");
      pragma Assert (V_N_Symbols <= 288);
      pragma Warnings ("c");
      return Wuffs.Ok_Status;
   end Init_Huff;

   function Decode_Huffman_Fast32
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_W_Dst : Wuffs.Base.IO.Writer;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Bits : Wuffs.U32 := 0;
      V_N_Bits : Wuffs.U32 := 0;
      V_Table_Entry : Wuffs.U32 := 0;
      V_Table_Entry_N_Bits : G_U32_Range_0_15 := 0;
      V_Lmask : G_U32_Range_0_511 := 0;
      V_Dmask : G_U32_Range_0_511 := 0;
      V_Redir_Top : G_U32_Range_0_65535 := 0;
      V_Redir_Mask : G_U32_Range_0_32767 := 0;
      V_Length : G_U32_Range_0_258 := 0;
      V_Dist_Minus_1 : G_U32_Range_0_32767 := 0;
      V_Hlen : G_U32_Range_0_32767 := 0;
      V_Hdist : Wuffs.U32 := 0;
      V_Hdist_Adjustment : Wuffs.U32 := 0;
      G_T1 : Wuffs.U32;
      pragma Warnings (Off, G_T1);
      G_T2 : Wuffs.U32;
      pragma Warnings (Off, G_T2);
      G_T3 : Wuffs.U32;
      pragma Warnings (Off, G_T3);
      G_T4 : Wuffs.Base.IO.Writer;
   begin
      G_W_Dst := Wuffs.Base.IO.To_Writer (M => A_Dst_Meta, Data_Length => A_Dst'Length);
      G_R_Src := Wuffs.Base.IO.To_Reader (A_Src_Meta);
      if Self.F_N_Bits >= 8
           or else Interfaces.Shift_Right (Self.F_Bits, Natural (Self.F_N_Bits and 7)) /= 0
      then
         Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
         Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
         return Error_Internal_Error_Inconsistent_N_Bits;
      end if;
      V_Bits := Self.F_Bits;
      V_N_Bits := Self.F_N_Bits;
      V_Lmask := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (Self.F_N_Huffs_Bits (0))) - 1;
      V_Dmask := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (Self.F_N_Huffs_Bits (1))) - 1;
      if Self.F_Transformed_History_Count < Wuffs.Base.IO.History_Position (G_W_Dst) then
         Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
         Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
         return Wuffs.Base.Error_Bad_IO_Position;
      end if;
      V_Hdist_Adjustment :=
        Wuffs.U32 (Self.F_Transformed_History_Count - Wuffs.Base.IO.History_Position (G_W_Dst)
                     and 16#FFFF_FFFF#);
      G_Loop_1_Loop :
      while Wuffs.Base.IO.Length (G_W_Dst) >= 266 and then Wuffs.Base.IO.Length (G_R_Src) >= 12 loop
         if V_N_Bits < 15 then
            pragma Warnings ("C");
            pragma Assert (V_N_Bits >= 0);
            pragma Warnings ("c");
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            pragma Warnings ("C");
            pragma Assert (V_N_Bits >= 15);
            pragma Warnings ("c");
         else
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 10);
            pragma Warnings ("c");
         end if;
         pragma Warnings ("C");
         pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 10);
         pragma Assert (V_N_Bits >= 15);
         pragma Warnings ("c");
         V_Table_Entry := Self.F_Huffs (0) (Wuffs.Index (V_Bits and V_Lmask));
         V_Table_Entry_N_Bits := V_Table_Entry and 16#0F#;
         V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
         V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         if Interfaces.Shift_Right (V_Table_Entry, 31) /= 0 then
            Wuffs.Base.IO.Write_U8_Fast (Data => A_Dst,
                                         W => G_W_Dst,
                                         V => Wuffs.U8
                                                (Interfaces.Shift_Right (V_Table_Entry, 8)
                                                   and 16#FF#));
            goto G_Continue_1_Loop;
         elsif Interfaces.Shift_Right (V_Table_Entry, 30) /= 0 then
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 8);
            pragma Warnings ("c");
         elsif Interfaces.Shift_Right (V_Table_Entry, 29) /= 0 then
            Self.F_End_Of_Block := True;
            exit G_Loop_1_Loop;
         elsif Interfaces.Shift_Right (V_Table_Entry, 28) /= 0 then
            if V_N_Bits < 15 then
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 0);
               pragma Warnings ("c");
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 15);
               pragma Warnings ("c");
            else
               pragma Warnings ("C");
               pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 8);
               pragma Warnings ("c");
            end if;
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 8);
            pragma Assert (V_N_Bits >= 15);
            pragma Warnings ("c");
            V_Redir_Top := Interfaces.Shift_Right (V_Table_Entry, 8) and 16#FFFF#;
            V_Redir_Mask :=
              Interfaces.Shift_Left (Wuffs.U32'(1),
                                     Natural (Interfaces.Shift_Right (V_Table_Entry, 4) and 16#0F#))
                - 1;
            V_Table_Entry :=
              Self.F_Huffs (0) (Wuffs.Index (V_Redir_Top + (V_Bits and V_Redir_Mask)
                                               and HUFFS_TABLE_MASK));
            V_Table_Entry_N_Bits := V_Table_Entry and 16#0F#;
            V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
            V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
            if Interfaces.Shift_Right (V_Table_Entry, 31) /= 0 then
               Wuffs.Base.IO.Write_U8_Fast (Data => A_Dst,
                                            W => G_W_Dst,
                                            V => Wuffs.U8
                                                   (Interfaces.Shift_Right (V_Table_Entry, 8)
                                                      and 16#FF#));
               goto G_Continue_1_Loop;
            elsif Interfaces.Shift_Right (V_Table_Entry, 30) /= 0 then
               null;
            elsif Interfaces.Shift_Right (V_Table_Entry, 29) /= 0 then
               Self.F_End_Of_Block := True;
               exit G_Loop_1_Loop;
            elsif Interfaces.Shift_Right (V_Table_Entry, 28) /= 0 then
               Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            elsif Interfaces.Shift_Right (V_Table_Entry, 27) /= 0 then
               Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Bad_Huffman_Code;
            else
               Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
            end if;
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 8);
            pragma Warnings ("c");
         elsif Interfaces.Shift_Right (V_Table_Entry, 27) /= 0 then
            Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Bad_Huffman_Code;
         else
            Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Length := (Interfaces.Shift_Right (V_Table_Entry, 8) and 16#FF#) + 3;
         V_Table_Entry_N_Bits := Interfaces.Shift_Right (V_Table_Entry, 4) and 16#0F#;
         if V_Table_Entry_N_Bits > 0 then
            if V_N_Bits < 15 then
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 0);
               pragma Warnings ("c");
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 15);
               pragma Warnings ("c");
            else
               pragma Warnings ("C");
               pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 6);
               pragma Warnings ("c");
            end if;
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 6);
            pragma Assert (V_N_Bits >= 15);
            pragma Warnings ("c");
            V_Length :=
              (V_Length
                 + 253
                 + Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => V_Table_Entry_N_Bits)
                 and 16#FF#)
                + 3;
            V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
            V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         else
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 6);
            pragma Warnings ("c");
         end if;
         pragma Warnings ("C");
         pragma Assert (V_Length >= 1);
         pragma Warnings ("c");
         if V_N_Bits < 15 then
            pragma Warnings ("C");
            pragma Assert (V_N_Bits >= 0);
            pragma Warnings ("c");
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            pragma Warnings ("C");
            pragma Assert (V_N_Bits >= 15);
            pragma Warnings ("c");
         else
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 4);
            pragma Warnings ("c");
         end if;
         pragma Warnings ("C");
         pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 4);
         pragma Assert (V_N_Bits >= 15);
         pragma Warnings ("c");
         V_Table_Entry := Self.F_Huffs (1) (Wuffs.Index (V_Bits and V_Dmask));
         V_Table_Entry_N_Bits := V_Table_Entry and 15;
         V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
         V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         if Interfaces.Shift_Right (V_Table_Entry, 28) = 1 then
            if V_N_Bits < 15 then
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 0);
               pragma Warnings ("c");
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               V_Bits :=
                 V_Bits
                   or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                             Natural (V_N_Bits));
               Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
               V_N_Bits := V_N_Bits + 8;
               pragma Warnings ("C");
               pragma Assert (V_N_Bits >= 15);
               pragma Warnings ("c");
            else
               pragma Warnings ("C");
               pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 2);
               pragma Warnings ("c");
            end if;
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 2);
            pragma Assert (V_N_Bits >= 15);
            pragma Warnings ("c");
            V_Redir_Top := Interfaces.Shift_Right (V_Table_Entry, 8) and 16#FFFF#;
            V_Redir_Mask :=
              Interfaces.Shift_Left (Wuffs.U32'(1),
                                     Natural (Interfaces.Shift_Right (V_Table_Entry, 4) and 16#0F#))
                - 1;
            V_Table_Entry :=
              Self.F_Huffs (1) (Wuffs.Index (V_Redir_Top + (V_Bits and V_Redir_Mask)
                                               and HUFFS_TABLE_MASK));
            V_Table_Entry_N_Bits := V_Table_Entry and 16#0F#;
            V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
            V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         else
            pragma Warnings ("C");
            pragma Assert (Wuffs.Base.IO.Length (G_R_Src) >= 2);
            pragma Warnings ("c");
         end if;
         if Interfaces.Shift_Right (V_Table_Entry, 24) /= 16#40# then
            if Interfaces.Shift_Right (V_Table_Entry, 24) = 16#08# then
               Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
               Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
               return Error_Bad_Huffman_Code;
            end if;
            Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Internal_Error_Inconsistent_Huffman_Decoder_State;
         end if;
         V_Dist_Minus_1 := Interfaces.Shift_Right (V_Table_Entry, 8) and 16#7FFF#;
         V_Table_Entry_N_Bits := Interfaces.Shift_Right (V_Table_Entry, 4) and 16#0F#;
         if V_N_Bits < V_Table_Entry_N_Bits then
            pragma Warnings ("C");
            pragma Assert (V_N_Bits < 15);
            pragma Assert (V_N_Bits >= 0);
            pragma Warnings ("c");
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            V_Bits :=
              V_Bits
                or Interfaces.Shift_Left (Wuffs.U32 (Wuffs.Base.IO.Peek_U8 (A_Src, G_R_Src)),
                                          Natural (V_N_Bits));
            Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
            V_N_Bits := V_N_Bits + 8;
            pragma Warnings ("C");
            pragma Assert (V_Table_Entry_N_Bits <= V_N_Bits);
            pragma Assert (V_N_Bits >= V_Table_Entry_N_Bits);
            pragma Warnings ("c");
         end if;
         pragma Warnings ("C");
         pragma Assert (V_N_Bits >= V_Table_Entry_N_Bits);
         pragma Warnings ("c");
         V_Dist_Minus_1 :=
           V_Dist_Minus_1 + Wuffs.Base.Ints.Low_Bits_U32 (X => V_Bits, N => V_Table_Entry_N_Bits)
             and 16#7FFF#;
         V_Bits := Interfaces.Shift_Right (V_Bits, Natural (V_Table_Entry_N_Bits));
         V_N_Bits := V_N_Bits - V_Table_Entry_N_Bits;
         G_Loop_2 :
         loop
            pragma Warnings ("C");
            pragma Loop_Invariant (Wuffs.Base.IO.Length (G_W_Dst) >= 266);
            pragma Loop_Invariant (V_Length >= 1);
            pragma Assert (Wuffs.U64 (V_Length) <= Wuffs.Base.IO.Length (G_W_Dst));
            pragma Assert (Wuffs.U64 (V_Length + 8) <= Wuffs.Base.IO.Length (G_W_Dst));
            pragma Warnings ("c");
            if Wuffs.U64 (V_Dist_Minus_1 + 1) > Wuffs.Base.IO.History_Length (G_W_Dst) then
               V_Hlen := 0;
               V_Hdist :=
                 Wuffs.U32 (Wuffs.U64 (V_Dist_Minus_1 + 1)
                              - Wuffs.Base.IO.History_Length (G_W_Dst));
               if V_Length > V_Hdist then
                  pragma Warnings ("C");
                  pragma Assert (V_Hdist < V_Length);
                  pragma Assert (V_Hdist < 16#8000#);
                  pragma Warnings ("c");
                  V_Length := V_Length - V_Hdist;
                  V_Hlen := V_Hdist;
               else
                  V_Hlen := V_Length;
                  V_Length := 0;
               end if;
               V_Hdist := V_Hdist + V_Hdist_Adjustment;
               if Self.F_History_Index < V_Hdist then
                  Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
                  Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
                  return Error_Bad_Distance;
               end if;
               G_T4 := G_W_Dst;
               Wuffs.Runtime.Writer_Limited_Copy_U32_From_Slice
                 (Data => A_Dst,
                  W => G_T4,
                  Up_To => V_Hlen,
                  Src => Self.F_History
                           (Wuffs.Index (Self.F_History_Index - V_Hdist and 16#7FFF#)
                            .. Self.F_History'Last),
                  N => G_T1);
               G_W_Dst := G_T4;
               if V_Length = 0 then
                  goto G_Continue_1_Loop;
               end if;
               pragma Warnings ("C");
               pragma Assert (V_Length >= 1);
               pragma Warnings ("c");
               if Wuffs.U64 (V_Dist_Minus_1 + 1) > Wuffs.Base.IO.History_Length (G_W_Dst)
                    or else Wuffs.U64 (V_Length) > Wuffs.Base.IO.Length (G_W_Dst)
                    or else Wuffs.U64 (V_Length + 8) > Wuffs.Base.IO.Length (G_W_Dst)
               then
                  Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
                  Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
                  return Error_Internal_Error_Inconsistent_Distance;
               end if;
            end if;
            pragma Warnings ("C");
            pragma Assert (V_Dist_Minus_1 + 1 >= 1);
            pragma Assert (Wuffs.U64 (V_Dist_Minus_1 + 1)
                             <= Wuffs.Base.IO.History_Length (G_W_Dst));
            pragma Assert (V_Length >= 1);
            pragma Assert (Wuffs.U64 (V_Length) <= Wuffs.Base.IO.Length (G_W_Dst));
            pragma Assert (Wuffs.U64 (V_Length + 8) <= Wuffs.Base.IO.Length (G_W_Dst));
            pragma Warnings ("c");
            if V_Dist_Minus_1 + 1 >= 8 then
               G_T4 := G_W_Dst;
               Wuffs.Base.IO.Limited_Copy_U32_From_History_8_Byte_Chunks_Fast
                 (Data => A_Dst,
                  W => G_T4,
                  Up_To => V_Length,
                  Distance => V_Dist_Minus_1 + 1,
                  N => G_T2);
               G_W_Dst := G_T4;
            else
               G_T4 := G_W_Dst;
               Wuffs.Base.IO.Limited_Copy_U32_From_History_Fast
                 (Data => A_Dst,
                  W => G_T4,
                  Up_To => V_Length,
                  Distance => V_Dist_Minus_1 + 1,
                  N => G_T3);
               G_W_Dst := G_T4;
            end if;
            exit G_Loop_2;
         end loop G_Loop_2;
         <<G_Continue_1_Loop>>
         null;
      end loop G_Loop_1_Loop;
      while V_N_Bits >= 8 loop
         V_N_Bits := V_N_Bits - 8;
         if Wuffs.Base.IO.Can_Undo_Byte (G_R_Src) then
            Wuffs.Base.IO.Undo_Byte (G_R_Src);
         else
            Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Error_Internal_Error_Inconsistent_I_O;
         end if;
      end loop;
      pragma Warnings ("C");
      pragma Assert (V_N_Bits < 8);
      pragma Warnings ("c");
      Self.F_Bits := V_Bits and Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_N_Bits)) - 1;
      Self.F_N_Bits := V_N_Bits;
      if Self.F_N_Bits >= 8
           or else Interfaces.Shift_Right (Self.F_Bits, Natural (Self.F_N_Bits)) /= 0
      then
         Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
         Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
         return Error_Internal_Error_Inconsistent_N_Bits;
      end if;
      Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return Wuffs.Ok_Status;
   end Decode_Huffman_Fast32;

   function G_Choosy_Default_Decode_Huffman_Fast64
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      G_W_Dst : Wuffs.Base.IO.Writer;
      G_R_Src : Wuffs.Base.IO.Reader;
      V_Bits : Wuffs.U64 := 0;
      V_N_Bits : Wuffs.U32 := 0;
      V_Table_Entry : Wuffs.U32 := 0;
      V_Table_Entry_N_Bits : G_U32_Range_0_15 := 0;
      V_Lmask : G_U64_Range_0_511 := 0;
