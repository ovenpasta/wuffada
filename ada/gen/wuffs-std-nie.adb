                                           Count => G_T2);
         V_Dst :=
           Wuffs.Runtime.Subslice_IJ (S => (Base => A_Dst_Pixels'Unrestricted_Access,
                                            First => A_Dst_Pixels'First,
                                            Length => A_Dst_Pixels'Length),
                                      I => G_T1,
                                      J => G_T1 + G_T2);
         if V_Dst_Bytes_Per_Row < Wuffs.U64 (V_Dst.Length) then
            V_Dst := Wuffs.Runtime.Subslice_J (V_Dst, Wuffs.Index (V_Dst_Bytes_Per_Row));
         end if;
         V_I := Wuffs.U64 (Self.F_Dst_X) * Wuffs.U64 (V_Dst_Bytes_Per_Pixel);
         if V_I >= Wuffs.U64 (V_Dst.Length) then
            V_Src_Bytes_Per_Pixel := 4;
            pragma Warnings ("C");
            pragma Assert (V_Src_Bytes_Per_Pixel > 0);
            pragma Warnings ("c");
            if Self.F_Pixfmt = 16#8100_BBBB# or else Self.F_Pixfmt = 16#8200_BBBB# then
               V_Src_Bytes_Per_Pixel := 8;
               pragma Warnings ("C");
               pragma Assert (V_Src_Bytes_Per_Pixel > 0);
               pragma Warnings ("c");
            end if;
            V_N := Wuffs.Base.IO.Length (G_R_Src) / Wuffs.U64 (V_Src_Bytes_Per_Pixel);
            V_N := Wuffs.Base.Ints.Min_U64 (X => V_N, Y => Wuffs.U64 (Self.F_Width - Self.F_Dst_X));
            V_J := V_N;
            while V_J >= 8 loop
               if Wuffs.Base.IO.Length (G_R_Src) >= Wuffs.U64 (V_Src_Bytes_Per_Pixel * 8) then
                  Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => V_Src_Bytes_Per_Pixel * 8);
               end if;
               V_J := V_J - 8;
            end loop;
            while V_J > 0 loop
               if Wuffs.Base.IO.Length (G_R_Src) >= Wuffs.U64 (V_Src_Bytes_Per_Pixel * 1) then
                  Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => V_Src_Bytes_Per_Pixel * 1);
               end if;
               V_J := V_J - 1;
            end loop;
         else
            G_T3 := Wuffs.Runtime.Subslice_I (V_Dst, Wuffs.Index (V_I));
            Wuffs.Runtime.Swizzle_Interleaved_From_Reader
              (S => Self.F_Swizzler,
               Dst => G_T3.Base (G_T3.First .. Wuffs.Runtime.Last (G_T3)),
               Dst_Palette => A_Dst_Palette
                                (A_Dst_Palette'First
                                 .. (A_Dst_Palette'First
                                       + Wuffs.Runtime.Palette_Length
                                           (PB => A_Dst,
                                            Palette => A_Dst_Palette))
                                      - 1),
               Src_Data => A_Src,
               R => G_R_Src,
               N => G_T4);
            V_N := G_T4;
         end if;
         if V_N = 0 then
            Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
            return Note_Internal_Note_Short_Read;
         end if;
         Self.F_Dst_X :=
           Wuffs.Base.Ints.Sat_Add_U32 (X => Self.F_Dst_X, Y => Wuffs.U32 (V_N and 16#FFFF_FFFF#));
      end loop G_Loop_1;
      Wuffs.Base.IO.Save (A_Src_Meta, G_R_Src);
      return Wuffs.Ok_Status;
   end Swizzle;

   overriding function Frame_Dirty_Rect (Self : Decoder) return Wuffs.Base.Ranges.Rect_IE_U32 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return Wuffs.Base.Ranges.Empty_Rect_IE_U32;
      end if;
      return
        Wuffs.Base.Ranges.Make_Rect_IE_U32 (Min_Incl_X => 0,
                                            Min_Incl_Y => 0,
                                            Max_Excl_X => Self.F_Width,
                                            Max_Excl_Y => Self.F_Height);
   end Frame_Dirty_Rect;

