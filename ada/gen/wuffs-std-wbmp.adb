                                        Y => V_Dst_Y,
                                        Length => A_Dst_Pixels'Length,
                                        First => G_T5,
                                        Count => G_T6);
      V_Dst :=
        Wuffs.Runtime.Subslice_IJ (S => (Base => A_Dst_Pixels'Unrestricted_Access,
                                         First => A_Dst_Pixels'First,
                                         Length => A_Dst_Pixels'Length),
                                   I => G_T5,
                                   J => G_T5 + G_T6);
      V_Dst_X_In_Bytes := Wuffs.U64 (V_Dst_X) * V_Dst_Bytes_Per_Pixel;
      if V_Dst_X_In_Bytes <= Wuffs.U64 (V_Dst.Length) then
         V_Dst := Wuffs.Runtime.Subslice_I (V_Dst, Wuffs.Index (V_Dst_X_In_Bytes));
      end if;
      goto G_Head_12;
      <<G_Done_13>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_Dst_X < 16#FF_FFFF#);
      pragma Assert (V_Dst_Y < 16#FF_FFFF#);
      pragma Assert (Wuffs.Base.IO.Length (G_R_Src) > 0);
      pragma Warnings ("c");
