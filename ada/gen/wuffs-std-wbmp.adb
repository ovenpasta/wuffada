      Wuffs.Base.IO.Skip_U32_Fast (R => G_R_Src, Actual => 1);
      goto G_Fi_10;
      <<G_Else_11>>
      null;
      <<G_Fi_10>>
      if (V_C8 and 16#80#) = 0 then
         V_Src (0) := 16#00#;
      else
         V_Src (0) := 16#FF#;
      end if;
      V_C8 := Wuffs.U8 (Interfaces.Shift_Left (Wuffs.U32 (V_C8), 1) and 16#FF#);
      Wuffs.Runtime.Swizzle_Interleaved_From_Slice
        (S => Self.F_Swizzler,
         Dst => V_Dst.Base (V_Dst.First .. Wuffs.Runtime.Last (V_Dst)),
         Dst_Palette => Wuffs.Runtime.Empty_Bytes_Variable,
         Src => V_Src,
         N => G_T7);
      if V_Dst_Bytes_Per_Pixel <= Wuffs.U64 (V_Dst.Length) then
         V_Dst := Wuffs.Runtime.Subslice_I (V_Dst, Wuffs.Index (V_Dst_Bytes_Per_Pixel));
      end if;
      V_Dst_X := V_Dst_X + 1;
      goto G_Head_8;
      <<G_Done_9>>
      null;
      pragma Warnings ("C");
      pragma Assert (V_Dst_Y < 16#FF_FFFF#);
      pragma Warnings ("c");
      V_Dst_Y := V_Dst_Y + 1;
      goto G_Head_6;
      <<G_Done_7>>
