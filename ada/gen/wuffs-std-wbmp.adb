                                        First => G_T3,
                                        Count => G_T4);
      V_Dst :=
        Wuffs.Runtime.Subslice_IJ (S => (Base => A_Dst_Pixels'Unrestricted_Access,
                                         First => A_Dst_Pixels'First,
                                         Length => A_Dst_Pixels'Length),
                                   I => G_T3,
                                   J => G_T3 + G_T4);
      V_Dst_X := 0;
      <<G_Head_8>>
      if V_Dst_X >= Self.F_Width then
         goto G_Done_9;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_Dst_Y < 16#FF_FFFF#);
      pragma Assert (V_Dst_X < 16#FF_FFFF#);
      pragma Warnings ("c");
      if (V_Dst_X and 7) /= 0 then
         goto G_Else_11;
      end if;
      <<G_Head_12>>
      if Wuffs.Base.IO.Length (G_R_Src) > 0 then
         goto G_Done_13;
      end if;
      pragma Warnings ("C");
      pragma Assert (V_Dst_X < 16#FF_FFFF#);
      pragma Assert (V_Dst_Y < 16#FF_FFFF#);
      pragma Warnings ("c");
