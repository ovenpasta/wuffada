                                                        .. (A_Dst_Palette'First
                                                              + Wuffs.Runtime.Palette_Length
                                                                  (PB => A_Dst,
                                                                   Palette => A_Dst_Palette))
                                                             - 1),
                                      Src_Pixfmt => Wuffs.Base.Pixel_Formats.Make_Pixel_Format
