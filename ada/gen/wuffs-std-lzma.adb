               V_Wb_Index := V_Wb_Index + Wuffs.U64 (Self.F_Dict_Size);
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_Which < 2);
            pragma Warnings ("c");
            if V_Wb_Index >= Wuffs.U64 (A_Workbuf'Length) then
               G_Status := Error_Internal_Error_Inconsistent_Dictionary_State;
               goto G_Exit;
            end if;
            Self.F_Stashed_Bytes (Wuffs.Index (V_Which)) :=
              A_Workbuf (A_Workbuf'First + Wuffs.Index (V_Wb_Index));
         end if;
         V_Dist := 1 + Self.F_Stashed_Rep0;
         V_Which := V_Which + 1;
      end loop;
      Self.G_P_11_Update_Stashed_Bytes := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_11_Update_Stashed_Bytes := (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      <<G_Exit>>
      Wuffs.Base.IO.Save (A_Dst_Meta, G_W_Dst);
      return G_Status;
   end Update_Stashed_Bytes;

   function Decode_Optional_End_Of_Stream
     (Self : in out Decoder;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Workbuf : Wuffs.Bytes)
      return Wuffs.Status
   is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      V_Status : Wuffs.Status := Wuffs.Ok_Status;
      G_Bound_1 : Wuffs.Runtime.Slice_U8;
      G_W_Meta_1 : Wuffs.Base.IO.Buffer_Meta;
      G_W_Bound_1 : Wuffs.Base.IO.Writer;
      G_Susp : Wuffs.U32;
   begin
      G_Susp := Self.G_P_12_Decode_Optional_End_Of_Stream;
      case G_Susp is
         when 0 =>
            null;
         when 1 =>
            goto G_Resume_1;
         when others =>
            goto G_Suspend;
      end case;
      Self.F_Stashed_Pos_End := 16#FFFF_FFFF_FFFF_FFFF#;
      <<G_Head_1>>
      G_Bound_1 :=
        (Base => Wuffs.Runtime.Empty_Bytes_Variable'Unrestricted_Access,
         First => Wuffs.Runtime.Empty_Bytes_Variable'First,
         Length => Wuffs.Runtime.Empty_Bytes_Variable'Length);
      G_W_Meta_1 := Wuffs.Base.IO.Writer_Meta (History_Position => 0);
      G_W_Bound_1 :=
        Wuffs.Base.IO.Writer_Set (Data_Length => G_Bound_1.Length, History_Position => 0);
      Wuffs.Base.IO.Save (G_W_Meta_1, G_W_Bound_1);
      V_Status :=
        Decode_Bitstream_Slow (Self,
                               A_Dst => G_Bound_1.Base
                                          (G_Bound_1.First
                                           .. Wuffs.Runtime.Last (G_Bound_1)),
                               A_Dst_Meta => G_W_Meta_1,
                               A_Src => A_Src,
                               A_Src_Meta => A_Src_Meta,
                               A_Workbuf => A_Workbuf);
      Wuffs.Base.IO.Reload (G_W_Bound_1, G_W_Meta_1);
      if Wuffs.Is_Ok (V_Status) then
         goto G_Done_2;
      elsif V_Status = Wuffs.Base.Suspension_Short_Write then
         G_Status := Error_Bad_Bitstream_Trailer;
         goto G_Exit;
      end if;
      G_Status := V_Status;
      if Wuffs.Is_Ok (G_Status) then
         goto G_Ok;
      elsif not Wuffs.Is_Suspension (G_Status) then
         goto G_Exit;
      end if;
      G_Susp := 1;
      goto G_Suspend;
      <<G_Resume_1>>
      goto G_Head_1;
      <<G_Done_2>>
      Self.F_Stashed_Pos_End := Self.F_Stashed_Pos;
      <<G_Ok>>
      Self.G_P_12_Decode_Optional_End_Of_Stream := 0;
      goto G_Exit;
      <<G_Suspend>>
      Self.G_P_12_Decode_Optional_End_Of_Stream :=
        (if Wuffs.Is_Suspension (G_Status) then G_Susp else 0);
      <<G_Exit>>
      return G_Status;
   end Decode_Optional_End_Of_Stream;

