   is
      pragma Unreferenced (Self);
   begin
      if A_A < A_B then
         pragma Warnings ("C");
         pragma Assert (A_B > A_A);
         pragma Warnings ("c");
         return A_B - A_A;
      end if;
      return A_A - A_B;
   end Absolute_Difference;

   function Mode12
     (Self : Decoder; A_L : Wuffs.U8; A_T : Wuffs.U8; A_Tl : Wuffs.U8) return Wuffs.U8
   is
      pragma Unreferenced (Self);
      V_V : Wuffs.U32 := 0;
   begin
      V_V := (Wuffs.U32 (A_L) + Wuffs.U32 (A_T)) - Wuffs.U32 (A_Tl);
      if V_V < 256 then
         return Wuffs.U8 (V_V);
      elsif V_V < 512 then
         return 255;
      end if;
      return 0;
   end Mode12;

   function Mode13
     (Self : Decoder; A_L : Wuffs.U8; A_T : Wuffs.U8; A_Tl : Wuffs.U8) return Wuffs.U8
   is
