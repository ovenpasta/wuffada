         V_X := 0;
         while V_X < A_Width loop
            pragma Warnings ("C");
            pragma Loop_Invariant (V_Y < 16#4000#);
            pragma Assert (V_X < 16#4000#);
            pragma Warnings ("c");
            if (V_X and V_Mask) = 0 and then Wuffs.U64 (V_Tile_Data.Length) >= 4 then
               V_G2r :=
                 Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Wuffs.Runtime.Get (V_Tile_Data, 0));
               V_G2b :=
                 Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Wuffs.Runtime.Get (V_Tile_Data, 1));
               V_R2b :=
                 Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (Wuffs.Runtime.Get (V_Tile_Data, 2));
               V_Tile_Data := Wuffs.Runtime.Subslice_I (V_Tile_Data, 4);
            end if;
            if Wuffs.U64 (M_Pix.Length) >= 4 then
               V_B := Wuffs.Runtime.Get (M_Pix, 0);
               V_G := Wuffs.Runtime.Get (M_Pix, 1);
               V_R := Wuffs.Runtime.Get (M_Pix, 2);
               V_R :=
                 V_R
                   + Wuffs.U8 (Interfaces.Shift_Right
                                 (Wuffs.Base.Ints.Sign_Extend_Convert_U8_U32 (V_G) * V_G2r,
                                  5)
