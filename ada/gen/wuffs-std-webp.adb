      V_G2b : Wuffs.U32 := 0;
      V_R2b : Wuffs.U32 := 0;
      V_B : Wuffs.U8 := 0;
      V_G : Wuffs.U8 := 0;
      V_R : Wuffs.U8 := 0;
   begin
      V_Tile_Size_Log2 := Wuffs.U32 (Self.F_Transform_Tile_Size_Log2 (1));
      V_Tiles_Per_Row :=
        Interfaces.Shift_Right (A_Width
                                  + (Interfaces.Shift_Left
                                       (Wuffs.U32'(1),
                                        Natural (V_Tile_Size_Log2))
                                       - 1),
                                Natural (V_Tile_Size_Log2));
      V_Mask := Interfaces.Shift_Left (Wuffs.U32'(1), Natural (V_Tile_Size_Log2)) - 1;
      V_Y := 0;
      while V_Y < Self.F_Height loop
         pragma Warnings ("C");
         pragma Assert (V_Y < 16#4000#);
         pragma Warnings ("c");
         V_T :=
           Wuffs.U64 (4
                        * Interfaces.Shift_Right (V_Y, Natural (V_Tile_Size_Log2))
                        * V_Tiles_Per_Row);
         V_Tile_Data :=
           (Base => Wuffs.Runtime.Empty_Bytes_Variable'Unrestricted_Access,
            First => Wuffs.Runtime.Empty_Bytes_Variable'First,
            Length => Wuffs.Runtime.Empty_Bytes_Variable'Length);
         if V_T <= Wuffs.U64 (A_Tile_Data'Length) then
            V_Tile_Data :=
              Wuffs.Runtime.Subslice_I ((Base => A_Tile_Data'Unrestricted_Access,
                                         First => A_Tile_Data'First,
                                         Length => A_Tile_Data'Length),
                                        Wuffs.Index (V_T));
