      V_Mask : Wuffs.U32 range 0 .. 511 := 0;
      V_Y : G_U32_Range_0_16384 := 0;
      V_X : G_U32_Range_0_16384 := 0;
      V_T : Wuffs.U64 range 0 .. 1107163140 := 0;
      V_Tile_Data : Wuffs.Runtime.RO_Slice_U8;
