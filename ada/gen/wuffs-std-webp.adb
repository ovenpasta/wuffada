                                                              (X => Wuffs.Base.Ranges.Get_Max_Incl
                                                                      (V_S),
                                                               Y => Wuffs.Base.Ranges.Get_Max_Incl
                                                                      (V_R)));
      end if;
      return V_R;
   end Workbuf_Len;

end Wuffs.Std.Webp;
