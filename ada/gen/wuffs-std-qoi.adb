            V_Rem_X := Self.F_Width;
         else
            V_Rem_X := Self.F_Width - Self.F_Dst_X;
         end if;
         V_Src :=
           Wuffs.Runtime.Subslice_IJ (S => (Base => Self.F_Buffer'Unrestricted_Access,
                                            First => Self.F_Buffer'First,
                                            Length => Self.F_Buffer'Length),
                                      I => Wuffs.Index (V_Bi),
                                      J => Wuffs.Index (Self.F_Buffer_Index));
         if Wuffs.U64 (4 * V_Rem_X) < Wuffs.U64 (V_Src.Length) then
            V_Src := Wuffs.Runtime.Subslice_J (V_Src, Wuffs.Index (Wuffs.U64 (4 * V_Rem_X)));
         end if;
         V_Src_Length := Wuffs.U32 (Wuffs.U64 (V_Src.Length) and 16#FFFF_FFFF#);
         V_Bi := V_Bi + V_Src_Length;
         Wuffs.Base.Pixel_Buffers.Row_U32 (T => V_Tab,
                                           Y => Self.F_Dst_Y,
                                           Length => A_Dst_Pixels'Length,
                                           First => G_T1,
                                           Count => G_T2);
         V_Dst :=
           Wuffs.Runtime.Subslice_IJ (S => (Base => A_Dst_Pixels'Unrestricted_Access,
                                            First => A_Dst_Pixels'First,
                                            Length => A_Dst_Pixels'Length),
                                      I => G_T1,
                                      J => G_T1 + G_T2);
         if V_Dst_Bytes_Per_Row < Wuffs.U64 (V_Dst.Length) then
            V_Dst := Wuffs.Runtime.Subslice_J (V_Dst, Wuffs.Index (V_Dst_Bytes_Per_Row));
         end if;
         V_I := Wuffs.U64 (Self.F_Dst_X) * Wuffs.U64 (V_Dst_Bytes_Per_Pixel);
         Self.F_Dst_X := Self.F_Dst_X + V_Src_Length / 4;
         if V_I < Wuffs.U64 (V_Dst.Length) then
            G_T3 := Wuffs.Runtime.Subslice_I (V_Dst, Wuffs.Index (V_I));
            Wuffs.Runtime.Swizzle_Interleaved_From_Slice
              (S => Self.F_Swizzler,
               Dst => G_T3.Base (G_T3.First .. Wuffs.Runtime.Last (G_T3)),
               Dst_Palette => A_Dst_Palette
                                (A_Dst_Palette'First
                                 .. (A_Dst_Palette'First
                                       + Wuffs.Runtime.Palette_Length
                                           (PB => A_Dst,
                                            Palette => A_Dst_Palette))
                                      - 1),
               Src => V_Src.Base (V_Src.First .. Wuffs.Runtime.Last (V_Src)),
               N => G_T4);
         end if;
      end loop G_Loop_1;
      return Wuffs.Ok_Status;
   end From_Buffer_To_Dst;

   overriding function Frame_Dirty_Rect (Self : Decoder) return Wuffs.Base.Ranges.Rect_IE_U32 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return Wuffs.Base.Ranges.Empty_Rect_IE_U32;
      end if;
      return
        Wuffs.Base.Ranges.Make_Rect_IE_U32 (Min_Incl_X => 0,
                                            Min_Incl_Y => 0,
                                            Max_Excl_X => Self.F_Width,
                                            Max_Excl_Y => Self.F_Height);
   end Frame_Dirty_Rect;

   overriding function Num_Animation_Loops (Self : Decoder) return Wuffs.U32 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return 0;
      end if;
      return 0;
   end Num_Animation_Loops;

   overriding function Num_Decoded_Frame_Configs (Self : Decoder) return Wuffs.U64 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return 0;
      end if;
      if Self.F_Call_Sequence > 16#20# then
         return 1;
      end if;
      return 0;
   end Num_Decoded_Frame_Configs;

   overriding function Num_Decoded_Frames (Self : Decoder) return Wuffs.U64 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return 0;
      end if;
      if Self.F_Call_Sequence > 16#40# then
         return 1;
      end if;
      return 0;
   end Num_Decoded_Frames;

   overriding function Restart_Frame
     (Self : in out Decoder; A_Index : Wuffs.U64; A_Io_Position : Wuffs.U64) return Wuffs.Status
   is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return
           (if Self.Magic = Wuffs.Runtime.Magic_Disabled
            then Wuffs.Base.Error_Disabled_By_Previous_Error
            else Wuffs.Base.Error_Initialize_Not_Called);
      end if;
      if Self.F_Call_Sequence < 16#20# then
         return Wuffs.Base.Error_Bad_Call_Sequence;
      end if;
      if A_Index /= 0 or else A_Io_Position /= 14 then
         return Wuffs.Base.Error_Bad_Argument;
      end if;
      Self.F_Call_Sequence := 16#28#;
      return Wuffs.Ok_Status;
   end Restart_Frame;

   overriding procedure Set_Report_Metadata
     (Self : in out Decoder; A_Fourcc : Wuffs.U32; A_Report : Boolean)
   is
      pragma Unreferenced (A_Fourcc);
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return;
      end if;
      if not A_Report'Valid then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
         return;
      end if;
   end Set_Report_Metadata;

   overriding function Tell_Me_More
     (Self : in out Decoder;
      A_Dst : in out Wuffs.Bytes;
      A_Dst_Meta : in out Wuffs.Base.IO.Buffer_Meta;
      A_Minfo : in out Wuffs.Runtime.More_Information;
      A_Minfo_Null : Boolean;
      A_Src : Wuffs.Bytes;
      A_Src_Meta : in out Wuffs.Base.IO.Buffer_Meta)
      return Wuffs.Status
   is
      pragma Unmodified (A_Dst);
      pragma Unmodified (A_Dst_Meta);
      pragma Unreferenced (A_Minfo);
      pragma Unmodified (A_Src_Meta);
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return
           (if Self.Magic = Wuffs.Runtime.Magic_Disabled
            then Wuffs.Base.Error_Disabled_By_Previous_Error
            else Wuffs.Base.Error_Initialize_Not_Called);
      end if;
      if not A_Minfo_Null'Valid
           or else Wuffs.Runtime.Shares_Storage
                     (A => A_Dst,
                      Address => Self'Address,
                      Size_In_Bits => Self'Size)
           or else Wuffs.Runtime.Shares_Storage
                     (A => A_Src,
                      Address => Self'Address,
                      Size_In_Bits => Self'Size)
           or else not Wuffs.Runtime.Valid_Buffer (A_Dst, A_Dst_Meta)
           or else not Wuffs.Runtime.Valid_Buffer (A_Src, A_Src_Meta)
      then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
         return Wuffs.Base.Error_Bad_Argument;
      end if;
      if Self.G_Active_Coroutine /= 0 and then Self.G_Active_Coroutine /= 4 then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
         return Wuffs.Base.Error_Interleaved_Coroutine_Calls;
      end if;
      Self.G_Active_Coroutine := 0;
      G_Status := Wuffs.Base.Error_No_More_Information;
      goto G_Exit;
      <<G_Exit>>
      if Wuffs.Is_Error (G_Status) then
         Self.Magic := Wuffs.Runtime.Magic_Disabled;
      end if;
      return G_Status;
   end Tell_Me_More;

   overriding function Workbuf_Len (Self : Decoder) return Wuffs.Base.Ranges.Range_II_U64 is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized
           and then Self.Magic /= Wuffs.Runtime.Magic_Disabled
      then
         return Wuffs.Base.Ranges.Empty_Range_II_U64;
      end if;
      return Wuffs.Base.Ranges.Make_Range_II_U64 (Min_Incl => 0, Max_Incl => 0);
   end Workbuf_Len;

end Wuffs.Std.Qoi;
