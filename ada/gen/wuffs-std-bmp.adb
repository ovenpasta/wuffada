   function Process_Masks (Self : in out Decoder) return Wuffs.Status is
      G_Status : Wuffs.Status := Wuffs.Ok_Status;
      V_I : Wuffs.U32 := 0;
      V_Mask : Wuffs.U32 := 0;
      V_N : Wuffs.U32 := 0;
   begin
      while V_I < 4 loop
         V_Mask := Self.F_Channel_Masks (Wuffs.Index (V_I));
         if V_Mask /= 0 then
            V_N := 0;
            while (V_Mask and 1) = 0 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_I < 4);
               pragma Warnings ("c");
               V_N := V_N + 1;
               V_Mask := Interfaces.Shift_Right (V_Mask, 1);
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_I < 4);
            pragma Warnings ("c");
            Self.F_Channel_Shifts (Wuffs.Index (V_I)) := Wuffs.U8 (V_N and 31);
            V_N := 0;
            while (V_Mask and 1) = 1 loop
               pragma Warnings ("C");
               pragma Loop_Invariant (V_I < 4);
               pragma Warnings ("c");
               V_N := V_N + 1;
               V_Mask := Interfaces.Shift_Right (V_Mask, 1);
            end loop;
            pragma Warnings ("C");
            pragma Assert (V_I < 4);
            pragma Warnings ("c");
            if V_Mask /= 0 or else V_N > 32 then
               G_Status := Error_Bad_Header;
               goto G_Exit;
            end if;
            Self.F_Channel_Num_Bits (Wuffs.Index (V_I)) := Wuffs.U8 (V_N);
         elsif V_I /= 3 then
            G_Status := Error_Bad_Header;
            goto G_Exit;
         end if;
         V_I := V_I + 1;
      end loop;
      <<G_Exit>>
      return G_Status;
   end Process_Masks;

end Wuffs.Std.Bmp;
