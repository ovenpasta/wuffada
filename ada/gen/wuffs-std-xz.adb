   overriding function Set_Quirk
     (Self : in out Decoder; A_Key : Wuffs.U32; A_Value : Wuffs.U64) return Wuffs.Status
   is
   begin
      if Self.Magic /= Wuffs.Runtime.Magic_Initialized then
         return
           (if Self.Magic = Wuffs.Runtime.Magic_Disabled
            then Wuffs.Base.Error_Disabled_By_Previous_Error
            else Wuffs.Base.Error_Initialize_Not_Called);
      end if;
      if A_Key = 1 then
         Self.F_Ignore_Checksum := A_Value > 0;
         return Wuffs.Ok_Status;
      elsif A_Key = QUIRK_DECODE_STANDALONE_CONCATENATED_STREAMS then
         Self.F_Standalone_Format := A_Value > 0;
         return Wuffs.Ok_Status;
      end if;
      return Wuffs.Base.Error_Unsupported_Option;
   end Set_Quirk;

