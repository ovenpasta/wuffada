      if A_Key = 1 then
         if Self.F_Ignore_Checksum then
            return 1;
         end if;
      elsif A_Key = QUIRK_DECODE_STANDALONE_CONCATENATED_STREAMS then
         if Self.F_Standalone_Format then
            return 1;
         end if;
      end if;
      return 0;
