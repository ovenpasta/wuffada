// Part of wuffada (wuffs-ada: Wuffs to Ada).
// SPDX-License-Identifier: Apache-2.0 OR MIT

// This is not part of Wuffs' standard library. It is an adversarial test
// input for wuffs-ada's coroutine lowering, generated by both back-ends:
// gen.sh generates ada/tests/wuffs-std-advtest.ad[sb] from it,
// ada/tests/test_adv.adb runs every public coroutine over pseudo-random
// input under 1-byte (and other) source and destination schedules, and
// ada/tests/crosscheck/adv.c does the same with the C that upstream's
// wuffs-c generates from this file. test.sh requires identical traces.
//
// Most of it comes from the independent review of milestone 2 (functions
// t1 .. t9, u1 .. u5 and v1), which found the bugs that t4 (a slice argument
// of a coroutine call must be evaluated again on resume) and t7 (a local
// that only a loop invariant mentions after a suspension) now guard
// against. The w functions cover writable slices of a field passed next to
// the receiver and element writes through a slice argument; the x functions
// (x1 .. x11) are from a second review. The z functions (milestone jpeg)
// cover the bulk methods (z1) and pointers to rows of a field (z2). The n
// functions (milestone vp8/webp) are not coroutines: they cover nullable
// pixel buffers ("nptr base.pixel_buffer": n1 passes a pixel buffer or
// nullptr to one, n2 takes one at a public entry), make_pixel_blend and
// demake_pixel_blend (n3) and the accessors of range_ii_u64 (n4). Their
// drivers are separate sections of test_adv.adb and adv.c.
//
// Every public coroutine has the same signature, so that the drivers can
// treat them alike.

pub status "#bad thing"

pub status "#inner failed"

pub struct thing? (
        sum  : base.u32,
        buf  : array[16] base.u8,
        st   : base.u32,
        util : base.utility,
        rows : array[3] array[4] base.u16,
        u16s : array[6] base.u16,
        u32s : array[3] base.u32,
        u64s : array[2] base.u64,
        buf2 : array[24] base.u8,
        nres : base.u64,
)

pub func thing.get_sum() base.u32 {
    return this.sum
}

pub func thing.get_st() base.u32 {
    return this.st
}

pub func thing.get_nres() base.u64 {
    return this.nres
}

pub func thing.t1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c   : base.u8
    var n   : base.u32
    var x   : base.u32
    var i   : base.u32
    var acc : base.u32
    var y   : base.u64

    c = args.src.read_u8?()
    n = (c & 7) as base.u32
    while i < n {
        x = args.src.read_u16le_as_u32?()
        acc ~mod+= x ~mod* (i ~mod+ 1)
        args.dst.write_u8?(a: (acc & 0xFF) as base.u8)
        acc ~mod+= n
        i ~mod+= 1
    }
    x = args.src.read_u32be?()
    acc ~mod+= x
    y = args.src.read_u64le?()
    acc ~mod+= (y & 0xFFFF_FFFF) as base.u32
    acc ~mod+= ((y >> 32) & 0xFFFF_FFFF) as base.u32
    x = args.src.read_u24be_as_u32?()
    acc ~mod+= x
    y = args.src.read_u40le_as_u64?()
    acc ~mod+= ((y >> 8) & 0xFFFF_FFFF) as base.u32
    x = args.src.read_u16be_as_u32?()
    args.src.skip_u32?(n: x & 15)
    args.src.skip?(n: (c & 3) as base.u64)
    args.src.skip_u32?(n: 1)
    yield? base."$short write"
    this.sum ~mod+= (acc ~mod+ i) ~mod+ n
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
    args.dst.write_u8?(a: c)
}

pub func thing.t2?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var d : base.u8
    var j : base.u32
    var k : base.u32

    while.outer true {
        c = args.src.read_u8?()
        if c == 0 {
            break.outer
        }
        j = 0
        while.inner j < 4 {
            j ~mod+= 1
            k ~mod+= j
            if (c & 3) == 1 {
                if j == 2 {
                    continue.outer
                }
            } else if (c & 7) == 6 {
                if j == 3 {
                    break.outer
                }
            } else if (c & 7) == 2 {
                continue.inner
            }
            k ~mod+= 100
        }.inner
        while.mid true {
            d = args.src.read_u8?()
            d = d & 7
            if d == 1 {
                continue.outer
            } else if d == 2 {
                break.mid
            } else if d == 3 {
                args.dst.write_u8?(a: 0x33)
                break.outer
            } else if d == 4 {
                continue.mid
            } else if d == 5 {
                while.deep true {
                    d = args.src.read_u8?()
                    if (d & 1) == 0 {
                        continue.mid
                    } else if (d & 2) == 0 {
                        break.deep
                    } else if (d & 4) == 0 {
                        continue.outer
                    }
                    args.dst.write_u8?(a: d)
                }.deep
            }
            args.dst.write_u8?(a: d ~mod+ c)
            k ~mod+= 7
        }.mid
        args.dst.write_u8?(a: c)
        k ~mod+= j
    }.outer
    this.sum = k
    args.dst.write_u8?(a: (k & 0xFF) as base.u8)
}

pri func thing.inner?(dst: base.io_writer, src: base.io_reader, lim: base.u32) {
    var a : base.u8
    var b : base.u32
    var i : base.u32

    a = args.src.read_u8?()
    while i < args.lim {
        b = args.src.read_u16be_as_u32?()
        if b == 0x0101 {
            return "#inner failed"
        }
        args.dst.write_u8?(a: ((b & 0xFF) as base.u8) ~mod+ a)
        i ~mod+= 1
    }
    this.sum ~mod+= b ~mod+ (a as base.u32)
}

pub func thing.t3?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var n : base.u32
    var r : base.u32

    while r < 3 {
        c = args.src.read_u8?()
        n = (c & 3) as base.u32
        args.dst.write_u8?(a: c)
        this.inner?(dst: args.dst, src: args.src, lim: n)
        c = args.src.read_u8?()
        args.dst.write_u8?(a: c ~mod+ ((n & 0xFF) as base.u8))
        this.sum ~mod+= n
        r ~mod+= 1
    }
    if (c & 1) == 1 {
        return "#bad thing"
    }
}

pri func thing.eat?(s: roslice base.u8, src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    this.sum ~mod+= (args.s.length() & 0xFF) as base.u32
    this.sum ~mod+= c as base.u32
    c = args.src.read_u8?()
    if args.s.length() > 0 {
        this.sum ~mod+= args.s[0] as base.u32
    }
}

pub func thing.t4?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8

    c = args.src.read_u8?()
    this.buf[12] = c
    this.buf[13] = 77
    this.eat?(s: this.buf[..].suffix(up_to: 4), src: args.src)
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
}

pub func thing.t5?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var s   : slice base.u8
    var c   : base.u8
    var arr : array[4] base.u8
    var i   : base.u32

    s = this.buf[2 .. 6]
    arr[1] = 9
    while i < 4 {
        c = args.src.read_u8?()
        arr[i & 3] ~mod+= c
        this.sum ~mod+= (s.length() & 0xFF) as base.u32
        i ~mod+= 1
    }
    args.dst.write_u8?(a: arr[0])
    args.dst.write_u8?(a: arr[1])
    args.dst.write_u8?(a: arr[2])
    args.dst.write_u8?(a: arr[3])
}

pub func thing.t6?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32

    if coroutine_resumed {
        this.st ~mod+= 1
    }
    while i < 5 {
        c = args.src.read_u8?()
        if coroutine_resumed {
            this.st ~mod+= 16
        }
        if c == 0xFF {
            return "#bad thing"
        }
        i ~mod+= 1
        if (c & 1) == 1 {
            continue
        }
        args.dst.write_u8?(a: c)
    }
    this.sum = this.st
    args.dst.write_u8?(a: (this.st & 0xFF) as base.u8)
}

pub func thing.t7?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var n : base.u32[..= 10]
    var i : base.u32

    n = 5
    this.sum ~mod+= n
    while i < 3,
            inv n == 5,
    {
        c = args.src.read_u8?()
        args.dst.write_u8?(a: c)
        i ~mod+= 1
    }
}

pri func thing.take2!(src: base.io_reader) base.u32 {
    var x : base.u32

    if args.src.length() >= 2 {
        x = args.src.peek_u16le_as_u32()
        args.src.skip_u32_fast!(actual: 2, worst_case: 2)
    }
    return x
}

pub func thing.t8?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var x : base.u32
    var n : base.u32
    var m : base.u64

    c = args.src.read_u8?()
    x = this.take2!(src: args.src)
    this.sum ~mod+= x
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    n = args.dst.limited_copy_u32_from_reader!(up_to: 5, r: args.src)
    this.sum ~mod+= n
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    n = args.dst.limited_copy_u32_from_history!(up_to: 6, distance: (c & 3) as base.u32)
    this.sum ~mod+= n ~mod* 16
    this.buf[0] = c
    this.buf[1] = 1
    m = args.dst.copy_from_slice!(s: this.buf[.. 5])
    this.sum ~mod+= (m & 0xFF) as base.u32
    n = args.dst.limited_copy_u32_from_slice!(up_to: 3, s: this.buf[.. 2])
    this.sum ~mod+= n ~mod* 256
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
}

pub func thing.t9?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8

    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
}

pub func thing.u1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c    : base.u8
    var i    : base.u32[..= 10]
    var flag : base.bool
    var n    : base.u32

    while (i < 10) and ((n & 0x80) == 0) {
        c = args.src.read_u8?()
        flag = (c & 1) == 1
        if (not flag) or ((c & 6) == 6) {
            args.dst.write_u8?(a: c)
        } else if flag and (c > 100) and (n <= 0) {
            args.dst.write_u8?(a: c ~mod+ 1)
            n ~mod+= 3
        } else if i >= 10 {
            args.dst.write_u8?(a: 0x99)
        }
        n ~mod+= c as base.u32
        i += 1
    }
    if i >= 10 {
        args.dst.write_u8?(a: 0xAA)
    }
    if i <= 0 {
        args.dst.write_u8?(a: 0xBB)
    }
    while n > 0 {
        args.dst.write_u8?(a: (n & 0xFF) as base.u8)
        n = n >> 3
    }
    this.sum ~mod+= i
}

pri func thing.mix!(s: roslice base.u8) base.u32 {
    var t : base.u32

    if args.s.length() >= 4 {
        t = args.s.peek_u32le()
        this.buf[0] = 0xFF
        this.buf[1] ~mod+= 3
        this.buf[3] = this.buf[2]
        t ~mod+= args.s.peek_u32le()
        this.buf[2] = 0x11
        t ~mod+= args.s.peek_u32be()
    }
    return t
}

pub func thing.u2?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var s : slice base.u8
    var x : base.u32

    c = args.src.read_u8?()
    this.buf[0] = c
    this.buf[1] = c ~mod+ 1
    this.buf[2] = c ~mod+ 2
    this.buf[3] = c ~mod+ 3
    x = this.mix!(s: this.buf[.. 8])
    this.sum ~mod+= x
    s = this.buf[..]
    if s.length() >= 4 {
        s[0] = 5
        x = this.buf[0] as base.u32
        this.buf[1] = 6
        x ~mod+= s.peek_u32le()
        this.sum ~mod+= x
    }
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
}

pri func thing.eat2?(s: roslice base.u8, src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    this.sum ~mod+= (args.s.length() & 0xFF) as base.u32
    this.sum ~mod+= c as base.u32
    c = args.src.read_u8?()
    if args.s.length() > 0 {
        this.sum ~mod+= args.s[0] as base.u32
    }
}

pub func thing.u3?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8

    c = args.src.read_u8?()
    if args.workbuf.length() < 4 {
        return "#bad thing"
    }
    this.buf[4] = c
    this.eat2?(s: this.buf[4 .. 12], src: args.src)
    this.sum ~mod+= this.buf[4] as base.u32
    if args.workbuf.length() >= 4 {
        c = args.workbuf[2]
    }
    args.dst.write_u8?(a: c)
    this.eat2?(s: args.workbuf, src: args.src)
    if args.workbuf.length() >= 4 {
        c = args.workbuf[0]
    }
    args.dst.write_u8?(a: c)
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
}

pri func thing.fold!(x: roslice base.u8) {
    var p : roslice base.u8

    iterate (p = args.x)(length: 1, advance: 1, unroll: 1) {
        this.st = (this.st ~mod* 31) ~mod+ (p[0] as base.u32)
    }
}

pub func thing.u4?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var status : base.status
    var mark   : base.u64
    var r      : base.u32
    var c      : base.u8

    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    while r < 3 {
        while true {
            mark = args.dst.mark()
            status =? this.inner?(dst: args.dst, src: args.src, lim: 2)
            this.fold!(x: args.dst.since(mark: mark))
            this.sum ~mod+= (args.dst.count_since(mark: mark) & 0xFF) as base.u32
            if status.is_ok() {
                break
            }
            yield? status
        }
        c = args.src.read_u8?()
        if c == 7 {
            return ok
        } else if c == 6 {
            return base."@end of data"
        }
        r ~mod+= 1
    }
    this.sum ~mod+= this.st
}

pub func thing.u5?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var x : base.u64
    var y : base.u32
    var z : base.u16

    x = args.src.read_u48be_as_u64?()
    this.sum ~mod+= ((x >> 3) & 0xFFFF_FFFF) as base.u32
    x = args.src.read_u56le_as_u64?()
    this.sum ~mod+= ((x >> 5) & 0xFFFF_FFFF) as base.u32
    x = args.src.read_u64be?()
    this.sum ~mod+= ((x >> 7) & 0xFFFF_FFFF) as base.u32
    y = args.src.read_u8_as_u32?()
    this.sum ~mod+= y
    z = args.src.read_u16le?()
    this.sum ~mod+= z as base.u32
    y = args.src.read_u24le_as_u32?()
    this.sum ~mod+= y
    y = args.src.read_u32le?()
    this.sum ~mod+= y
    x = args.src.read_u40be_as_u64?()
    this.sum ~mod+= ((x >> 1) & 0xFFFF_FFFF) as base.u32
    z = args.src.read_u16be?()
    this.sum ~mod+= z as base.u32
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
}

pub func thing.v1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var m : base.u64
    var s : roslice base.u8
    var c : base.u8
    var x : base.u32
    var y : base.u64
    var n : base.u32

    c = args.src.read_u8?()
    m = args.src.mark()
    args.src.skip_u32?(n: (c & 3) as base.u32)
    s = args.src.since(mark: m)
    this.sum ~mod+= (s.length() & 0xFF) as base.u32
    this.fold!(x: s)
    this.fold!(x: args.src.since(mark: m))
    this.sum ~mod+= (args.src.count_since(mark: m) & 0xFF) as base.u32
    this.sum ~mod+= (args.src.position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.history_length() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.history_position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.src.length() & 0xFF) as base.u32
    this.sum ~mod+= (args.dst.length() & 0xFF) as base.u32
    if args.src.can_undo_byte() {
        args.src.undo_byte!()
        this.sum ~mod+= 0x10_0000
    }
    c = args.src.read_u8?()
    if args.src.is_closed() {
        this.sum ~mod+= 0x100_0000
    }
    if args.src.length() >= 8 {
        x = args.src.peek_u32le()
        this.sum ~mod+= x
        y = args.src.peek_u64be()
        this.sum ~mod+= ((y >> 31) & 0xFFFF_FFFF) as base.u32
        this.sum ~mod+= args.src.peek_u24be_as_u32()
        this.sum ~mod+= args.src.peek_u8_as_u32()
        this.sum ~mod+= args.src.peek_u16le_as_u32()
        y = args.src.peek_u48le_as_u64()
        this.sum ~mod+= ((y >> 9) & 0xFFFF_FFFF) as base.u32
        args.src.skip_u32_fast!(actual: 3, worst_case: 8)
    }
    m = args.dst.mark()
    if args.dst.length() >= 20 {
        args.dst.write_u16le_fast!(a: (x & 0xFFFF) as base.u16)
        args.dst.write_u32be_fast!(a: x)
        args.dst.write_u24le_fast!(a: x & 0xFF_FFFF)
        args.dst.write_u64le_fast!(a: y)
        args.dst.write_u8_fast!(a: c)
        args.dst.write_u16be_fast!(a: 0x1234)
    }
    this.fold!(x: args.dst.since(mark: m))
    this.sum ~mod+= (args.dst.count_since(mark: m) & 0xFF) as base.u32
    if args.dst.can_undo_byte() {
        args.dst.undo_byte!()
        this.sum ~mod+= 0x20_0000
    }
    n = args.dst.limited_copy_u32_from_history!(up_to: 100, distance: 100)
    this.sum ~mod+= n
    n = args.dst.limited_copy_u32_from_history!(up_to: 4, distance: 0)
    this.sum ~mod+= n
    n = args.dst.limited_copy_u32_from_history!(up_to: 9, distance: 3)
    this.sum ~mod+= n
    args.dst.write_u8?(a: c)
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    this.sum ~mod+= (args.src.position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.history_length() & 0xFFFF) as base.u32
}

// Writable slices of a field of the receiver, passed to functions and
// coroutines that also get the receiver; and element writes through a slice
// argument, in a coroutine.

pri func thing.g!(s: slice base.u8) base.u32 {
    if args.s.length() > 0 {
        args.s[0] = 1
    }
    return this.sum
}

pri func thing.h!(s: slice base.u8) {
    if args.s.length() > 0 {
        args.s[0] = 2
    }
}

pri func thing.eat3?(s: slice base.u8, src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    if args.s.length() > 1 {
        args.s[1] = c
        args.s[0] ~mod+= 3
    }
    c = args.src.read_u8?()
    this.sum ~mod+= c as base.u32
    if args.s.length() > 0 {
        this.sum ~mod+= args.s[0] as base.u32
    }
}

pub func thing.w1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var x : base.u32
    var i : base.u32

    c = args.src.read_u8?()
    this.buf[2] = c
    this.h!(s: this.buf[2 .. 8])
    x = this.g!(s: this.buf[..])
    this.sum ~mod+= x
    this.eat3?(s: this.buf[4 .. 12], src: args.src)
    this.eat3?(s: this.buf[..].suffix(up_to: 3), src: args.src)
    this.eat3?(s: args.workbuf, src: args.src)
    if args.workbuf.length() >= 4 {
        args.workbuf[3] = c
        args.workbuf[2] ~mod+= 1
    }
    c = args.src.read_u8?()
    if args.workbuf.length() >= 4 {
        args.workbuf[1] = c
    }
    while i < 16 {
        args.dst.write_u8?(a: this.buf[i])
        i += 1
    }
}

// The x functions are from the second independent review: among other
// things, bool, status and u16 locals that are live across suspensions
// (x10) and a private coroutine that returns a note through its caller,
// which then calls it again (x11).

// x1: suspensions in the condition-dependent arms of an else-if chain inside
// two flattened loops, with labelled continue/break.
pub func thing.x1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32
    var j : base.u32
    var k : base.u32

    while.outer i < 6 {
        i ~mod+= 1
        j = 0
        while.inner j < 3 {
            j ~mod+= 1
            if k > 300 {
                k = 0
            } else if (i & 1) == 0 {
                c = args.src.read_u8?()
                if (c & 3) == 0 {
                    continue.outer
                } else if (c & 3) == 1 {
                    break.inner
                }
                k ~mod+= c as base.u32
            } else if (i & 2) == 0 {
                args.dst.write_u8?(a: (k & 0xFF) as base.u8)
                if j == 2 {
                    continue.outer
                }
            } else {
                c = args.src.read_u8?()
                args.dst.write_u8?(a: c)
                if (c & 4) == 4 {
                    break.outer
                }
            }
            k ~mod+= 1
        }.inner
        args.dst.write_u8?(a: (j & 0xFF) as base.u8)
    }.outer
    this.sum ~mod+= (k ~mod+ (i ~mod<< 8)) ~mod+ (j ~mod<< 16)
}

// A private coroutine, called from several call sites, that changes this
// fields and its slice argument before it suspends.
pri func thing.cal?(dst: base.io_writer, src: base.io_reader, lim: base.u32, s: slice base.u8) {
    var a : base.u8
    var i : base.u32

    this.sum ~mod+= 1000
    this.st ~mod+= args.lim
    if args.s.length() > 0 {
        args.s[0] ~mod+= 1
    }
    a = args.src.read_u8?()
    while i < (args.lim & 7) {
        args.dst.write_u8?(a: a ~mod+ ((i & 0xFF) as base.u8))
        i ~mod+= 1
        if args.s.length() > 1 {
            a ~mod+= args.s[1]
            args.s[1] = a
        }
    }
    this.sum ~mod+= args.lim ~mod+ ((args.s.length() & 0xFF) as base.u32)
}

// x2: the arguments of a coroutine call are evaluated again on resume, after
// the callee changed this.sum, this.st and the slice before suspending.
pub func thing.x2?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var n : base.u32
    var c : base.u8

    c = args.src.read_u8?()
    n = c as base.u32
    this.cal?(dst: args.dst, src: args.src, lim: n ~mod+ this.sum, s: this.buf[(this.st & 7) as base.u64 ..])
    args.dst.write_u8?(a: this.buf[1])
    n ~mod+= 3
    if args.workbuf.length() >= 6 {
        this.cal?(dst: args.dst, src: args.src, lim: n ~mod+ this.st, s: args.workbuf.suffix(up_to: ((this.sum & 3) as base.u64) ~mod+ 1))
    }
    this.cal?(dst: args.dst, src: args.src, lim: this.sum, s: args.workbuf)
    args.dst.write_u8?(a: this.buf[2])
    args.dst.write_u8?(a: this.buf[3])
}

// x3: consecutive suspension points, yields in loops.
pub func thing.x3?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var x : base.u32
    var i : base.u32
    var status : base.status

    while i < 4 {
        args.src.skip_u32?(n: 1)
        c = args.src.read_u8?()
        args.dst.write_u8?(a: c)
        x = args.src.read_u32le?()
        args.dst.write_u8?(a: (x & 0xFF) as base.u8)
        if (c & 1) == 1 {
            yield? base."$short read"
            args.dst.write_u8?(a: 0x55)
        } else if (c & 2) == 2 {
            status = base."$short write"
            yield? status
        }
        yield? base."@end of data"
        i ~mod+= 1
    }
    this.sum ~mod+= x ~mod+ i
}

pri func thing.wr?(dst: base.io_writer, src: base.io_reader, n: base.u32) {
    var i : base.u32
    var c : base.u8

    while i < args.n {
        c = args.src.read_u8?()
        args.dst.write_u8?(a: c ~mod+ 1)
        i ~mod+= 1
    }
}

// x4: the caller holds a reader mark while the callee suspends.
pub func thing.x4?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var m  : base.u64
    var m2 : base.u64
    var c  : base.u8

    c = args.src.read_u8?()
    m = args.src.mark()
    m2 = args.dst.mark()
    this.wr?(dst: args.dst, src: args.src, n: ((c & 7) as base.u32) ~mod+ 2)
    this.fold!(x: args.src.since(mark: m))
    this.fold!(x: args.dst.since(mark: m2))
    this.sum ~mod+= (args.src.count_since(mark: m) & 0xFFFF) as base.u32
    this.sum ~mod+= ((args.dst.count_since(mark: m2) & 0xFFFF) as base.u32) ~mod<< 16
    this.sum ~mod+= (args.src.position() & 0xFFFF) as base.u32
    this.sum ~mod+= (args.dst.position() & 0xFFFF) as base.u32
    c = args.src.read_u8?()
    this.wr?(dst: args.dst, src: args.src, n: (c & 3) as base.u32)
    this.fold!(x: args.src.since(mark: m))
}

// x5: assertions and loop assertions on locals after suspensions.
pub func thing.x5?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var n : base.u32[..= 100]
    var m : base.u32[..= 100]
    var i : base.u32[..= 20]

    n = 50
    m = 7
    while i < 10,
            pre n == 50,
            inv m == 7,
            post i >= 10,
    {
        c = args.src.read_u8?()
        assert n == 50
        if (c & 1) == 1 {
            args.dst.write_u8?(a: c)
            assert m == 7
        } else if (c & 2) == 2 {
            assert m <= 7
            c = args.src.read_u8?()
            assert n <= 50
        }
        i += 1
    }
    assert m == 7
    this.sum ~mod+= (n ~mod+ m) ~mod+ i
}

pri func thing.fail?(src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    this.sum ~mod+= c as base.u32
    c = args.src.read_u8?()
    this.sum ~mod+= c as base.u32
}

// x6: "=?" in a loop, then yield of the callee's status.
pub func thing.x6?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var status : base.status
    var r      : base.u32
    var c      : base.u8

    while r < 3 {
        status =? this.fail?(src: args.src)
        if status.is_suspension() {
            yield? status
            continue
        }
        c = args.src.read_u8?()
        args.dst.write_u8?(a: c)
        r ~mod+= 1
    }
}

// x7: element writes through args and field slices after suspensions;
// copies between overlapping slices.
pub func thing.x7?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var s : slice base.u8
    var n : base.u64

    c = args.src.read_u8?()
    if args.workbuf.length() >= 8 {
        args.workbuf[(c & 7) as base.u64] = c
        s = args.workbuf[2 .. 7]
        n = s.copy_from_slice!(s: args.workbuf[1 .. 5])
        this.sum ~mod+= (n & 0xFF) as base.u32
    }
    c = args.src.read_u8?()
    s = this.buf[3 ..]
    n = s.copy_from_slice!(s: this.buf[.. 9])
    this.sum ~mod+= ((n & 0xFF) as base.u32) ~mod<< 8
    this.buf[c & 15] ~mod+= 1
    n = this.buf[1 .. 9].copy_from_slice!(s: this.buf[.. 9])
    this.sum ~mod+= ((n & 0xFF) as base.u32) ~mod<< 16
    c = args.src.read_u8?()
    if args.workbuf.length() >= 8 {
        args.workbuf[3 .. 7].poke_u32le!(a: (c as base.u32) ~mod* 0x0101_0101)
        this.sum ~mod+= args.workbuf[1 .. 3].peek_u16be() as base.u32
        n = args.dst.copy_from_slice!(s: args.workbuf[2 .. 8])
        this.sum ~mod+= (n & 0xFF) as base.u32
    }
    n = args.dst.copy_from_slice!(s: this.buf[(c & 7) as base.u64 ..])
    this.sum ~mod+= (n & 0xFF) as base.u32
    args.dst.write_u8?(a: this.buf[0])
}

pri func thing.pk(s: roslice base.u8) base.u32 {
    if args.s.length() >= 2 {
        return ((args.s[0] as base.u32) ~mod+ (args.s[1] as base.u32)) ~mod+ this.sum
    }
    return 0
}

// x8: an if whose condition needs a temporary, a suspension in its arms,
// break out of a structured loop inside a flattened one, coroutine_resumed.
pub func thing.x8?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32
    var j : base.u32

    while.a i < 5 {
        i ~mod+= 1
        if (this.pk(s: this.buf[(i & 7) as base.u64 ..]) & 1) == 1 {
            c = args.src.read_u8?()
            this.buf[c & 15] = c ~mod+ 1
        } else {
            args.dst.write_u8?(a: (i & 0xFF) as base.u8)
            if coroutine_resumed {
                this.st ~mod+= 1
            }
        }
        j = 0
        while.b j < 10 {
            j ~mod+= 1
            if this.buf[j & 15] == 3 {
                break.b
            } else if this.buf[j & 15] == 4 {
                continue.a
            } else if (j == 7) and (i == 4) {
                break.a
            }
        }.b
        this.sum ~mod+= j
    }.a
    this.sum ~mod+= i ~mod<< 8
}

// x9: a coroutine call and reads with nothing in between, in a loop whose
// first statement suspends; a read whose result indexes a field array.
pub func thing.x9?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32

    while i < 3 {
        c = args.src.read_u8?()
        this.buf[c & 15] = args.src.read_u8?()
        this.wr?(dst: args.dst, src: args.src, n: 1)
        this.wr?(dst: args.dst, src: args.src, n: (c & 1) as base.u32)
        args.src.skip?(n: (c & 3) as base.u64)
        args.dst.write_u8?(a: this.buf[c & 15])
        i ~mod+= 1
    }
}

// x10: bool, status and u16 locals live across suspensions.
pub func thing.x10?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var flag   : base.bool
    var status : base.status
    var h      : base.u16
    var c      : base.u8

    c = args.src.read_u8?()
    flag = (c & 1) == 1
    h = (c as base.u16) ~mod* 0x101
    if (c & 2) == 2 {
        status = "#bad thing"
    }
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    if flag {
        this.sum ~mod+= 0x100
    }
    this.sum ~mod+= h as base.u32
    if status.is_error() {
        this.sum ~mod+= 0x10000
    }
}

pri func thing.noter?(src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    this.sum ~mod+= c as base.u32
    if (c & 1) == 1 {
        return base."@end of data"
    }
}

// x11: a private coroutine's note goes through the caller's suspend label.
pub func thing.x11?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8

    c = args.src.read_u8?()
    args.dst.write_u8?(a: c)
    this.noter?(src: args.src)
    c = args.src.read_u8?()
    args.dst.write_u8?(a: c ~mod+ 1)
}

// Shapes that once made the generator emit Ada that GNAT rejects: a loop
// condition that, negated (as flattening does), compares a variable with the
// upper bound of its refinement; and a loop that stays an Ada loop (with a
// name, for its break) before one that is flattened into labels.

pub func thing.y1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32[..= 10]
    var k : base.u32

    while true {
        k ~mod+= 1
        if k > 3 {
            break
        }
    }
    while i < 10 {
        c = args.src.read_u8?()
        this.sum ~mod+= c as base.u32
        if c <= 0 {
            args.dst.write_u8?(a: 1)
        }
        i += 1
    }
    this.sum ~mod+= k
}

// z1: the bulk methods, on bytes (with source and destination overlapping
// in one field, both ways round), on arrays of u16, u32 and u64 and on rows
// of u16; from and to byte slices that are long enough, too short (so
// nothing at all is copied) or of a length that is not a multiple of the
// element size; and the caller's work buffer. Everything after a
// suspension point, so that the temporaries are made after it.
pub func thing.z1?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var i : base.u32
    var k : base.u64[..= 7]
    var n : base.u64[..= 3]

    while i < 16 {
        c = args.src.read_u8?()
        this.buf[i] = c
        i += 1
    }
    k = ((c >> 2) & 7) as base.u64
    n = (c & 3) as base.u64

    this.rows[1 .. 3].bulk_load_host_endian!(src: this.buf[k ..])
    this.u16s[n .. 6].bulk_load_host_endian!(src: this.buf[3 ..])
    this.u32s[.. 2].bulk_load_host_endian!(src: this.buf[k ..])
    this.u64s[1 .. 2].bulk_load_host_endian!(src: this.buf[(k + 8) ..])
    this.rows[.. 1].bulk_load_host_endian!(src: args.workbuf)
    this.buf[2 .. 10].bulk_load_host_endian!(src: this.buf[n ..])
    this.buf[4 .. 12].bulk_save_host_endian!(dst: this.buf[k ..])
    this.rows[.. 2].bulk_save_host_endian!(dst: this.buf2[n ..])
    this.u16s[1 .. 4].bulk_save_host_endian!(dst: this.buf2[(k + 15) ..])
    this.u32s[.. 3].bulk_save_host_endian!(dst: this.buf2[1 ..])
    this.u64s[.. 2].bulk_save_host_endian!(dst: args.workbuf)
    if n <= args.workbuf.length() {
        this.u64s[.. 1].bulk_save_host_endian!(dst: args.workbuf[n ..])
    }
    this.rows[2 .. 3].bulk_memset!(byte_value: c)
    this.rows[.. 2].bulk_memset!(byte_value: c ~mod+ 3)
    this.u16s[.. 2].bulk_memset!(byte_value: 0xA5)
    this.buf2[20 .. 24].bulk_memset!(byte_value: c ~mod+ 1)

    // Bounds and a value that read the receiver itself: they are evaluated
    // once, before the rows are written.
    this.rows[.. (((this.rows[0][0] & 1) as base.u64) + 1)].bulk_load_host_endian!(src: this.buf[..])
    this.rows[.. (((this.rows[0][0] & 1) as base.u64) + 1)].bulk_memset!(byte_value: ((this.rows[0][0] & 0xFF) as base.u8) | 1)
    this.rows[(((this.rows[1][1] & 1) as base.u64)) .. 3].bulk_save_host_endian!(dst: this.buf2[..])

    i = 0
    while i < 24 {
        args.dst.write_u8?(a: this.buf2[i])
        i += 1
    }
    i = 0
    while i < 16 {
        args.dst.write_u8?(a: this.buf[i])
        i += 1
    }
    i = 0
    while i < 4 {
        this.sum = (this.sum ~mod* 31) ~mod+ (this.rows[0][i] as base.u32)
        this.sum = (this.sum ~mod* 31) ~mod+ (this.rows[1][i] as base.u32)
        this.sum = (this.sum ~mod* 31) ~mod+ (this.rows[2][i] as base.u32)
        i += 1
    }
    i = 0
    while i < 6 {
        this.sum = (this.sum ~mod* 31) ~mod+ (this.u16s[i] as base.u32)
        i += 1
    }
    this.sum = (this.sum ~mod* 31) ~mod+ (this.u32s[0] ~mod+ (this.u32s[1] ~mod+ this.u32s[2]))
    this.st = ((this.u64s[0] ^ (this.u64s[1] >> 3) ^ (this.u64s[1] ~mod<< 29)) & 0xFFFF_FFFF) as base.u32
}

// z2: a pointer to a row of a field, which sees later writes to the row,
// assigned twice, and its null tests in assertions.
pub func thing.z2?(dst: base.io_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var p : nptr roarray[4] base.u16
    var i : base.u32
    var j : base.u32[..= 2]

    c = args.src.read_u8?()
    i = 0
    while i < 3 {
        this.rows[i][0] = (c as base.u16) ~mod+ 1
        this.rows[i][1] = (c as base.u16) ~mod* 3
        this.rows[i][2] = (i as base.u16) ~mod+ 7
        this.rows[i][3] = 0xFFFF
        i += 1
    }
    j = ((c & 1) as base.u32) + 1
    p = this.rows[j][..] as ptr array[4] base.u16
    while i > 0,
            inv p <> nullptr,
    {
        this.sum ~mod+= p[(i & 3) as base.u32] as base.u32
        this.rows[j][3] = (c as base.u16) ~mod+ ((i & 0xFF) as base.u16)
        i -= 1
    }
    assert p <> nullptr
    this.sum ~mod+= p[3] as base.u32
    j = ((c >> 1) & 1) as base.u32
    p = this.rows[j][..] as ptr array[4] base.u16
    this.st ~mod+= p[(c >> 2) & 3] as base.u32
    args.dst.write_u8?(a: (this.sum & 0xFF) as base.u8)
}

// (n1 and n2 return nothing and leave their result in nres: upstream's
// wuffs-c generates C that does not compile for a public function that
// takes a ptr and returns anything, a status or a number.)
pub func thing.n1!(dst: ptr base.pixel_buffer, sel: base.u32) {
    var r : base.u64
    var s : base.u64

    if (args.sel & 1) == 0 {
        r = this.nq!(dst: args.dst, k: args.sel)
    } else {
        r = this.nq!(dst: nullptr, k: args.sel)
    }
    s = this.nr!(dst: args.dst, k: args.sel >> 1)
    this.nres = r ~mod+ s
}

pub func thing.n2!(dst: nptr base.pixel_buffer, sel: base.u32) {
    var r : base.u64

    r = this.nq!(dst: args.dst, k: args.sel)
    this.nres = r ~mod+ 7
}

// nr passes its nullable pixel buffer on.
pri func thing.nr!(dst: nptr base.pixel_buffer, k: base.u32) base.u64 {
    var r : base.u64

    r = this.nq!(dst: args.dst, k: args.k ~mod+ 1)
    return r ~mod* 3
}

pri func thing.nq!(dst: nptr base.pixel_buffer, k: base.u32) base.u64 {
    var pf  : base.pixel_format
    var pal : slice base.u8
    var tab : table base.u8
    var row : slice base.u8
    var r   : base.u64

    if args.dst == nullptr {
        return 0xDEAD
    }
    pf = args.dst.pixel_format()
    r = pf.bits_per_pixel() as base.u64
    pal = args.dst.palette_or_else(fallback: this.buf[..])
    r = (r ~mod<< 16) | pal.length()
    if pal.length() > 2 {
        pal[2] = (args.k & 0xFF) as base.u8
    }
    tab = args.dst.plane(p: 0)
    r ~mod+= tab.width() ~mod* 3
    r ~mod+= tab.height() ~mod* 5
    r ~mod+= tab.stride()
    row = tab.row_u32(y: args.k & 3)
    if row.length() > 0 {
        row[0] = (args.k & 0xFF) as base.u8
        r ~mod+= row.length() ~mod<< 20
    }
    return r
}

pub func thing.n3(b: base.pixel_blend, x: base.u8) base.u32 {
    var c : base.pixel_blend

    c = this.util.make_pixel_blend(repr: args.x)
    return ((this.util.demake_pixel_blend(a: args.b) as base.u32) << 8) |
            (this.util.demake_pixel_blend(a: c) as base.u32)
}

pub func thing.n4(lo: base.u64, hi: base.u64) base.u64 {
    var r : base.range_ii_u64

    r = this.util.make_range_ii_u64(min_incl: args.lo, max_incl: args.hi)
    if r.is_empty() {
        return 1
    }
    return r.get_min_incl() ~mod+ (r.get_max_incl() ~mod* 3)
}
