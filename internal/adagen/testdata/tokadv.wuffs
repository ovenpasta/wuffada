// Part of wuffada (wuffs-ada: Wuffs to Ada).
// SPDX-License-Identifier: Apache-2.0 OR MIT

// This is not part of Wuffs' standard library. It is an adversarial test
// input for wuffs-ada's token I/O (token_writer arguments, their cursors
// around callees and suspensions, and the io_reader methods that the token
// decoders use), generated by both back-ends: gen.sh generates
// ada/tests/wuffs-std-tokadv.ad[sb] from it, ada/tests/test_tokadv.adb runs
// every public coroutine over pseudo-random input under 1-byte (and other)
// source schedules and 1-token (and other) token buffers, and
// ada/tests/crosscheck/tokadv.c does the same with the C that upstream's
// wuffs-c generates from this file. test.sh requires identical traces.
//
//  - k1: suspensions (short read, short write) between token writes, and
//    token writes right after a resumption;
//  - k2: a callee coroutine that writes tokens and suspends, with token
//    writes in the caller before and after it;
//  - k3: a callee that is not a coroutine and writes tokens, and the
//    io_reader methods match7, peek_u64le_at and valid_utf_8_length next to
//    token writes (mixed byte-reader and token-writer cursors);
//  - k4: extended tokens and continued chains, with every field at its
//    largest and smallest;
//  - k5: a token_writer passed on through two levels of callees, with a
//    suspension in the innermost.
//
// The struct implements base.token_decoder: its decode_tokens runs the
// function that set_quirk (key 1) selects, so that the interface path is
// generated and run too.

pub status "#bad thing"

pub struct thing? implements base.token_decoder(
        sel  : base.u32,
        sum  : base.u32,
        util : base.utility,
)

pub func thing.get_quirk(key: base.u32) base.u64 {
    if args.key == 1 {
        return this.sel as base.u64
    }
    return 0
}

pub func thing.set_quirk!(key: base.u32, value: base.u64) base.status {
    if (args.key == 1) and (args.value <= 5) {
        this.sel = args.value as base.u32
        return ok
    }
    return base."#unsupported option"
}

pub func thing.workbuf_len() base.range_ii_u64 {
    return this.util.empty_range_ii_u64()
}

pub func thing.get_sum() base.u32 {
    return this.sum
}

pub func thing.decode_tokens?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    if this.sel == 1 {
        this.k1?(dst: args.dst, src: args.src, workbuf: args.workbuf)
    } else if this.sel == 2 {
        this.k2?(dst: args.dst, src: args.src, workbuf: args.workbuf)
    } else if this.sel == 3 {
        this.k3?(dst: args.dst, src: args.src, workbuf: args.workbuf)
    } else if this.sel == 4 {
        this.k4?(dst: args.dst, src: args.src, workbuf: args.workbuf)
    } else {
        this.k5?(dst: args.dst, src: args.src, workbuf: args.workbuf)
    }
}

pub func thing.k1?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c   : base.u8
    var n   : base.u32
    var i   : base.u32
    var acc : base.u32

    c = args.src.read_u8?()
    n = ((c & 15) as base.u32) + 1
    while i < n {
        c = args.src.read_u8?()
        acc ~mod+= (c as base.u32) ~mod* (i ~mod+ 3)
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0,
                value_minor: (acc & 0x1FF_FFFF),
                continued: (i & 1),
                length: (c as base.u32))
        if (c & 7) == 0 {
            // Two tokens in a row, the second one after a possible
            // suspension.
            while args.dst.length() <= 0,
                    post args.dst.length() > 0,
            {
                yield? base."$short write"
            }
            args.dst.write_simple_token_fast!(
                    value_major: (i & 0x1F_FFFF),
                    value_minor: 0,
                    continued: 0,
                    length: 0)
        }
        i ~mod+= 1
    }
    this.sum = acc
}

pri func thing.emit?(dst: base.token_writer, src: base.io_reader, n: base.u32[..= 31]) {
    var i : base.u32
    var c : base.u8

    while i < args.n {
        c = args.src.read_u8?()
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0x0B_29FA,
                value_minor: ((c as base.u32) << 8) | (i & 0xFF),
                continued: 0,
                length: 1)
        i ~mod+= 1
    }
}

pub func thing.k2?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c   : base.u8
    var k   : base.u32
    var acc : base.u32

    while k < 3 {
        c = args.src.read_u8?()
        acc ~mod+= c as base.u32
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0, value_minor: (k & 0xFF), continued: 1, length: 1)
        this.emit?(dst: args.dst, src: args.src, n: (c & 7) as base.u32)
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0, value_minor: (acc & 0xFF), continued: 0, length: 0)
        k ~mod+= 1
    }
    this.sum = acc
}

pri func thing.put!(dst: base.token_writer, v: base.u32) base.u32 {
    if args.dst.length() > 0 {
        args.dst.write_simple_token_fast!(
                value_major: 0, value_minor: (args.v & 0x1FF_FFFF), continued: 0, length: 2)
        return 1
    }
    return 0
}

pub func thing.k3?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    var i     : base.u32
    var n     : base.u64
    var m     : base.u32[..= 2]
    var x     : base.u64
    var wrote : base.u32

    while i < 6 {
        if args.src.length() < 12 {
            if args.src.is_closed() {
                return "#bad thing"
            }
            yield? base."$short read"
            continue
        }
        m = args.src.match7(a: '\x02\x61\x62'le)
        x = args.src.peek_u64le_at(offset: 4)
        n = args.src.valid_utf_8_length(up_to: 12)
        args.src.skip_u32_fast!(actual: 3, worst_case: 3)
        wrote ~mod+= this.put!(dst: args.dst, v: (x & 0xFFFF_FFFF) as base.u32)
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0,
                value_minor: (m << 20) | ((n & 0xF) as base.u32),
                continued: 0,
                length: 3)
        i ~mod+= 1
    }
    this.sum = wrote
}

pub func thing.k4?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    var c : base.u8
    var x : base.u64
    var i : base.u32

    while i < 4 {
        x = args.src.read_u64be?()
        c = args.src.read_u8?()
        while args.dst.length() <= 1,
                post args.dst.length() > 1,
        {
            yield? base."$short write"
        }
        if (c & 1) == 0 {
            args.dst.write_simple_token_fast!(
                    value_major: 0x1F_FFFF, value_minor: 0x1FF_FFFF, continued: 1, length: 0xFFFF)
        } else {
            args.dst.write_simple_token_fast!(
                    value_major: 0, value_minor: 0, continued: 1, length: 0)
        }
        args.dst.write_extended_token_fast!(
                value_extension: x & 0x3FFF_FFFF_FFFF,
                continued: ((c >> 1) & 1) as base.u32,
                length: (c as base.u32))
        if (c & 4) == 0 {
            while args.dst.length() <= 0,
                    post args.dst.length() > 0,
            {
                yield? base."$short write"
            }
            args.dst.write_extended_token_fast!(
                    value_extension: 0x3FFF_FFFF_FFFF, continued: 0, length: 0xFFFF)
        }
        i ~mod+= 1
    }
}

pri func thing.inner2?(dst: base.token_writer, src: base.io_reader) {
    var c : base.u8

    c = args.src.read_u8?()
    while args.dst.length() <= 0,
            post args.dst.length() > 0,
    {
        yield? base."$short write"
    }
    args.dst.write_simple_token_fast!(
            value_major: 0, value_minor: c as base.u32, continued: 0, length: 1)
    if c == 0xFF {
        return "#bad thing"
    }
}

pri func thing.outer2?(dst: base.token_writer, src: base.io_reader) {
    var j : base.u32

    while j < 3 {
        this.inner2?(dst: args.dst, src: args.src)
        j ~mod+= 1
    }
}

pub func thing.k5?(dst: base.token_writer, src: base.io_reader, workbuf: slice base.u8) {
    var k : base.u32

    while k < 4 {
        while args.dst.length() <= 0,
                post args.dst.length() > 0,
        {
            yield? base."$short write"
        }
        args.dst.write_simple_token_fast!(
                value_major: 0, value_minor: 0x10_0000 | (k & 0xFF), continued: 0, length: 0)
        this.outer2?(dst: args.dst, src: args.src)
        k ~mod+= 1
    }
}
