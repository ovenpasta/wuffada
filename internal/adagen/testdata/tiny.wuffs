// A tiny input for the golden-output test in adagen_test.go.

pub status "#too big"

pri const MASK : base.u32 = 0xFFFF

pub struct summer? implements base.hasher_u32(
        state : base.u32,
)

pub func summer.get_quirk(key: base.u32) base.u64 {
    return 0
}

pub func summer.set_quirk!(key: base.u32, value: base.u64) base.status {
    if args.value > 1 {
        return "#too big"
    }
    return base."#unsupported option"
}

pub func summer.update!(x: roslice base.u8) {
    var p : roslice base.u8
    var n : base.u32[..= 0xFFFF]

    n = this.state & MASK
    iterate (p = args.x)(length: 1, advance: 1, unroll: 1) {
        n = (n ~mod+ (p[0] as base.u32)) & MASK
        assert n <= 0xFFFF
    }
    this.state = n
}

pub func summer.update_u32!(x: roslice base.u8) base.u32 {
    this.update!(x: args.x)
    return this.state
}

pub func summer.checksum_u32() base.u32 {
    return this.state
}
